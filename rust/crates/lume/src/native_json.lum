module lume/json

public annotation JsonName {
    value Str
}

public annotation JsonIgnore {}

public shape JsonField {
    name Str
    value JsonValue
}

public type JsonValue =
    object JsonNull {}
    | class JsonBool { value Bool }
    | class JsonNumber { value Str }
    | class JsonString { value Str }
    | class JsonArray { values [JsonValue] }
    | class JsonObject { fields [JsonField] }

ext JsonValue {
    fn stringify() Str = Json.stringify(this)

    fn textContent() Str = Json.textContent(this)
}

public object Json {

    fn str(value Str) JsonValue =
        panic("Json is provided by the Rust runtime")

    fn int(value Int) JsonValue =
        panic("Json is provided by the Rust runtime")

    fn float(value Float) JsonValue =
        panic("Json is provided by the Rust runtime")

    fn bool(value Bool) JsonValue =
        panic("Json is provided by the Rust runtime")

    fn nil() JsonValue =
        panic("Json is provided by the Rust runtime")

    fn field(name Str, value JsonValue) JsonField =
        panic("Json is provided by the Rust runtime")

    fn array(values [JsonValue] vararg) JsonValue =
        panic("Json is provided by the Rust runtime")

    fn obj(fields [JsonField] vararg) JsonValue =
        panic("Json is provided by the Rust runtime")

    fn obj(value Any) JsonValue =
        panic("Json is provided by the Rust runtime")

    fn encode(value Any) JsonValue =
        panic("Json is provided by the Rust runtime")

    fn stringify(value Any) Str =
        panic("Json is provided by the Rust runtime")

    fn textContent(value JsonValue) Str =
        panic("Json is provided by the Rust runtime")

    fn decode[reified T](text Str) Result[T, Str] =
        panic("Json is provided by the Rust runtime")
}

module lume/regex

public shape RegexError {
    message Str
    offset Int?
}

public class RegexMatch {
    private new() {}

    get text Str = panic("RegexMatch is provided by the active runtime")
    get start Int = panic("RegexMatch is provided by the active runtime")
    get end Int = panic("RegexMatch is provided by the active runtime")
    get groups [Str?] = panic("RegexMatch is provided by the active runtime")
    get groupMap [Str: Str] = panic("RegexMatch is provided by the active runtime")

    fn group(index Int) Str? = panic("RegexMatch is provided by the active runtime")
    fn group(name Str) Str? = panic("RegexMatch is provided by the active runtime")
}

public class Regex {
    private new() {}

    fn contains(text Str) Bool = panic("Regex is provided by the active runtime")
    fn matches(text Str) Bool = panic("Regex is provided by the active runtime")
    fn find(text Str) RegexMatch? = panic("Regex is provided by the active runtime")
    fn fullMatch(text Str) RegexMatch? = panic("Regex is provided by the active runtime")
    fn findAll(text Str) [RegexMatch] = panic("Regex is provided by the active runtime")
}

public object Regex {
    fn compile(pattern Str) Result[Regex, RegexError] =
        panic("Regex is provided by the active runtime")

    fn escape(text Str) Str = panic("Regex is provided by the active runtime")
}

module lume/regex

public shape RegexError {
    message Str
    offset Int?
}

public class RegexMatch {
    private new() {}

    get text Str = panic("RegexMatch is provided by the active runtime")
    get start Int = panic("RegexMatch is provided by the active runtime")
    get end Int = panic("RegexMatch is provided by the active runtime")
    get groups [Str?] = panic("RegexMatch is provided by the active runtime")
    get groupMap [Str: Str] = panic("RegexMatch is provided by the active runtime")

    def group(index Int) Str? = panic("RegexMatch is provided by the active runtime")
    def group(name Str) Str? = panic("RegexMatch is provided by the active runtime")
}

public class Regex {
    private new() {}

    def contains(text Str) Bool = panic("Regex is provided by the active runtime")
    def matches(text Str) Bool = panic("Regex is provided by the active runtime")
    def find(text Str) RegexMatch? = panic("Regex is provided by the active runtime")
    def fullMatch(text Str) RegexMatch? = panic("Regex is provided by the active runtime")
    def findAll(text Str) [RegexMatch] = panic("Regex is provided by the active runtime")
}

public object Regex {
    def compile(pattern Str) Result[Regex, RegexError] =
        panic("Regex is provided by the active runtime")

    def escape(text Str) Str = panic("Regex is provided by the active runtime")
}

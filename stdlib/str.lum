# PRELUDE_SKIP
# JAVA_SKIP
# INTERPRETER

public interface Str with Comparable[Str] {
    get size Int
    get isEmpty Bool
    get nonEmpty Bool
    fn compareTo(other Str) Int
    fn runeAt(index Int) Option[Rune]
    fn slice() Str
    fn slice(start Int) Str
    fn slice(start Int, end Int) Str
    fn split(separator Str) Vector[Str]
    fn splitRegex(pattern Str) Vector[Str]
    fn trim() Str
    fn trimLeft() Str
    fn trimRight() Str
    fn toLower() Str
    fn toUpper() Str
    fn contains(part Str) Bool
    fn startsWith(prefix Str) Bool
    fn endsWith(suffix Str) Bool
    fn indexOf(part Str) Option[Int]
    fn replaceFirst(target Str, replacement Str) Str
    fn replaceAll(target Str, replacement Str) Str
    fn replaceFirstRegex(pattern Str, replacement Str) Str
    fn replaceAllRegex(pattern Str, replacement Str) Str
}

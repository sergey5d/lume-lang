# JAVA_SKIP
# INTERPRETER

public object Math {
    fn min(left Int, right Int) Int =
        if left <= right { left } else { right }

    fn min(left Float, right Float) Float =
        if left <= right { left } else { right }

    fn max(left Int, right Int) Int =
        if left >= right { left } else { right }

    fn max(left Float, right Float) Float =
        if left >= right { left } else { right }
}

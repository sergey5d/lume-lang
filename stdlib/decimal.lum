# PRELUDE_SKIP
# JAVA_SKIP
# INTERPRETER

public interface Decimal with Hashed[Decimal], Comparable[Decimal] {
    get scale Int
    fn compareTo(other Decimal) Int
    fn equals(other Decimal) Bool
    fn hash() Int
    fn abs() Decimal
    fn divide(other Decimal, scale Int, rounding Rounding) Decimal
    fn round(scale Int, rounding Rounding) Decimal
    fn toInt() Int?
    fn toFloat() Float
}

public object Decimal {
    fn parse(value Str) Decimal? =
        panic("Decimal.parse is provided by the active runtime")
}

public type Rounding =
    object Up {}
    | object Down {}
    | object Ceiling {}
    | object Floor {}
    | object HalfUp {}
    | object HalfDown {}
    | object HalfEven {}
    | object Unnecessary {}

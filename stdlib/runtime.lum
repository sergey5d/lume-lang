# PRELUDE_SKIP
# INTERPRETER

interface Annotated {
    def annotation[reified Ann]() Option[AnnotationValue]
    def hasAnnotation[reified Ann]() Bool
}

interface AnnotationValue {
    def name() Str
    def field(name Str) Option[Any]
    def str(name Str) Option[Str]
}

class ReflectionError {
    message Str
}

enum TypeKind {
    case Class
    case Shape
    case Enum
    case Interface
    case Single
    case Annotation
    case Primitive
    case Tuple
    case Function
    case AnonymousShape
}

interface Type[A] with Annotated {
    def name() Option[Str]
    def qualifiedName() Option[Str]
    def kind() TypeKind

    def asClass() Option[ClassType[A]]
    def asShape() Option[ShapeType[A]]
    def asEnum() Option[EnumType[A]]
    def asInterface() Option[InterfaceType[A]]
    def asSingle() Option[SingleType[A]]
    def asAnnotation() Option[AnnotationType[A]]
}

interface ClassType[A] with Type[A] {
    def fields() [Field]
    def methods() [Method]
    def field(name Str) Option[Field]
    def method(name Str) Option[Method]
    def construct(args [Any] vararg) Result[A, ReflectionError]
}

interface ShapeType[A] with Type[A] {
    def fields() [Field]
    def methods() [Method]
    def construct(args [Any] vararg) Result[A, ReflectionError]
}

interface EnumType[A] with Type[A] {
    def cases() [EnumCase]
    def case(name Str) Option[EnumCase]
    def methods() [Method]
}

interface InterfaceType[A] with Type[A] {
    def methods() [Method]
}

interface SingleType[A] with Type[A] {
    def fields() [Field]
    def methods() [Method]
    def field(name Str) Option[Field]
    def method(name Str) Option[Method]
}

interface AnnotationType[A] with Type[A] {
    def fields() [Field]
}

interface Field with Annotated {
    def name() Str
    def fieldType() Type[_]
    def get(receiver Any) Result[Any, ReflectionError]
}

interface Method with Annotated {
    def name() Str
    def params() [Param]
    def returnType() Type[_]
    def invoke(receiver Any, args [Any] vararg) Any
    def call(receiver Any, args [Any] vararg) Result[Any, ReflectionError]
}

interface Param {
    def name() Str
    def paramType() Type[_]
}

interface EnumCase with Annotated {
    def name() Str
    def fields() [Field]
    def construct(args [Any] vararg) Result[Any, ReflectionError]
}

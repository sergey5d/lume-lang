# PRELUDE_SKIP
# INTERPRETER

interface Annotated {
    def annotation[reified Ann]() Option[AnnotationValue]
    def hasAnnotation[reified Ann]() Bool
}

interface AnnotationValue {
    get name Str
    def field(name Str) Option[Any]
    def str(name Str) Option[Str]
}

class ReflectionError {
    message Str
}

type TypeKind =
    object Class {}
    | object Shape {}
    | object Union {}
    | object Interface {}
    | object Object {}
    | object Annotation {}
    | object Primitive {}
    | object Tuple {}
    | object Function {}
    | object AnonymousShape {}

interface Type[A] with Annotated {
    get name Option[Str]
    get qualifiedName Option[Str]
    get kind TypeKind

    def asClass() Option[ClassType[A]]
    def asShape() Option[ShapeType[A]]
    def asUnion() Option[UnionType[A]]
    def asInterface() Option[InterfaceType[A]]
    def asObject() Option[ObjectType[A]]
    def asAnnotation() Option[AnnotationType[A]]
}

interface ClassType[A] with Type[A] {
    get fields [Field]
    get methods [Method]
    def field(name Str) Option[Field]
    def method(name Str) Option[Method]
    def construct(args [Any] vararg) Result[A, ReflectionError]
}

interface ShapeType[A] with Type[A] {
    get fields [Field]
    get methods [Method]
    def construct(args [Any] vararg) Result[A, ReflectionError]
}

interface UnionType[A] with Type[A] {
    get alternatives [UnionAlternative]
    def alternative(name Str) Option[UnionAlternative]
    get methods [Method]
}

interface InterfaceType[A] with Type[A] {
    get methods [Method]
}

interface ObjectType[A] with Type[A] {
    get fields [Field]
    get methods [Method]
    def field(name Str) Option[Field]
    def method(name Str) Option[Method]
}

interface AnnotationType[A] with Type[A] {
    get fields [Field]
}

interface Field with Annotated {
    get name Str
    get fieldType Type[_]
    get isPrivate Bool
    def get(receiver Any) Result[Any, ReflectionError]
}

interface Method with Annotated {
    get name Str
    get params [Param]
    get returnType Type[_]
    def call(receiver Any, args [Any] vararg) Result[Any, ReflectionError]
}

interface Param {
    get name Str
    get paramType Type[_]
}

interface UnionAlternative with Annotated {
    get name Str
    get fields [Field]
    def construct(args [Any] vararg) Result[Any, ReflectionError]
}

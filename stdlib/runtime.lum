# PRELUDE_SKIP
# INTERPRETER

public interface Annotated {
    fn annotation[reified Ann]() Option[AnnotationValue]
    fn hasAnnotation[reified Ann]() Bool
}

public interface AnnotationValue {
    get name Str
    fn field(name Str) Option[Any]
    fn str(name Str) Option[Str]
}

public class ReflectionError {
    message Str
}

public type TypeKind =
    object Class {}
    | object Shape {}
    | object Union {}
    | object Interface {}
    | object Object {}
    | object Annotation {}
    | object Primitive {}
    | object Tuple {}
    | object Function {}
    | object AnonymousShape {}

public interface Type[A] with Annotated {
    get name Option[Str]
    get qualifiedName Option[Str]
    get kind TypeKind

    fn asClass() Option[ClassType[A]]
    fn asShape() Option[ShapeType[A]]
    fn asUnion() Option[UnionType[A]]
    fn asInterface() Option[InterfaceType[A]]
    fn asObject() Option[ObjectType[A]]
    fn asAnnotation() Option[AnnotationType[A]]
}

public interface ClassType[A] with Type[A] {
    get fields [Field]
    get methods [Method]
    fn field(name Str) Option[Field]
    fn method(name Str) Option[Method]
    fn construct(args [Any] vararg) Result[A, ReflectionError]
}

public interface ShapeType[A] with Type[A] {
    get fields [Field]
    get methods [Method]
    fn construct(args [Any] vararg) Result[A, ReflectionError]
}

public interface UnionType[A] with Type[A] {
    get alternatives [UnionAlternative]
    fn alternative(name Str) Option[UnionAlternative]
    get methods [Method]
}

public interface InterfaceType[A] with Type[A] {
    get methods [Method]
}

public interface ObjectType[A] with Type[A] {
    get fields [Field]
    get methods [Method]
    fn field(name Str) Option[Field]
    fn method(name Str) Option[Method]
}

public interface AnnotationType[A] with Type[A] {
    get fields [Field]
}

public interface Field with Annotated {
    get name Str
    get fieldType Type[_]
    get isPrivate Bool
    fn get(receiver Any) Result[Any, ReflectionError]
}

public interface Method with Annotated {
    get name Str
    get params [Param]
    get returnType Type[_]
    fn call(receiver Any, args [Any] vararg) Result[Any, ReflectionError]
}

public interface Param {
    get name Str
    get paramType Type[_]
}

public interface UnionAlternative with Annotated {
    get name Str
    get fields [Field]
    fn construct(args [Any] vararg) Result[Any, ReflectionError]
}

# PRELUDE_SKIP
# INTERPRETER

interface Annotated {
    def annotation[A]() Option[A]
    def hasAnnotation[A]() Bool
}

enum TypeKind {
    case Class
    case Shape
    case Enum
    case Interface
    case Single
    case Annotation
    case Primitive
    case Tuple
    case Function
    case AnonymousShape
}

interface Type with Annotated {
    def name() Option[Str]
    def qualifiedName() Option[Str]
    def kind() TypeKind

    def asClass() Option[ClassType]
    def asShape() Option[ShapeType]
    def asEnum() Option[EnumType]
    def asInterface() Option[InterfaceType]
    def asSingle() Option[SingleType]
    def asAnnotation() Option[AnnotationType]
}

interface ClassType with Type {
    def fields() [Field]
    def methods() [Method]
    def field(name Str) Option[Field]
    def method(name Str) Option[Method]
}

interface ShapeType with Type {
    def fields() [Field]
    def methods() [Method]
}

interface EnumType with Type {
    def cases() [EnumCase]
    def case(name Str) Option[EnumCase]
    def methods() [Method]
}

interface InterfaceType with Type {
    def methods() [Method]
}

interface SingleType with Type {
    def fields() [Field]
    def methods() [Method]
    def field(name Str) Option[Field]
    def method(name Str) Option[Method]
}

interface AnnotationType with Type {
    def fields() [Field]
}

interface Field with Annotated {
    def name() Str
    def fieldType() Type
}

interface Method with Annotated {
    def name() Str
    def params() [Param]
    def returnType() Type
}

interface Param {
    def name() Str
    def paramType() Type
}

interface EnumCase with Annotated {
    def name() Str
    def fields() [Field]
}

# PRELUDE_SKIP
# INTERPRETER

def panic(value [Any] vararg) Never = panic()

def assert(condition Bool, message [Str] vararg) Unit = assert(condition)

def identity[T](value T) T = value

def ensure[E](condition Bool, error => E) Result[Unit, E] =
    if condition {
        Ok(())
    } else {
        Err(error)
    }

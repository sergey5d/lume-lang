# PRELUDE_SKIP
# INTERPRETER

public fn panic(value [Any] vararg) Never = panic()

public fn assert(condition Bool, message Str = "assert condition was false") Unit = assert(condition)

public fn identity[T](value T) T = value

public fn ensure[E](condition Bool, error fn() E) Result[Unit, E] =
    if condition {
        Ok(())
    } else {
        Err(error())
    }

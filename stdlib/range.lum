# PRELUDE_SKIP
# JAVA_SKIP
# INTERPRETER

public fn Range(start Int, end Int, step Int = 1) IntRange =
    panic("Range construction is provided by the active runtime")

public class IntRange with Iterable[Int] {
    start Int
    end Int
    step Int

    fn iterator() Iterator[Int] = RangeIterator { start: this.start, end: this.end, step: this.step }

    fn zip[X](other [X]) [(Int, X)] {
        out [(Int, X)] = []
        right Iterator[X] = other.iterator()
        for left <- this {
            if !right.hasNext {
                return out
            }
            out.add((left, right.next()))
        }
        return out
    }

    fn zipWithIndex() [(Int, Int)] {
        out [(Int, Int)] = []
        var index = 0
        for item <- this {
            out.add((item, index))
            index += 1
        }
        return out
    }
}

private class RangeIterator with Iterator[Int] {
    var current Int
    var end Int
    var step Int

    new(start Int, end Int, step Int) {
        this.current = start
        this.end = end
        this.step = step
    }

    get hasNext Bool {
        if this.step > 0 {
            return this.current < this.end
        }
        return this.current > this.end
    }

    fn next() Int {
        value Int = this.current
        this.current := this.current + this.step
        value
    }
}

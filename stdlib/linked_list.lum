# PRELUDE_SKIP
# JAVA_SKIP
# INTERPRETER

hidden interface LinkedListApi[T] with Iterable[T] {
    def append(value T) LinkedList[T]
    def add(value T) LinkedList[T]
    def addAll(values Iterable[T]) LinkedList[T]
    def map[X](f fn(T) => X) LinkedList[X]
    def flatMap[X](f fn(T) => LinkedList[X]) LinkedList[X]
    def filter(f fn(T) => Bool) LinkedList[T]
    def fold[X](initial X, f fn(X, T) => X) X
    def reduce[X](initial X, f fn(X, T) => X) X
    def reduce(f fn(T, T) => T) Option[T]
    def exists(f fn(T) => Bool) Bool
    def forAll(f fn(T) => Bool) Bool
    def zip[X](other LinkedList[X]) LinkedList[(T, X)]
    def zipWithIndex() LinkedList[(T, Int)]
    def at(index Int) Option[T]
    def setAt(index Int, value T) Result[T, InvalidIndex]
    def insertAt(index Int, value T) Result[Unit, InvalidIndex]
    def removeAt(index Int) Result[T, InvalidIndex]
    def head() Option[T]
    def first() Option[T]
    def last() Option[T]
    def tail() LinkedList[T]
    def isEmpty() Bool
    def nonEmpty() Bool = !this.isEmpty()
    def removeFirst() Option[T]
    def removeLast() Option[T]
    def size() Int
    def forEach(f fn(T) => Unit)
    def iterator() Iterator[T]

    def makeStr(separator Str) Str {
        var result Str = ""
        for idx <- Range(0, this.size()) {
            if let Some(item) = this.at(idx) {
                if idx > 0 {
                    result := result + separator
                }
                result := result + item
            }
        }
        result
    }
}

class LinkedList[T] with LinkedListApi[T] {
    new(values [T] vararg) =
        panic("LinkedList construction is provided by the active runtime")
}

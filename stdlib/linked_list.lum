# PRELUDE_SKIP
# JAVA_SKIP
# INTERPRETER

private interface LinkedListApi[T] with Iterable[T] {
    fn add(value T) LinkedList[T]
    fn addAll(values Iterable[T]) LinkedList[T]
    fn map[X](f fn(T) X) LinkedList[X]
    fn flatMap[X](f fn(T) Iterable[X]) LinkedList[X]
    fn filter(f fn(T) Bool) LinkedList[T]
    fn fold[X](initial X, f fn(X, T) X) X
    fn reduce(f fn(T, T) T) Option[T]
    fn exists(f fn(T) Bool) Bool
    fn forAll(f fn(T) Bool) Bool
    fn indexOf(value T) Option[Int]
    fn zip[X](other LinkedList[X]) LinkedList[(T, X)]
    fn zipWithIndex() LinkedList[(T, Int)]
    fn at(index Int) Option[T]
    fn setAt(index Int, value T) Result[T, InvalidIndex]
    fn insertAt(index Int, value T) Result[Unit, InvalidIndex]
    fn removeAt(index Int) Result[T, InvalidIndex]
    get first Option[T]
    get last Option[T]
    fn tail() LinkedList[T]
    get isEmpty Bool
    get nonEmpty Bool
    fn removeFirst() Option[T]
    fn removeLast() Option[T]
    get size Int
    fn forEach(f fn(T) Unit)
    fn iterator() Iterator[T]
    fn makeStr(separator Str) Str
    fn makeStr(separator Str, render fn(T) Str) Str
}

private mixin LinkedListParts[T] with LinkedListApi[T] {
    get nonEmpty Bool = !this.isEmpty

    fn makeStr(separator Str) Str {
        var result Str = ""
        for idx <- Range(0, this.size) {
            if let Some { value as item } = this.at(idx) {
                if idx > 0 {
                    result := result + separator
                }
                result := result + item
            }
        }
        result
    }

    fn makeStr(separator Str, render fn(T) Str) Str {
        var result Str = ""
        for idx <- Range(0, this.size) {
            if let Some { value as item } = this.at(idx) {
                if idx > 0 {
                    result := result + separator
                }
                result := result + render(item)
            }
        }
        result
    }
}

public class LinkedList[T] with LinkedListApi[T] {
    use LinkedListParts[T]

    new(values [T] vararg) =
        panic("LinkedList construction is provided by the active runtime")
}

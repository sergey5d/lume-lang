# PRELUDE_SKIP
# INTERPRETER

public type Either[L, R] =
    class Left { value L }
    | class Right { value R }

ext Either[L, R] {
    get isLeft Bool = match this {
        case Left { value: _ } => true
        case Right { value: _ } => false
    }

    get isRight Bool = !this.isLeft

    fn expectRight() R = match this {
        case Left { value: _ } => panic("Either has no right value")
        case Right { value } => value
    }

    fn expectLeft() L = match this {
        case Left { value } => value
        case Right { value: _ } => panic("Either has no left value")
    }

    fn orElse(fallback fn() Either[L, R]) Either[L, R] = match this {
        case Left { value: _ } => fallback()
        case Right { value } => Right(value)
    }

    fn map[X](f fn(R) X) Either[L, X] = match this {
        case Left { value } => Left(value)
        case Right { value } => Right(f(value))
    }

    fn mapLeft[X](f fn(L) X) Either[X, R] = match this {
        case Left { value } => Left(f(value))
        case Right { value } => Right(value)
    }

    fn flatMap[X](f fn(R) Either[L, X]) Either[L, X] = match this {
        case Left { value } => Left(value)
        case Right { value } => f(value)
    }

    fn merge[when L = R]() L = match this {
        case Left { value } => value
        case Right { value } => value
    }

    fn toOption() Option[R] = match this {
        case Left { value: _ } => None
        case Right { value } => Some(value)
    }

    fn toResult() Result[R, L] = match this {
        case Left { value } => Err(value)
        case Right { value } => Ok(value)
    }
}

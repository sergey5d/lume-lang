# PRELUDE_SKIP
# JAVA_SKIP
# INTERPRETER

private interface SetApi[T] with Iterable[T] {
    def add(value T) Set[T]
    def addAll(values Iterable[T]) Set[T]
    def iterator() Iterator[T]
    def map[X](f fn(T) X) Set[X]
    def flatMap[X](f fn(T) Set[X]) Set[X]
    def filter(f fn(T) Bool) Set[T]
    def fold[X](initial X, f fn(X, T) X) X
    def reduce(f fn(T, T) T) Option[T]
    def exists(f fn(T) Bool) Bool
    def forAll(f fn(T) Bool) Bool
    def forEach(f fn(T) Unit)
    def contains(value T) Bool
    def isEmpty Bool
    def nonEmpty Bool = !this.isEmpty
    def size Int

    def makeStr(separator Str) Str {
        var result Str = ""
        var first Bool = true
        for item <- this {
            if !first {
                result := result + separator
            }
            result := result + item
            first := false
        }
        result
    }

    def makeStr(separator Str, render fn(T) Str) Str {
        var result Str = ""
        var first Bool = true
        for item <- this {
            if !first {
                result := result + separator
            }
            result := result + render(item)
            first := false
        }
        result
    }
}

class Set[T] with SetApi[T] {
    new(values [T] vararg) =
        panic("Set construction is provided by the active runtime")
}

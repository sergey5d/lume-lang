# PRELUDE_SKIP
# JAVA_SKIP
# INTERPRETER

private interface SetApi[T] with Iterable[T] {
    fn add(value T) Set[T]
    fn addAll(values Iterable[T]) Set[T]
    fn iterator() Iterator[T]
    fn map[X](f fn(T) X) Set[X]
    fn flatMap[X](f fn(T) Iterable[X]) Set[X]
    fn filter(f fn(T) Bool) Set[T]
    fn fold[X](initial X, f fn(X, T) X) X
    fn reduce(f fn(T, T) T) Option[T]
    fn exists(f fn(T) Bool) Bool
    fn forAll(f fn(T) Bool) Bool
    fn forEach(f fn(T) Unit)
    fn contains(value T) Bool
    get isEmpty Bool
    get nonEmpty Bool
    get size Int
    fn makeStr(separator Str) Str
    fn makeStr(separator Str, render fn(T) Str) Str
}

private mixin SetParts[T] with SetApi[T] {
    get nonEmpty Bool = !this.isEmpty

    fn makeStr(separator Str) Str {
        var result Str = ""
        var first Bool = true
        for item <- this {
            if !first {
                result := result + separator
            }
            result := result + item
            first := false
        }
        result
    }

    fn makeStr(separator Str, render fn(T) Str) Str {
        var result Str = ""
        var first Bool = true
        for item <- this {
            if !first {
                result := result + separator
            }
            result := result + render(item)
            first := false
        }
        result
    }
}

public class Set[T] with SetApi[T] {
    use SetParts[T]

    new(values [T] vararg) =
        panic("Set construction is provided by the active runtime")
}

# PRELUDE_SKIP
# JAVA_SKIP
# INTERPRETER

hidden interface ArrayApi[T] with Iterable[T] {
    def at(index Int) Option[T]
    def setAt(index Int, value T) Result[T, InvalidIndex]

    def first() Option[T]
    def last() Option[T]

    def clone() Array[T]

    def map[X](f fn(T) X) Array[X]
    def forEach(f fn(T) Unit)

    def count(f fn(T) Bool) Int

    def exists(f fn(T) Bool) Bool
    def forAll(f fn(T) Bool) Bool

    def contains(e T) Bool
    def find(e T) Option[T]

    def indexOf(e T) Int

    def zip[X](other Array[X]) Array[(T, X)]
    def zipWithIndex() Array[(T, Int)]

    def size() Int
}

class Array[T] with ArrayApi[T] {
    new(values [T] vararg) =
        panic("Array construction is provided by the active runtime")
}

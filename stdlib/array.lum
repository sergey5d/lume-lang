# PRELUDE_SKIP
# JAVA_SKIP
# INTERPRETER

interface Array[T] with Iterable[T] {
    def append(value T) Array[T]
    def add(value T) Array[T]
    def addAll(values Iterable[T]) Array[T]
    def map[X](f fn(T) => X) Array[X]
    def flatMap[X](f fn(T) => Array[X]) Array[X]
    def filter(f fn(T) => Bool) Array[T]
    def fold[X](initial X, f fn(X, T) => X) X
    def reduce[X](initial X, f fn(X, T) => X) X
    def reduce(f fn(T, T) => T) Option[T]
    def exists(f fn(T) => Bool) Bool
    def forAll(f fn(T) => Bool) Bool
    def sort(ordering Ordering[T]) Array[T]
    def zip[X](other Array[X]) Array[(T, X)]
    def zipWithIndex() Array[(T, Int)]
    def get(index Int) Option[T]
    def head() Option[T]
    def tail() Array[T]
    def isEmpty() Bool
    def nonEmpty() Bool = !this.isEmpty()
    def remove(index Int) Option[T]
    def removeFirst() Option[T]
    def removeLast() Option[T]
    def size() Int
    def forEach(f fn(T) => Unit)

    def makeStr(separator Str) Str {
        var result Str = ""
        for idx <- Range(0, this.size()) {
            if let Some(item) = this.get(idx) {
                if idx > 0 {
                    result := result + separator
                }
                result := result + item
            }
        }
        result
    }
}

# PRELUDE_SKIP
# JAVA_SKIP
# INTERPRETER

private interface ArrayApi[T] with Iterable[T] {
    fn at(index Int) Option[T]
    fn setAt(index Int, value T) Result[T, InvalidIndex]

    get first Option[T]
    get last Option[T]

    fn clone() Array[T]

    fn map[X](f fn(T) X) Array[X]
    fn forEach(f fn(T) Unit)

    fn count(f fn(T) Bool) Int

    fn exists(f fn(T) Bool) Bool
    fn forAll(f fn(T) Bool) Bool

    fn contains(e T) Bool
    fn find(e T) Option[T]

    fn indexOf(value T) Option[Int]

    fn zip[X](other Array[X]) Array[(T, X)]
    fn zipWithIndex() Array[(T, Int)]

    get size Int
}

public class Array[T] with ArrayApi[T] {
    new(values [T] vararg) =
        panic("Array construction is provided by the active runtime")
}

# PRELUDE_SKIP
# INTERPRETER

public type Option[T] with Iterable[T] =
    class Some { value T }
    | object None {}

ext Option[T] {
    get isSet Bool = match this {
        case Some { value: _ } => true
        case None => false
    }

    get isEmpty Bool = !this.isSet

    def orElse(fallback => Option[T]) Option[T] = match this {
        case Some { value } => Some(value)
        case None => fallback
    }

    def toResult[E](error => E) Result[T, E] = match this {
        case Some { value } => Ok(value)
        case None => Err(error)
    }

    def toEither[L](left => L) Either[L, T] = match this {
        case Some { value } => Right(value)
        case None => Left(left)
    }

    def map[X](f fn(T) X) Option[X] = match this {
        case Some { value } => Some(f(value))
        case None => None
    }

    def flatMap[X](f fn(T) Option[X]) Option[X] = match this {
        case Some { value } => f(value)
        case None => None
    }

    def iterator() Iterator[T] = match this {
        case Some { value } => [value].iterator()
        case None => Vector[T]().iterator()
    }
}

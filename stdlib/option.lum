# PRELUDE_SKIP
# INTERPRETER

enum Option[T] {
    case None
    case Some {
        value T
    }

    def isSet() Bool = match this {
        case Some(_) => true
        case Option.None => false
    }

    def isEmpty() Bool = !this.isSet()

    def orPanic() T = match this {
        case Some(value) => value
        case Option.None => panic("Option has no value")
    }

    def getOr(lazy defaultValue T) T = match this {
        case Some(value) => value
        case Option.None => defaultValue
    }

    def orElse(lazy fallback Option[T]) Option[T] = match this {
        case Some(value) => Some(value)
        case Option.None => fallback
    }

    def toResult[E](lazy error E) Result[T, E] = match this {
        case Some(value) => Ok(value)
        case Option.None => Err(error)
    }

    def toEither[L](lazy left L) Either[L, T] = match this {
        case Some(value) => Right(value)
        case Option.None => Left(left)
    }

    def map[X](f (T) => X) Option[X] = match this {
        case Some(value) => Some(f(value))
        case Option.None => None()
    }

    def flatMap[X](f (T) => Option[X]) Option[X] = match this {
        case Some(value) => f(value)
        case Option.None => None()
    }
}

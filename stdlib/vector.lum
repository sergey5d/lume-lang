# PRELUDE_SKIP
# JAVA_SKIP
# INTERPRETER

interface Vector[T] with Iterable[T] {
    def append(value T) Vector[T]
    def add(value T) Vector[T]
    def addAll(values Iterable[T]) Vector[T]
    def map[X](f fn(T) => X) Vector[X]
    def flatMap[X](f fn(T) => Vector[X]) Vector[X]
    def filter(f fn(T) => Bool) Vector[T]
    def fold[X](initial X, f fn(X, T) => X) X
    def reduce[X](initial X, f fn(X, T) => X) X
    def reduce(f fn(T, T) => T) Option[T]
    def exists(f fn(T) => Bool) Bool
    def forAll(f fn(T) => Bool) Bool
    def sort(ordering Ordering[T]) Vector[T]
    def zip[X](other Vector[X]) Vector[(T, X)]
    def zipWithIndex() Vector[(T, Int)]
    def at(index Int) Option[T]
    def setAt(index Int, value T) Result[T, InvalidIndex]
    def insertAt(index Int, value T) Result[Unit, InvalidIndex]
    def removeAt(index Int) Result[T, InvalidIndex]
    def head() Option[T]
    def tail() Vector[T]
    def isEmpty() Bool
    def nonEmpty() Bool = !this.isEmpty()
    def removeFirst() Option[T]
    def removeLast() Option[T]
    def size() Int
    def forEach(f fn(T) => Unit)

    def makeStr(separator Str) Str {
        var result Str = ""
        for idx <- Range(0, this.size()) {
            if let Some(item) = this.at(idx) {
                if idx > 0 {
                    result := result + separator
                }
                result := result + item
            }
        }
        result
    }
}

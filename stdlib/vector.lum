# PRELUDE_SKIP
# JAVA_SKIP
# INTERPRETER

private interface VectorApi[T] with Iterable[T] {
    fn add(value T) Vector[T]
    fn addAll(values Iterable[T]) Vector[T]
    fn map[X](f fn(T) X) Vector[X]
    fn flatMap[X](f fn(T) Iterable[X]) Vector[X]
    fn flatten[X when T with Iterable[X]]() Vector[X]
    fn filter(f fn(T) Bool) Vector[T]
    fn fold[X](initial X, f fn(X, T) X) X
    fn reduce(f fn(T, T) T) Option[T]
    fn exists(f fn(T) Bool) Bool
    fn forAll(f fn(T) Bool) Bool
    fn contains(value T) Bool
    fn indexOf(value T) Option[Int]
    fn sort[when T with Comparable[T]]() Vector[T]
    fn sort(compare fn(T, T) Int) Vector[T]
    fn take(count Int) Vector[T]
    fn zip[X](other Vector[X]) Vector[(T, X)]
    fn zipWithIndex() Vector[(T, Int)]
    fn at(index Int) Option[T]
    fn slice() Vector[T]
    fn slice(start Int) Vector[T]
    fn slice(start Int, end Int) Vector[T]
    fn setAt(index Int, value T) Result[T, InvalidIndex]
    fn insertAt(index Int, value T) Result[Unit, InvalidIndex]
    fn removeAt(index Int) Result[T, InvalidIndex]
    get first Option[T]
    get last Option[T]
    fn tail() Vector[T]
    get isEmpty Bool
    get nonEmpty Bool
    fn removeFirst() Option[T]
    fn removeLast() Option[T]
    get size Int
    fn forEach(f fn(T) Unit)
    fn makeStr(separator Str) Str
    fn makeStr(separator Str, render fn(T) Str) Str
}

private mixin VectorParts[T] with VectorApi[T] {
    get nonEmpty Bool = !this.isEmpty

    fn makeStr(separator Str) Str {
        var result Str = ""
        for idx <- Range(0, this.size) {
            if let Some { value as item } = this.at(idx) {
                if idx > 0 {
                    result := result + separator
                }
                result := result + item
            }
        }
        result
    }

    fn makeStr(separator Str, render fn(T) Str) Str {
        var result Str = ""
        for idx <- Range(0, this.size) {
            if let Some { value as item } = this.at(idx) {
                if idx > 0 {
                    result := result + separator
                }
                result := result + render(item)
            }
        }
        result
    }
}

public class Vector[T] with VectorApi[T] {
    use VectorParts[T]

    new(values [T] vararg) =
        panic("Vector construction is provided by the active runtime")
}

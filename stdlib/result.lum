# PRELUDE_SKIP
# INTERPRETER

enum Result[T, E] {
    case Ok {
        value T
    }

    case Err {
        error E
    }

    def isOk() Bool = match this {
        case Ok { value: _ } => true
        case Err { error: _ } => false
    }

    def isErr() Bool = !this.isOk()

    def getError() E = match this {
        case Ok { value: _ } => panic("Result has no error value")
        case Err { error } => error
    }

    def getOr(defaultValue => T) T = match this {
        case Ok { value } => value
        case Err { error: _ } => defaultValue
    }

    def orElse(fallback => Result[T, E]) Result[T, E] = match this {
        case Ok { value } => Ok(value)
        case Err { error: _ } => fallback
    }

    def toOption() Option[T] = match this {
        case Ok { value } => Some(value)
        case Err { error: _ } => None()
    }

    def toEither() Either[E, T] = match this {
        case Ok { value } => Right(value)
        case Err { error } => Left(error)
    }

    def map[X](f fn(T) X) Result[X, E] = match this {
        case Ok { value } => Ok(f(value))
        case Err { error } => Err(error)
    }

    def mapError[X](f fn(E) X) Result[T, X] = match this {
        case Ok { value } => Ok(value)
        case Err { error } => Err(f(error))
    }

    def flatMap[X](f fn(T) Result[X, E]) Result[X, E] = match this {
        case Ok { value } => f(value)
        case Err { error } => Err(error)
    }
}

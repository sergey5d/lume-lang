# PRELUDE_SKIP
# INTERPRETER

public type Result[T, E] =
    class Ok { value T }
    | class Err { error E }

ext Result[T, E] {
    get isOk Bool = match this {
        case Ok { value: _ } => true
        case Err { error: _ } => false
    }

    get isErr Bool = !this.isOk

    fn expectErr() E = match this {
        case Ok { value: _ } => panic("expected Result.Err")
        case Err { error } => error
    }

    fn orElse(fallback fn() Result[T, E]) Result[T, E] = match this {
        case Ok { value } => Ok(value)
        case Err { error: _ } => fallback()
    }

    fn toOption() Option[T] = match this {
        case Ok { value } => Some(value)
        case Err { error: _ } => None
    }

    fn toEither() Either[E, T] = match this {
        case Ok { value } => Right(value)
        case Err { error } => Left(error)
    }

    fn map[X](f fn(T) X) Result[X, E] = match this {
        case Ok { value } => Ok(f(value))
        case Err { error } => Err(error)
    }

    fn mapError[X](f fn(E) X) Result[T, X] = match this {
        case Ok { value } => Ok(value)
        case Err { error } => Err(f(error))
    }

    fn flatMap[X](f fn(T) Result[X, E]) Result[X, E] = match this {
        case Ok { value } => f(value)
        case Err { error } => Err(error)
    }
}

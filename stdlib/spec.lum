# PRELUDE_SKIP
# JAVA_SKIP

interface Spec {
    def it()
}

ext Bool {
    def shouldBe(expected Bool) Unit {
        if this != expected {
            panic("expected " + expected.toStr() + ", got " + this.toStr())
        }
    }
}

ext Int {
    def shouldBe(expected Int) Unit {
        if this != expected {
            panic("expected " + expected.toStr() + ", got " + this.toStr())
        }
    }
}

ext Float {
    def shouldBe(expected Float) Unit {
        if this != expected {
            panic("expected " + expected.toStr() + ", got " + this.toStr())
        }
    }
}

ext Rune {
    def shouldBe(expected Rune) Unit {
        if this != expected {
            panic("expected " + expected.toStr() + ", got " + this.toStr())
        }
    }
}

ext Str {
    def shouldBe(expected Str) Unit {
        if this != expected {
            panic("expected " + expected + ", got " + this)
        }
    }
}

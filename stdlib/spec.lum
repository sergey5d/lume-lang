# PRELUDE_SKIP
# JAVA_SKIP

public interface Spec {
    fn it()
}

ext Bool {
    fn shouldBe(expected Bool) Unit {
        if this != expected {
            panic("expected " + expected.toStr() + ", got " + this.toStr())
        }
    }
}

ext Int {
    fn shouldBe(expected Int) Unit {
        if this != expected {
            panic("expected " + expected.toStr() + ", got " + this.toStr())
        }
    }
}

ext Float {
    fn shouldBe(expected Float) Unit {
        if this != expected {
            panic("expected " + expected.toStr() + ", got " + this.toStr())
        }
    }
}

ext Rune {
    fn shouldBe(expected Rune) Unit {
        if this != expected {
            panic("expected " + expected.toStr() + ", got " + this.toStr())
        }
    }
}

ext Str {
    fn shouldBe(expected Str) Unit {
        if this != expected {
            panic("expected " + expected + ", got " + this)
        }
    }
}

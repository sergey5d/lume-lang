# INTERPRETER

public interface Int with Comparable[Int] {
    def compareTo(other Int) Int
    def abs() Int
    def pow(exponent Int) Int
    def sqrt() Float
    def toFloat() Float
}

public object Int {
    get MIN Int = panic("Int.MIN is provided by the active runtime")
    get MAX Int = panic("Int.MAX is provided by the active runtime")

    def parse(value Str) Option[Int] =
        panic("Int.parse is provided by the active runtime")
}

public interface Float with Comparable[Float] {
    def compareTo(other Float) Int
    def abs() Float
    def pow(exponent Int) Float
    def pow(exponent Float) Float
    def floor() Float
    def ceil() Float
    def round() Float
    def sqrt() Float
    def log() Float
    def toInt() Int
}

public object Float {
    get MIN Float = panic("Float.MIN is provided by the active runtime")
    get MAX Float = panic("Float.MAX is provided by the active runtime")

    def parse(value Str) Option[Float] =
        panic("Float.parse is provided by the active runtime")
}

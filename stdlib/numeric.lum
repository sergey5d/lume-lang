# PRELUDE_SKIP
# JAVA_SKIP
# INTERPRETER

public interface Int with Comparable[Int] {
    fn compareTo(other Int) Int
    fn abs() Int
    fn pow(exponent Int) Int
    fn wrappingAdd(other Int) Int
    fn wrappingSub(other Int) Int
    fn wrappingMul(other Int) Int
    fn wrappingNeg() Int
    fn checkedAdd(other Int) Int?
    fn checkedSub(other Int) Int?
    fn checkedMul(other Int) Int?
    fn checkedPow(exponent Int) Int?
    fn sqrt() Float
    fn toFloat() Float
    fn toDecimal() Decimal
}

public object Int {
    # Fixed value constants use UPPER_CASE; runtime properties use camelCase.
    get MIN Int = panic("Int.MIN is provided by the active runtime")
    get MAX Int = panic("Int.MAX is provided by the active runtime")

    fn parse(value Str) Option[Int] =
        panic("Int.parse is provided by the active runtime")
}

public interface Float with Comparable[Float] {
    fn compareTo(other Float) Int
    fn abs() Float
    fn pow(exponent Int) Float
    fn pow(exponent Float) Float
    fn floor() Float
    fn ceil() Float
    fn round() Float
    fn sqrt() Float
    fn log() Float
    fn toInt() Int
    fn toDecimal() Decimal?
}

public object Float {
    get MIN Float = panic("Float.MIN is provided by the active runtime")
    get MAX Float = panic("Float.MAX is provided by the active runtime")

    fn parse(value Str) Option[Float] =
        panic("Float.parse is provided by the active runtime")
}

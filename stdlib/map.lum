# PRELUDE_SKIP
# JAVA_SKIP
# INTERPRETER

hidden interface MapApi[K, V] with Iterable[(K, V)] {
    def put(key K, value V) Map[K, V]
    def iterator() Iterator[(K, V)]
    def map[X](f fn(K, V) => X) Vector[X]
    def mapValues[X](f fn(V) => X) Map[K, X]
    def flatMap[X](f fn(K, V) => Vector[X]) Vector[X]
    def filter(f fn(K, V) => Bool) Map[K, V]
    def fold[X](initial X, f fn(X, K, V) => X) X
    def reduce(f fn(K, V, K, V) => (K, V)) Option[(K, V)]
    def exists(f fn(K, V) => Bool) Bool
    def forAll(f fn(K, V) => Bool) Bool
    def forEach(f fn(K, V) => Unit)
    def get(key K) Option[V]
    def contains(key K) Bool
    def size() Int
    def clear() Unit
    def entries() [(K, V)]
}

class Map[K, V] with MapApi[K, V] {
    new(entries [(K, V)] vararg) =
        panic("Map construction is provided by the active runtime")
}

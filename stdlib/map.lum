# PRELUDE_SKIP
# JAVA_SKIP
# INTERPRETER

private interface MapApi[K with Hashed[K], V] with Iterable[(K, V)] {
    fn put(key K, value V) Map[K, V]
    fn iterator() Iterator[(K, V)]
    fn map[X](f fn(K, V) X) Vector[X]
    fn mapValues[X](f fn(V) X) Map[K, X]
    fn flatMap[X](f fn(K, V) Iterable[X]) Vector[X]
    fn filter(f fn(K, V) Bool) Map[K, V]
    fn fold[X](initial X, f fn(X, K, V) X) X
    fn reduce(f fn(K, V, K, V)(K, V)) Option[(K, V)]
    fn exists(f fn(K, V) Bool) Bool
    fn forAll(f fn(K, V) Bool) Bool
    fn forEach(f fn(K, V) Unit)
    fn get(key K) Option[V]
    fn contains(key K) Bool
    get size Int
    get isEmpty Bool
    get nonEmpty Bool
    fn clear() Unit
    fn entries() [(K, V)]
    fn keys() [K]
    fn values() [V]
}

public class Map[K with Hashed[K], V] with MapApi[K, V] {
    new(entries [(K, V)] vararg) =
        panic("Map construction is provided by the active runtime")
}

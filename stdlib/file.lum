# PRELUDE_SKIP
# JAVA_SKIP
# INTERPRETER

# Byte is an API-level distinction for now. A range-checked primitive can replace
# this alias later without changing the file API.
public type Byte = Int

public type FileError =
    class NotFound {
        path Str
    }
    | class AccessDenied {
        path Str
    }
    | class Closed {
        path Str
    }
    | class InvalidEncoding {
        path Str
        offset Int
    }
    | class IoFailure {
        operation Str
        path Str
        message Str
    }

public type SeekFrom =
    object Start {}
    | object Current {}
    | object End {}

public interface Closeable {
    get closed Bool
    fn close() Result[Unit, FileError]
}

public interface ByteReader {
    fn read(maxBytes Int) Result[[Byte], FileError]
    fn readToEnd() Result[[Byte], FileError]
}

public interface Seekable {
    get position Int
    fn seek(offset Int) Result[Int, FileError]
    fn seek(offset Int, from SeekFrom) Result[Int, FileError]
}

public interface TextReader with Closeable {
    fn readLine() Result[Str?, FileError]
    fn readToEnd() Result[Str, FileError]
}

public class FileStream with ByteReader, Seekable, Closeable {
    private new() {}

    get path Str = panic("FileStream is provided by the active runtime")
    get position Int = panic("FileStream is provided by the active runtime")
    get closed Bool = panic("FileStream is provided by the active runtime")

    fn read(maxBytes Int) Result[[Byte], FileError] =
        panic("FileStream is provided by the active runtime")

    fn readToEnd() Result[[Byte], FileError] =
        panic("FileStream is provided by the active runtime")

    fn seek(offset Int) Result[Int, FileError] =
        panic("FileStream is provided by the active runtime")

    fn seek(offset Int, from SeekFrom) Result[Int, FileError] =
        panic("FileStream is provided by the active runtime")

    fn close() Result[Unit, FileError] =
        panic("FileStream is provided by the active runtime")
}

public class TextFileReader with TextReader {
    private new() {}

    get path Str = panic("TextFileReader is provided by the active runtime")
    get closed Bool = panic("TextFileReader is provided by the active runtime")

    fn readLine() Result[Str?, FileError] =
        panic("TextFileReader is provided by the active runtime")

    fn readToEnd() Result[Str, FileError] =
        panic("TextFileReader is provided by the active runtime")

    fn close() Result[Unit, FileError] =
        panic("TextFileReader is provided by the active runtime")
}

public object File {
    fn readBytes(path Str) Result[[Byte], FileError] =
        panic("File is provided by the active runtime")

    fn readText(path Str) Result[Str, FileError] =
        panic("File is provided by the active runtime")

    fn open(path Str) Result[FileStream, FileError] =
        panic("File is provided by the active runtime")

    fn openText(path Str) Result[TextFileReader, FileError] =
        panic("File is provided by the active runtime")
}

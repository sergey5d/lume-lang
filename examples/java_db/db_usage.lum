module examples/java_db

use lume/db/{BoundExec, Database, DbError, Exec, Query, Row, RowQuery, Transaction}

class User {
    id Int
    name Str
    active Bool
}

def loadActiveUsers(db Database) Result[[User], DbError] {
    db.query("select id, name, active from users where active = ?")
        .bind(true)
        .map(row -> readUser(row))
}

def readUser(row Row) Result[User, DbError] {
    id Int = try row.intValue("id")
    name Str = try row.str("name")
    active Bool = try row.bool("active")

    Ok(User {
        id: id
        name: name
        active: active
    })
}

def loadByIdAndName(db Database, id Int, name Str) Result[[Row], DbError] {
    db.query("select id, name from users where id = ? and name = ?")
        .bind((id, name))
        .rows()
}

def loadOneUser(db Database, id Int) Result[Option[User], DbError] {
    db.queryRow("select id, name, active from users where id = ?")
        .bind(id)
        .map(row -> readUser(row))
}

def loadNamed(db Database, active Bool) Result[[Str], DbError] {
    params Map[Str, Any] = Map("active": active)

    db.query("select name from users where active = :active")
        .bind(params)
        .map(row -> row.str("name"))
}

def activateUser(db Database, id Int) Result[Int, DbError] {
    db.exec("update users set active = ? where id = ?", true, id)
}

def activateUserStaged(db Database, id Int) Result[Int, DbError] {
    statement BoundExec = db.exec("update users set active = ? where id = ?").bind(true, id)
    statement.run()
}

def replaceUser(db Database, id Int, name Str) Result[Unit, DbError] {
    db.transactionally(tx -> {
        deleted Int = try tx.exec("delete from users where id = ?", id)
        inserted Int = try tx.exec("insert into users(id, name, active) values (?, ?, ?)", id, name, true)

        Ok(())
    })
}

# IGNORE

module things

public interface Named {
    def label() Str
}

public class A with Named {

    def label() Str = "A"
}


public class B with Named {

    def label() Str = "B"
}


public object C {

    def bump(value Int) Int = value + 1

    def print(value Int) Int = value + 10
}

public object D {

    def println(value Int) Int = value + 100
}

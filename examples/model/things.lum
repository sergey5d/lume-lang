module things

interface Named {
    def label() Str
}

class A with Named {

    def label() Str = "A"
}


class B with Named {

    def label() Str = "B"
}


object C {

    def bump(value Int) Int = value + 1

    def print(value Int) Int = value + 10

    def printLn(value Int) Int = value + 100
}

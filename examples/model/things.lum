module things

interface Named {
    def label() Str
}

class A with Named {
}

impl A {
    def label() Str = "A"
}

class B with Named {
}

impl B {
    def label() Str = "B"
}

single C {
}

impl single C {
    def bump(value Int) Int = value + 1

    def print(value Int) Int = value + 10

    def printLn(value Int) Int = value + 100
}

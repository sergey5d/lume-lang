# IGNORE

module things

interface Named {
    label() Str
}

class A with Named {
}

impl A {
    label() Str = "A"
}

class B with Named {
}

impl B {
    label() Str = "B"
}

object C {
}

impl object C {
    bump(value Int) Int = value + 1

    print(value Int) Int = value + 10

    printLn(value Int) Int = value + 100
}

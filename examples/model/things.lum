# IGNORE

module things

public interface Named {
    fn label() Str
}

public class A with Named {

    fn label() Str = "A"
}


public class B with Named {

    fn label() Str = "B"
}


public object C {

    fn bump(value Int) Int = value + 1

    fn print(value Int) Int = value + 10
}

public object D {

    fn println(value Int) Int = value + 100
}

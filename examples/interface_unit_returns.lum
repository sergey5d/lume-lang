# EXPECT:
# explicit
# implicit

interface ExplicitPrinter {
    printExplicit() Unit
}

interface ImplicitPrinter {
    printImplicit()
}

class Printer with ExplicitPrinter, ImplicitPrinter {

    printExplicit() {
        println("explicit")
    }

    printImplicit() {
        println("implicit")
    }
}


main() Unit {
    printer Printer = Printer {}
    printer.printExplicit()
    printer.printImplicit()
}

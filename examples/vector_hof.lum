# EXPECT:
# item 2
# item 4
# item 6
# doubled 2 6
# expanded 1 13
# filtered 2 3
# fold 6
# reduce 6
# exists true
# forAll true
# 0

def main() Int {
    items [Int] = [1, 2, 3]
    doubled [Int] = items.map((item Int) => item * 2)
    doubled2 [Int] = items.map(item => item * 2)
    expanded [Int] = items.flatMap((item Int) => [item, item + 10])
    filtered [Int] = items.filter((item Int) => item > 1)
    total Int = items.fold(0, (acc Int, item Int) => acc + item)
    reduced Int? = items.reduce((left Int, right Int) => left + right)
    hasBig Bool = items.exists((item Int) => item > 2)
    allPositive Bool = items.forAll((item Int) => item > 0)

    doubled.forEach((item Int) => println("item " + item))

    println("doubled " + doubled.at(0).getOr(0) + " " + doubled.at(2).getOr(0))
    println("expanded " + expanded.at(0).getOr(0) + " " + expanded.at(5).getOr(0))
    println("filtered " + filtered.at(0).getOr(0) + " " + filtered.at(1).getOr(0))
    println("fold " + total)
    println("reduce " + reduced.getOr(0))
    println("exists " + hasBig)
    println("forAll " + allPositive)
    0
}

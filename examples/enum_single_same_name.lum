# EXPECT:
# red
# palette

enum Color {
    case Red
    case Blue

    def label() Str = match this {
        case Color.Red => "red"
        case Color.Blue => "blue"
    }
}

single Color {
}

impl single Color {
    def palette() Str = "palette"
}

def main() Unit {
    color Color = Color.Red
    println(color.label())
    println(Color.palette())
}

# EXPECT:
# original 10 x
# updated 42 y

class Amount {
    amount Int
    description Str
}

def main() Unit {
    value = Amount(10, "x")
    updated = value :< {
        amount: 42
        description: "y"
    }

    println("original " + value.amount + " " + value.description)
    println("updated " + updated.amount + " " + updated.description)
}

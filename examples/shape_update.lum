# EXPECT:
# original 10 x
# updated 42 y
# updated2 43 z

class Amount {
    amount Int
    description Str
}

def main() Unit {
    value = Amount(10, "x")
    updated = value with {
        amount: 42
        description: "y"
    }
    patch = {
        amount: 43
        description: "z"
    }
    updated2 = value with patch

    println("original " + value.amount + " " + value.description)
    println("updated " + updated.amount + " " + updated.description)
    println("updated2 " + updated2.amount + " " + updated2.description)
}

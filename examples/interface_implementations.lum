# EXPECT:
# shape shape-value
# enum ready
# object hi
# ref hi
# annotation Annotation

interface Labeled {
    def label() Str
}

interface Metadata {
    def category() Str = "metadata"
}

annotation Route with Metadata {
    path Str
    method Str = "GET"
}

shape NamedShape with Labeled {
    name Str

    def label() Str = this.name
}


type Status =
    object Ready {}
    | class Failed { reason Str }

ext Status {
    def label() Str = match this {
        case Ready => "ready"
        case Failed { reason } => reason
    }
}


object Greeter with Labeled {

    def label() Str = this.hello()

    def hello() Str = "hi"
}


def main() Unit {
    named NamedShape = NamedShape { name: "shape-value" }
    namedLabel Labeled = named
    println("shape", namedLabel.label())

    status Status = Status.Ready
    println("enum", status.label())

    greeterLabel Labeled = Greeter
    println("object", greeterLabel.label())

    a = Greeter
    println("ref", a.hello())

    routeType = typeOf[Route]
    println("annotation", routeType.kind())
}

# EXPECT:
# 4 6
# -4
# 5
# 3

class Vec {
    hidden var items Array[Int]

    new(left Int, right Int) {
        this.items = Array(left, right)
    }

    [](index Int) Int = this.items[index]
    +(other Vec) Vec = Vec(this[0] + other[0], this[1] + other[1])
    -() Vec = Vec(-this[0], -this[1])
}


main() Unit {
    left Vec = Vec(1, 2)
    right Vec = Vec(3, 4)
    total Vec = left + right
    neg Vec = -total

    println(total[0], total[1])
    println(neg[0])

    items = [1, 2]
    items.add(3)
    items.addAll([4, 5])
    println(items[4])

    seen = Set(1, 2)
    seen.add(3)
    println(seen.size())
}

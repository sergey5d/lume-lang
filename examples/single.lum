# EXPECT:
# value 2
# test 7
# b1 5
# b2 1
# 0

class B {
    size Int
}

single A {
    var count Int = 2
}

impl single A {
    # explicit factory method
    def create(sizeValue Int) B = B { size: sizeValue }

    # explicit factory method
    def create(str Str) B = B { size: 1 }

    def value() Int = this.count

    def test(a Int) Int {
        return a + this.value()
    }
}

def main() Int {

    b1 B = A.create(5)
    b2 B = A.create("string of strings")

    println("value", A.value())
    println("test", A.test(5))
    println("b1", b1.size)
    println("b2", b2.size)
    0
}

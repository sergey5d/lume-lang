# EXPECT:
# Ada 42 Tampa
# Bob 43 Tampa
# 1 2 4
# 3 2 4

def main() Unit {
    base = { name: "Ada", age: 10 }
    aged = base with { age: 42 }
    updated = { ...aged, city: "Tampa" }
    println(updated.name, updated.age, updated.city)

    renamed = updated with { name: "Bob", age: 43 }
    println(renamed.name, renamed.age, renamed.city)

    point = { x: 1, y: 2 }
    dot = { x: 3, time: 4 }
    selected = {
        ...point
        ...dot
        x: point.x
    }
    overridden = {
        ...point
        override ...dot
    }
    println(selected.x, selected.y, selected.time)
    println(overridden.x, overridden.y, overridden.time)
}

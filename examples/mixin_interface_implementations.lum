# EXPECT:
# override class
# conflict first

interface Greeter {
    fn greet() Str
}

mixin Greeting with Greeter {
    fn greet() Str = "interface"
}

class OverrideBox with Greeter {
    use Greeting

    fn greet() Str = "class"
}

interface FirstChoice {
    fn choose() Str
}

interface SecondChoice {
    fn choose() Str
}

mixin FirstImplementation with FirstChoice {
    fn choose() Str = "first"
}

mixin SecondImplementation with SecondChoice {
    fn choose() Str = "second"
}

class PreferFirst with FirstChoice, SecondChoice {
    use FirstImplementation
    use SecondImplementation

    fn choose() Str = "first"
}

fn main() Unit {
    greeter Greeter = OverrideBox {}
    prefer = PreferFirst {}

    println("override", greeter.greet())
    println("conflict", prefer.choose())
}

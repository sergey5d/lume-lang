# EXPECT:
# value 2
# test 7
# b1 5
# b2 1
# 0

class B {
    size Int
}

object A {
    var count Int = 2

    # explicit factory method
    def create(sizeValue Int) B = B { size = sizeValue }

    # explicit factory method
    def create(str Str) B = B { size = 1 }

    def value() Int = this.count

    def test(a Int) Int {
        return a + this.value()
    }
}

def main() Int {

    b1 B = A.create(5)
    b2 B = A.create("string of strings")

    OS.println("value", A.value())
    OS.println("test", A.test(5))
    OS.println("b1", b1.size)
    OS.println("b2", b2.size)
    0
}

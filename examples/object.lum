# EXPECT:
# value 2
# test 7
# b1 5
# b2 1
# 0

class B {
    size Int
}

object A {
    var count Int = 2

    fn value() Int = this.count

    fn create(sizeValue Int) B = B { size: sizeValue }
    fn create(str Str) B = B { size: 1 }

    fn test(a Int) Int = {
        return a + this.value()
    }
}


fn main() Int = {
    b1 B = A.create(5)
    b2 B = A.create("string of strings")

    println("value", A.value())
    println("test", A.test(5))
    println("b1", b1.size)
    println("b2", b2.size)
    0
}

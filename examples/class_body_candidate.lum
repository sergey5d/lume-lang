# SKIP
#
# Class declaration with storage, constructors, and behavior in one body.

private class Person with Named, Aged {

    firstName Str
    lastName Str
    age Int
    city Str

    private var archived Bool
    var internalScore Int = 1

    new(firstName Str, lastName Str) {
        this.firstName = firstName
        this.lastName = lastName
        this.age = 18
        this.city = "unknown"
        this.archived = false
    }

    private fn calc() Int {
        this.firstName.size + this.lastName.size
    }

    fn fullName() Str = this.firstName + " " + this.lastName

    fn isAdult() Bool = this.age >= 18

    fn moveTo(newCity Str) Unit {
        this.city := newCity
    }

    fn celebrateBirthday() Unit {
        this.age += 1
        this.internalScore += 10
    }

    fn archive() Unit {
        this.archived := true
    }

    fn debugLabel() Str =
        fullName() + "@" + this.city + ":" + this.age + ":" + this.internalScore + ":" + this.archived
}

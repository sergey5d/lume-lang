# EXPECT:
# red
# palette

type Color =
    object Red {}
    | object Blue {}

ext Color {
    def label() Str = match this {
        case Color.Red => "red"
        case Color.Blue => "blue"
    }
}

object Color {

    def palette() Str = "palette"
}


def main() Unit {
    color Color = Color.Red
    println(color.label())
    println(Color.palette())
}

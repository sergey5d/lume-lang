# EXPECT:
# red
# palette

type Color =
    object Red {}
    | object Blue {}

ext Color {
    fn label() Str = match this {
        case Color.Red => "red"
        case Color.Blue => "blue"
    }
}

object Color {

    fn palette() Str = "palette"
}


fn main() Unit {
    color Color = Color.Red
    println(color.label())
    println(Color.palette())
}

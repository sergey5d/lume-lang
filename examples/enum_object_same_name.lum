# EXPECT:
# red
# palette

enum Color {
    case Red
    case Blue

    label() Str = match this {
        case Color.Red => "red"
        case Color.Blue => "blue"
    }
}

object Color {
}

impl object Color {
    palette() Str = "palette"
}

main() Unit {
    color Color = Color.Red
    println(color.label())
    println(Color.palette())
}

# EXPECT:
# left: bad
# right: num 7
# left
# right

enum Outcome {
    tag Str

    case Left {
        value Str
        tag = "left"
    }

    case Right {
        value Int
        tag = "right"
    }

    describe() Str = match this {
        case Left(value) => "left: " + value
        case Right(value) => "right: num " + value
    }
}


main() Unit {
    left Outcome = Outcome.Left("bad")
    right Outcome = Outcome.Right(7)

    println(left.describe())
    println(right.describe())
    println(left.tag)
    println(right.tag)
}

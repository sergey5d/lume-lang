# EXPECT:
# left: bad
# right: num 7
# left
# right

type Outcome =
    class Left {
        value Str
        tag Str = "left"
    }
    | class Right {
        value Int
        tag Str = "right"
    }

ext Outcome {
    def describe() Str = match this {
        case Left { value } => "left: " + value
        case Right { value } => "right: num " + value
    }

    def tag() Str = match this {
        case Left { tag } => tag
        case Right { tag } => tag
    }
}


def main() Unit {
    left Outcome = Outcome.Left("bad")
    right Outcome = Outcome.Right(7)

    println(left.describe())
    println(right.describe())
    println(left.tag())
    println(right.tag())
}

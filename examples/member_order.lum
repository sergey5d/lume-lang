# EXPECT:
# Ada
# 4
# 6
# 8

class User {
    fn label() Str = this.name

    new(name Str) {
        this.name = name
    }

    name Str
}

shape Counter {
    fn doubled() Int = this.value * 2

    value Int
}

interface Doubled {
    fn doubled() Int
}

objectValue = object {
    fn doubled() Int = this.value * 2

    value Int = 3
}

objIfaceValue = object with Doubled {
    fn doubled() Int = this.value * 2

    value Int = 4
}

fn main() Unit {
    println(User("Ada").label())
    println(Counter(2).doubled())
    println(objectValue.doubled())
    println(objIfaceValue.doubled())
}

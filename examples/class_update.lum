# EXPECT:
# original 10 x
# updated 42 x

class Amount {
    amount Int
    description Str
}

main() Unit {
    value = Amount(10, "x")
    updated = value :< { amount: 42 }

    println("original " + value.amount + " " + value.description)
    println("updated " + updated.amount + " " + updated.description)
}

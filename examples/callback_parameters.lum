# EXPECT:
# 3
# 2
# 3
# 2

class Counter {
    private var value Int = 0

    def next() Int {
        this.value := this.value + 1
        this.value
    }

    def reset() =
        this.value := 0

    def current() Int =
        this.value
}


def twice(value fn() Int) Int =
    value() + value()

def inner(value fn() Int) Int =
    value()

def outer(value fn() Int) Int =
    inner(value) + inner(value)

def cachedOnce(value fn() Int) Int {
    cached Int = value()
    cached + cached
}

def main() {
    counter Counter = Counter()

    println(twice { => counter.next() })
    println(counter.current())

    counter.reset()
    println(outer { => counter.next() })

    counter.reset()
    println(cachedOnce { => counter.next() })
}

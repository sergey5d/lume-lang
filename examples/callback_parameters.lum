# EXPECT:
# 3
# 2
# 3
# 2

class Counter {
    private var value Int = 0

    fn next() Int {
        this.value := this.value + 1
        this.value
    }

    fn reset() =
        this.value := 0

    fn current() Int =
        this.value
}


fn twice(value fn() Int) Int =
    value() + value()

fn inner(value fn() Int) Int =
    value()

fn outer(value fn() Int) Int =
    inner(value) + inner(value)

fn cachedOnce(value fn() Int) Int {
    cached Int = value()
    cached + cached
}

fn main() {
    counter Counter = Counter()

    println(twice { => counter.next() })
    println(counter.current())

    counter.reset()
    println(outer { => counter.next() })

    counter.reset()
    println(cachedOnce { => counter.next() })
}

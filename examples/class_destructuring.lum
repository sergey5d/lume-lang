# EXPECT:
# class 9 boxed
# class inferred 12 class
# class mixed 13 typed
# class pair 24 class-pair
# class skip only class-only
# class skip 16 class-skip
# hidden named Sergey Tampa
# for named plain Sergey Tampa
# for named plain Ada London
# named Sergey Tampa
# for named Sergey Tampa
# for named Ada London
# named same Sergey
# named alias Tampa Sergey
# partial Sergey
# 0

class Box {
    value Int
    label Str
}

class Crate {
    value Int
    spare Str
    label Str
}

class User {
    name Str
    location Str
    age Int
}

class SecretUser {
    name Str
    hidden token Str
    location Str
}

impl SecretUser {
    new {
        name Str
        token Str
        location Str
    } {
        this.name = name
        this.token = token
        this.location = location
    }
}

def main() Int {
    let { value Int as e, label Str as f } = Box(9, "boxed")
    println("class", e, f)

    let { value as inferredClassLeft, label as inferredClassRight } = Box(12, "class")
    println("class inferred", inferredClassLeft, inferredClassRight)

    let { value Int as mixedClassLeft, label as mixedClassRight } = Box(13, "typed")
    println("class mixed", mixedClassLeft, mixedClassRight)

    let { value as classPairLeft, label as classPairRight } = Box(24, "class-pair")
    println("class pair", classPairLeft, classPairRight)

    let { label as skippedOnlyClassValue } = Box(25, "class-only")
    println("class skip only", skippedOnlyClassValue)

    let { value Int as skippedClassLeft, label Str as skippedClassRight } = Crate(16, "drop", "class-skip")
    println("class skip", skippedClassLeft, skippedClassRight)

    let { name as publicName, location as publicLocation } = SecretUser("Sergey", "secret", "Tampa")
    println("hidden named", publicName, publicLocation)

    users = List(
        SecretUser("Sergey", "secret-1", "Tampa"),
        SecretUser("Ada", "secret-2", "London"),
    )
    for user <- users {
        let { name as userName, location as userLocation } = user
        println("for named plain", userName, userLocation)
    }

    user User = User { name: "Sergey", location: "Tampa", age: 37 }

    let { name, location } = user
    println("named", name, location)

    for loopUser <- users {
        let { location as loc, name as loopName } = loopUser
        println("for named", loopName, loc)
    }

    let { name as nameAgain } = user
    println("named same", nameAgain)

    let { location as loc, name as nam } = user
    println("named alias", loc, nam)

    let { name as userName } = user
    println("partial", userName)

    0
}

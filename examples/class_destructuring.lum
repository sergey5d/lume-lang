# EXPECT:
# class 9 boxed
# class inferred 12 class
# class mixed 13 typed
# class pair 24 class-pair
# class skip only class-only
# class skip 16 class-skip
# named Sergey Tampa
# named same Sergey
# named alias Tampa Sergey
# named skip Sergey
# 0

class Box {
    value Int
    label Str
}

class Crate {
    value Int
    spare Str
    label Str
}

class User {
    name Str
    location Str
    age Int
}

def main() Int {
    let { e Int, f Str } = Box { 9, "boxed" }
    OS.println("class", e, f)

    let { inferredClassLeft, inferredClassRight } = Box { 12, "class" }
    OS.println("class inferred", inferredClassLeft, inferredClassRight)

    let { mixedClassLeft Int, mixedClassRight } = Box { 13, "typed" }
    OS.println("class mixed", mixedClassLeft, mixedClassRight)

    let { classPairLeft, classPairRight } = Box { 24, "class-pair" }
    OS.println("class pair", classPairLeft, classPairRight)

    let { _, skippedOnlyClassValue } = Box { 25, "class-only" }
    OS.println("class skip only", skippedOnlyClassValue)

    let { skippedClassLeft Int, _, skippedClassRight Str } = Crate { 16, "drop", "class-skip" }
    OS.println("class skip", skippedClassLeft, skippedClassRight)

    user User = User { name = "Sergey", location = "Tampa", age = 37 }

    let { name @name, @location } = user
    OS.println("named", name, location)

    let { nameAgain @name } = user
    OS.println("named same", nameAgain)

    let { loc @location, nam @name } = user
    OS.println("named alias", loc, nam)

    let { _ @location, userName @name } = user
    OS.println("named skip", userName)

    0
}

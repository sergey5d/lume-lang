# EXPECT:
# 1
# 2
# 3
# 4
# 0

main() Int {
    explicit Vector[Int] = Vector(1, 2, 3)
    shorthand [Int] = explicit
    explicitAgain Vector[Int] = shorthand

    for value <- explicitAgain {
        println(value)
    }

    literalAsExplicit Vector[Int] = [4]
    println(literalAsExplicit[0])

    0
}

# EXPECT:
# class 7 world
# class inferred 10 infer
# class mixed 11 partial
# class pair 22 record-pair
# class skip only visible
# class skip 15 kept
# 0

class Pair {
    left Int
    right Str
}

class Triple {
    first Int
    middle Str
    last Str
}

def main() Int {
    let (c Int, d Str) = Pair(7, "world")
    OS.println("class", c, d)

    let (inferredRecordLeft, inferredRecordRight) = Pair(10, "infer")
    OS.println("class inferred", inferredRecordLeft, inferredRecordRight)

    let (mixedRecordLeft Int, mixedRecordRight) = Pair(11, "partial")
    OS.println("class mixed", mixedRecordLeft, mixedRecordRight)

    let (recordPairLeft, recordPairRight) = Pair(22, "record-pair")
    OS.println("class pair", recordPairLeft, recordPairRight)

    let (_, skippedOnlyRecordValue) = Pair(23, "visible")
    OS.println("class skip only", skippedOnlyRecordValue)

    let (skippedRecordLeft Int, _, skippedRecordRight Str) = Triple(15, "drop", "kept")
    OS.println("class skip", skippedRecordLeft, skippedRecordRight)

    0
}

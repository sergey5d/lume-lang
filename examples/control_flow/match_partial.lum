# EXPECT:
# 8
# 10
# 2
# 0
# 2
# true
# 4

enum MaybeInt {
    case NoneX
    case SomeX {
        value Int
    }
}

def main() Unit {
    values = List(1, 6, 3)
    ifMapped = values.map(value -> if value > 5 { 10 } else { 8 })

    options = List(MaybeInt.SomeX(1), MaybeInt.NoneX, MaybeInt.SomeX(3))
    matchMapped = options.map(value -> match value {
        case SomeX(x) => x + 1
        case NoneX => 0
    })
    partialMapped List[Option[Int]] = options.map(value -> partial match value {
        case SomeX(x) => x + 1
    })

    println(ifMapped.get(0).getOr(0))
    println(ifMapped.get(1).getOr(0))
    println(matchMapped.get(0).getOr(0))
    println(matchMapped.get(1).getOr(0))
    let Some(firstPartial) = partialMapped.get(0) else return ()
    let Some(secondPartial) = partialMapped.get(1) else return ()
    println(firstPartial.getOr(0))
    println(secondPartial.isEmpty())

    var partialStmt = 0
    partial match MaybeInt.SomeX(4) {
        case SomeX(x) => partialStmt += x
    }
    partial match MaybeInt.NoneX {
        case SomeX(x) => partialStmt += x
    }
    println(partialStmt)
}

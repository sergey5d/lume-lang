# EXPECT:
# vector at 1
# vector previous 1
# vector removed 3
# vector error 9 2
# vector unsafe 2
# array at 5
# array previous 5
# array error -1 2
# array unsafe 6
# linked at 9
# linked previous 7
# linked removed 9
# linked error 3 2
# linked first 8

main() Unit {
    vector [Int] = [1, 3]
    println("vector at " + (vector.at(0) !!))
    println("vector previous " + (vector.setAt(0, 2) !!))
    inserted Unit = vector.insertAt(1, 5) !!
    println("vector removed " + (vector.removeAt(2) !!))
    let Err(vectorError) = vector.removeAt(9) else return ()
    println("vector error " + vectorError.index + " " + vectorError.size)
    println("vector unsafe " + vector[0])

    array Array[Int] = Array(4, 5)
    println("array at " + (array.at(1) !!))
    println("array previous " + (array.setAt(1, 6) !!))
    let Err(arrayError) = array.setAt(-1, 0) else return ()
    println("array error " + arrayError.index + " " + arrayError.size)
    println("array unsafe " + array[1])

    linked LinkedList[Int] = LinkedList(7, 9)
    println("linked at " + (linked.at(1) !!))
    println("linked previous " + (linked.setAt(0, 8) !!))
    linkedInserted Unit = linked.insertAt(1, 10) !!
    println("linked removed " + (linked.removeAt(2) !!))
    let Err(linkedError) = linked.removeAt(3) else return ()
    println("linked error " + linkedError.index + " " + linkedError.size)
    println("linked first " + (linked.at(0) !!))
}

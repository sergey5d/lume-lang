# EXPECT:
# box 3
# box2 7
# single Hello 2
# 0

class CounterBox {
    hidden count = 1
    hidden var hits = 0
}

impl CounterBox {
    def bump() Unit {
        this.hits += this.count
    }

    def total() Int = this.hits
}

single Greeter {
    hidden hello = "Hello"
}

impl single Greeter {
    def greet(times Int) Str = this.hello + " " + times
}

def main() Int {
    box = CounterBox {}
    box.bump()
    box.bump()
    box.bump()
    println("box " + box.total())

    box2 = CounterBox {}
    box2.bump()
    box2.bump()
    box2.bump()
    box2.bump()
    box2.bump()
    box2.bump()
    box2.bump()
    println("box2 " + box2.total())

    println("single " + Greeter.greet(2))
    0
}

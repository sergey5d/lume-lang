# EXPECT:
# box 3
# box2 7
# object Hello 2
# 0

class CounterBox {
    hidden count = 1
    hidden var hits = 0

    bump() Unit {
        this.hits += this.count
    }

    total() Int = this.hits
}


object Greeter {
    hidden hello = "Hello"

    greet(times Int) Str = this.hello + " " + times
}


main() Int {
    box = CounterBox {}
    box.bump()
    box.bump()
    box.bump()
    println("box " + box.total())

    box2 = CounterBox {}
    box2.bump()
    box2.bump()
    box2.bump()
    box2.bump()
    box2.bump()
    box2.bump()
    box2.bump()
    println("box2 " + box2.total())

    println("object " + Greeter.greet(2))
    0
}

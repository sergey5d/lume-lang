# EXPECT:
# 7
# true
# 3
# 0

class ComparableInt with Comparable[ComparableInt] {
    value Int

    fn compareTo(other ComparableInt) Int = value.compareTo(other.value)
}


class Box[T with Comparable[T]] {
    value T
}

class Mapper {

    fn pick[X with Comparable[X]](value X) X = value
}


fn pick[T with Comparable[T]](value T) T = value

fn useBox(value Box[ComparableInt]) Int = value.value.value

fn main() Int {
    mapper Mapper = Mapper {}
    left = ComparableInt { value: 3 }
    right = ComparableInt { value: 4 }
    println(pick(left).value + mapper.pick(right).value)
    println(left < right)
    values = [right, left]
    values.sort()
    println(values[0].value)
    0
}

class OrderedInt with Ordering[OrderedInt] {
    value Int

    compare(left OrderedInt, right OrderedInt) Int = left.value - right.value
}


class Box[T with Ordering[T]] {
    value T
}

class Mapper {

    pick[X with Ordering[X]](value X) X = value
}


pick[T with Ordering[T]](value T) T = value

useBox(value Box[OrderedInt]) Int = value.value.value

main() Int {
    mapper Mapper = Mapper {}
    left = OrderedInt { value: 3 }
    right = OrderedInt { value: 4 }
    println(pick(left).value + mapper.pick(right).value)
    0
}

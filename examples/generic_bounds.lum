# EXPECT:
# 7
# true
# 3
# 0

class OrderedInt with Ordered[OrderedInt] {
    value Int

    def compare(other OrderedInt) Int = value - other.value
}


class Box[T with Ordered[T]] {
    value T
}

class Mapper {

    def pick[X with Ordered[X]](value X) X = value
}


def pick[T with Ordered[T]](value T) T = value

def useBox(value Box[OrderedInt]) Int = value.value.value

def main() Int {
    mapper Mapper = Mapper {}
    left = OrderedInt { value: 3 }
    right = OrderedInt { value: 4 }
    println(pick(left).value + mapper.pick(right).value)
    println(left < right)
    values = [right, left]
    values.sort()
    println(values[0].value)
    0
}

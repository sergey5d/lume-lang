# EXPECT:
# asc 1 2 3 4
# desc 4 3 2 1
# 0

def main() Int {
    asc [Int] = [3, 1, 4, 2]
    asc.sort((left, right) => left - right)
    println("asc " + (asc.at(0) ?? 0) + " " + (asc.at(1) ?? 0) + " " + (asc.at(2) ?? 0) + " " + (asc.at(3) ?? 0))

    desc [Int] = [3, 1, 4, 2]
    desc.sort((left, right) => right - left)
    println("desc " + (desc.at(0) ?? 0) + " " + (desc.at(1) ?? 0) + " " + (desc.at(2) ?? 0) + " " + (desc.at(3) ?? 0))

    0
}

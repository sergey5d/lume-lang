# EXPECT:
# ok

annotation Tag {
    name Str = "default"
}

annotation Route {
    path Str
    method Str = "GET"
}

enum RouteVisibility {
    case External
    case Internal
}

annotation Metadata {
    text Str
    code Int
    enabled Bool
    disabled Bool
    visibility RouteVisibility
    joinedPath Str
    total Int
    tags [Str]
    nested { name Str, value Int }
}

routePath Str = "/health"

single Routes {
    health Str = "/health"
}

single LocalRoutes {
    status Str = "/status"
}

single AnnotationConstants {
    label Str = "from-single"
}

@Metadata {
    text: "literal",
    code: 123,
    enabled: true,
    disabled: false,
    visibility: RouteVisibility.External,
    joinedPath: "/api" + "/health",
    total: 1 + 2,
    tags: ["a", "b"],
    nested: { name: AnnotationConstants.label, value: 1 }
}
@Tag { name: "service" }
class Service {
    @Tag { name: "field" }
    name Str
}

impl Service {
    @Route { path: routePath }
    new {
    } {
        this.name = "ok"
    }

    @Route { path: Routes.health }
    @Tag { name: "health" }
    def health() Str = this.name

    @Route { path: LocalRoutes.status, method: "POST" }
    def status() Str = "status"
}

def main() Unit {
    serviceType Type[Service] = typeOf[Service]
    hasMetadata Bool = serviceType.hasAnnotation[Metadata]()
    metadata Option[AnnotationValue] = serviceType.annotation[Metadata]()
    println(Service {}.health())
}

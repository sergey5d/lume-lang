# EXPECT:
# ok

annotation Tag {
    name Str = "default"
}

annotation Route {
    path Str
}

routePath Str = "/health"

single Routes {
    health Str = "/health"
}

@Tag { name: "service" }
class Service {
    @Tag { name: "field" }
    name Str
}

impl Service {
    @Route { path: routePath }
    new {
    } {
        this.name = "ok"
    }

    @Route { path: Routes.health }
    @Tag { name: "health" }
    def health() Str = this.name
}

def main() Unit {
    println(Service {}.health())
}

# EXPECT:
# function tags alpha 3 alpha joined alpha beta gamma
# function empty empty 0 none
# method task:build|2|fast,local
# ctor positional bin 3 usr/local/bin
# ctor named config 2 etc/hosts
# ctor default tmp 1 default

def joinWords(separator Str, words [Str] vararg) Str {
    var result = ""
    var first = true
    for word <- words {
        if first {
            result := word
            first := false
        } else {
            result := result + separator + word
        }
    }
    result
}

def describeTags(label Str, tags [Str] vararg) Str {
    first = tags.get(0).getOr("none")
    label + " " + tags.size() + " " + first
}

class Reporter {
    prefix Str
}

impl Reporter {
    new {
        prefix Str
    } {
        this.prefix = prefix
    }

    def line(name Str, tags [Str] vararg) Str {
        this.prefix + ":" + name + "|" + tags.size() + "|" + joinWords(separator = ",", words = tags)
    }
}

class Path {
    label Str
    segments [Str]
}

impl Path {
    new {
        label Str
        segments [Str] vararg = ["default"]
    } {
        this.label = label
        this.segments = segments
    }

    def render() Str = this.label + " " + this.segments.size() + " " + joinWords(separator = "/", words = this.segments)
}

def main() Unit {
    println("function tags", describeTags("alpha", "alpha", "beta", "gamma"), "joined", joinWords(" ", "alpha", "beta", "gamma"))
    println("function empty", describeTags("empty"))

    reporter = Reporter("task")
    println("method", reporter.line("build", "fast", "local"))

    positional = Path("bin", "usr", "local", "bin")
    named = Path { label: "config", segments: ["etc", "hosts"] }
    defaulted = Path("tmp")
    println("ctor positional", positional.render())
    println("ctor named", named.render())
    println("ctor default", defaulted.render())
}

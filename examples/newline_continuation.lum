# EXPECT:
# sum 3
# grouped 14
# size 4
# leading size 4
# match 20
# def 7
# split 5
# split def 5
# if 11
# for 5
# match stmt 9
# update Ada 42
# merge Ada Tampa
# total 80

def helper() Int =
    3 +
        4

def splitValue() Int =
    5

def main() Unit {
    split =
        5

    sum Int = 1 +
        2

    grouped Int = (
        3 +
        4
    ) *
        2

    items [Int] = [
        1,
        2,
        3
    ]

    size Int = "haha".
        size()

    leadingSize Int = "haha"
        .size()

    matched Int = match 2 {
        case 1 =>
            10
        case 2 =>
            20
        case _ =>
            0
    }

    fromIf Int = if true { 11 } else { 0 }

    collected = for item <- [2, 3] yield item

    fromFor Int = collected.at(0).getOr(0) +
        collected.at(1).getOr(0)

    var fromMatchStmt = 0
    match 2 {
        case 1 => {
            fromMatchStmt := 1
        }
    }

    match 3 {
        case 3 => {
            fromMatchStmt := 9
        }
    }

    user = { name: "Ada", age: 41 }
    updated = user :<
        { age: 42 }

    named = { name: "Ada" }
    located = { location: "Tampa" }
    merged = {
        ...named
        ...located
    }

    helperValue Int = helper()

    total Int = sum +
        grouped +
        items.size() +
        size +
        leadingSize +
        matched +
        helperValue +
        fromIf +
        fromFor +
        fromMatchStmt

    println("sum", sum)
    println("grouped", grouped)
    println("size", size)
    println("leading size", leadingSize)
    println("match", matched)
    println("def", helperValue)
    println("split", split)
    println("split def", splitValue())
    println("if", fromIf)
    println("for", fromFor)
    println("match stmt", fromMatchStmt)
    println("update", updated.name, updated.age)
    println("merge", merged.name, merged.location)
    println("total", total)
}

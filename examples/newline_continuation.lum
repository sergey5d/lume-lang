# EXPECT:
# sum 3
# grouped 14
# size 4
# leading size 4
# match 20
# def 7
# split 5
# split def 5
# if 11
# for 5
# match stmt 9
# update Ada 42
# merge Ada Tampa
# mutation 2
# extract 9
# grouped extract 8
# conditional extract 4
# conditional chain 6
# for continuation 6
# for let continuation 5
# lambda continuation 8 9
# total 80

def helper() Int =
    3 +
        4

def splitValue() Int =
    5

def main() Unit {
    split =
        5

    sum Int = 1 +
        2

    grouped Int = (
        3 +
        4
    ) *
        2

    items [Int] = [
        1,
        2,
        3
    ]

    size Int = "haha".
        size

    leadingSize Int = "haha"
        .size

    matched Int = match 2 {
        case 1 =>
            10
        case 2 =>
            20
        case _ =>
            0
    }

    fromIf Int = if true { 11 } else { 0 }

    collected = for item <- [2, 3] yield item

    fromFor Int = (collected.at(0) ?? 0) +
        (collected.at(1) ?? 0)

    var fromMatchStmt = 0
    match 2 {
        case 1 => {
            fromMatchStmt := 1
        }
    }

    match 3 {
        case 3 => {
            fromMatchStmt := 9
        }
    }

    user = { name: "Ada", age: 41 }
    updated = user with
        { age: 42 }

    named = { name: "Ada" }
    located = { location: "Tampa" }
    merged = {
        ...named
        ...located
    }

    var mutation = 0
    mutation :=
        10
    mutation +=
        5
    mutation -=
        3
    mutation *=
        2
    mutation /=
        4
    mutation %=
        4

    let extracted <-
        Some(9)
    else return

    let {
        groupedExtracted <-
            Some(8)
    }
    else return

    var conditionalExtractedValue = 0
    if let conditionalExtracted <-
        Some(4) && conditionalExtracted > 0 {
        conditionalExtractedValue := conditionalExtracted
    }

    var conditionalChain = 0
    if true &&
        let chained <- Some(6) &&
        chained > 0 {
        conditionalChain := chained
    }

    var continuedFor = 0
    for value <-
        [1, 2, 3] {
        continuedFor +=
            value
    }

    var continuedForLet = 0
    for let (left, right) <-
        [(2, 3)] {
        continuedForLet +=
            left + right
    }

    lambdaContinuation = [7, 8].map {
        value => value + 1
    }

    helperValue Int = helper()

    total Int = sum +
        grouped +
        items.size +
        size +
        leadingSize +
        matched +
        helperValue +
        fromIf +
        fromFor +
        fromMatchStmt

    println("sum", sum)
    println("grouped", grouped)
    println("size", size)
    println("leading size", leadingSize)
    println("match", matched)
    println("def", helperValue)
    println("split", split)
    println("split def", splitValue())
    println("if", fromIf)
    println("for", fromFor)
    println("match stmt", fromMatchStmt)
    println("update", updated.name, updated.age)
    println("merge", merged.name, merged.location)
    println("mutation", mutation)
    println("extract", extracted)
    println("grouped extract", groupedExtracted)
    println("conditional extract", conditionalExtractedValue)
    println("conditional chain", conditionalChain)
    println("for continuation", continuedFor)
    println("for let continuation", continuedForLet)
    println("lambda continuation", lambdaContinuation[0], lambdaContinuation[1])
    println("total", total)
}

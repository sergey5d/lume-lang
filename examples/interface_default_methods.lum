# EXPECT:
# override class
# conflict first

interface Greeter {
    greet() Str = "interface"
}

class OverrideBox with Greeter {

    greet() Str = "class"
}


interface FirstChoice {
    choose() Str = "first"
}

interface SecondChoice {
    choose() Str = "second"
}

class PreferFirst with FirstChoice, SecondChoice {
}

main() Unit {
    greeter Greeter = OverrideBox {}
    prefer = PreferFirst {}

    println("override", greeter.greet())
    println("conflict", prefer.choose())
}

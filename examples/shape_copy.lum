# EXPECT:
# original 10 x
# updated 42 y
# updated2 43 z
# copied Ada 42
# equal true
# not equal true
# cleared 0
# reset 0 0

shape Amount {
    amount Int
    description Str
}

shape Profile {
    name Str
    age Int
}

shape Point {
    x Int
    y Int
}

shape Batch {
    items [Int]
    position Point
}

def main() Unit {
    value = Amount(10, "x")
    updated Amount = {
        ...value
        amount: 42
        description: "y"
    }
    patch = {
        amount: 43
        description: "z"
    }
    updated2 Amount = {
        ...value
        ...patch
        amount: patch.amount
        description: patch.description
    }

    profile = Profile("Sergey", 37)
    namePatch = { name: "Ada" }
    agePatch = { age: 42 }
    expected = Profile("Ada", 42)
    different = Profile("Ada", 41)
    copied Profile = {
        ...profile
        ...namePatch
        ...agePatch
        name: namePatch.name
        age: agePatch.age
    }

    println("original " + value.amount + " " + value.description)
    println("updated " + updated.amount + " " + updated.description)
    println("updated2 " + updated2.amount + " " + updated2.description)
    println("copied " + copied.name + " " + copied.age)
    println("equal " + (copied == expected))
    println("not equal " + (copied != different))

    batch = Batch([1, 2], Point(3, 4))
    cleared Batch = {
        ...batch
        items: []
        position: new(0, 0)
    }
    println("cleared " + cleared.items.size)
    println("reset " + cleared.position.x + " " + cleared.position.y)
}

# EXPECT:
# each 4
# each 5
# each 6
# index 4 6
# get 5 true
# first 4
# last 6
# mapped 8 12
# exists true
# forAll true
# zip 5 b
# zipIndex 6 2
# assigned 9 10
# defaults 0.0 false  1
# filled 7 7
# generated 0 4
# size 3

def main() Unit {
    values Array[Int] = Array(4, 5, 6)
    labels Array[Str] = Array("a", "b")

    mapped = values.map(item -> item * 2)
    hasBig = values.exists(item -> item > 5)
    allPositive = values.forAll(item -> item > 0)

    values.forEach(item -> println("each " + item))
    println("index " + values[0] + " " + values[2])

    guard Some(middle) = values.get(1) else return ()
    guard Some(first) = values.first() else return ()
    guard Some(last) = values.last() else return ()

    pairs = values.zip(labels)
    indexed = values.zipWithIndex()

    let (zippedValue, zippedLabel) = pairs[1]
    let (indexedValue, indexedPos) = indexed[2]

    assigned = Array.ofInt(2)
    assigned[0] := 9
    assigned[1] := 10
    defaultFloats = Array.ofFloat(1)
    defaultBools = Array.ofBool(1)
    defaultStrs = Array.ofStr(1)
    defaultRunes = Array.ofRune(1)
    filled = Array.fill(2, 7)
    generated = Array.generate(3, idx -> idx * 2)

    println("get " + middle + " " + values.get(9).isEmpty())
    println("first " + first)
    println("last " + last)
    println("mapped " + mapped[0] + " " + mapped[2])
    println("exists " + hasBig)
    println("forAll " + allPositive)
    println("zip " + zippedValue + " " + zippedLabel)
    println("zipIndex " + indexedValue + " " + indexedPos)
    println("assigned " + assigned[0] + " " + assigned[1])
    println("defaults " + defaultFloats[0] + " " + defaultBools[0] + " " + defaultStrs[0] + " " + defaultRunes.size())
    println("filled " + filled[0] + " " + filled[1])
    println("generated " + generated[0] + " " + generated[2])
    println("size " + values.size())
}

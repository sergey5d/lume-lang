# EXPECT:
# interface getters ok

module examples/interfacegetters

interface Identified[T] {
    get id T
}

interface Described[T] with Identified[T] {
    fn describe() Str
}

class FieldClass[T] with Described[T] {
    var id T

    fn describe() Str = "class field"
}

class ImmutableFieldClass[T] with Described[T] {
    id T

    fn describe() Str = "immutable class field"
}

class ComputedClass with Described[Int] {
    value Int

    get id Int = this.value + 1
    fn describe() Str = "class getter"
}

shape FieldShape with Described[Int] {
    id Int

    fn describe() Str = "shape field"
}

shape ComputedShape with Described[Int] {
    value Int

    get id Int = this.value + 1
    fn describe() Str = "shape getter"
}

object FieldObject with Described[Int] {
    id Int = 5

    fn describe() Str = "object field"
}

object MutableFieldObject with Described[Int] {
    var id Int = 10

    fn describe() Str = "mutable object field"
}

object ComputedObject with Described[Int] {
    private value Int = 5

    get id Int = this.value + 1
    fn describe() Str = "object getter"
}

fn verify(value Described[Int], expected Int) {
    assert(value.id == expected)
    assert(value.describe().nonEmpty)
}

fn main() {
    mutable = FieldClass(1)
    view Described[Int] = mutable
    verify(view, 1)
    mutable.id := 7
    verify(view, 7)
    verify(ImmutableFieldClass(11), 11)
    verify(ComputedClass(1), 2)
    verify(FieldShape(3), 3)
    verify(ComputedShape(3), 4)
    verify(FieldObject, 5)
    verify(ComputedObject, 6)
    objectView Described[Int] = MutableFieldObject
    verify(objectView, 10)
    MutableFieldObject.id := 12
    verify(objectView, 12)

    fieldObject Described[Int] = object with Described[Int] {
        id Int = 8

        fn describe() Str = "anonymous field"
    }
    computedObject Described[Int] = object with Described[Int] {
        get id Int = 9
        fn describe() Str = "anonymous getter"
    }
    verify(fieldObject, 8)
    verify(computedObject, 9)
    println("interface getters ok")
}

# EXPECT:
# kind box
# kind another box
# kind box #3

class KeywordBox {
    value Str
}

def main() Unit {
    box KeywordBox = KeywordBox { value: "box" }
    println("kind", box.value)
    anotherBox KeywordBox = KeywordBox("another box")
    println("kind", anotherBox.value)

    value = "box #3"
    box3 KeywordBox = KeywordBox { value }
    println("kind", box3.value)
}

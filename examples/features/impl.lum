# EXPECT:
# hello Ada

# `impl` is reserved for future generic specialization. Its body is currently
# required to be empty; all behavior belongs in the type declaration body.

class Greeter {
    name Str

    greet() Str =
        "hello " + this.name
}

impl Greeter {}

main() Unit {
    greeter Greeter = Greeter { name: "Ada" }
    println(greeter.greet())
}

# EXPECT:
# called
# called
# same 2

interface Callable {
    def call() Unit
}

class Action with Callable {
    def call() Unit = println("called")
}

def invoke[T with Callable](value T) Unit = value.call()

def same[L, R when L = R](left L, right R) L = right

class BoundContext[L, R] {

    def invokeOwner[when L with Callable](value L) Unit = value.call()

    def merge[when L = R](value R) L = value
}

def main() Unit {
    invoke(Action {})
    context BoundContext[Action, Action] = BoundContext {}
    context.invokeOwner(Action {})
    _ = context.merge(Action {})
    println("same", same(1, 2))
}

# EXPECT:
# called
# called
# same 2

interface Callable {
    fn call()
}

class Action with Callable {
    fn call() = println("called")
}

fn invoke[T with Callable](value T) = value.call()

fn same[L, R when L = R](left L, right R) L = right

class BoundContext[L, R] {

    fn invokeOwner[when L with Callable](value L) = value.call()

    fn merge[when L = R](value R) L = value
}

fn main() {
    invoke(Action {})
    context BoundContext[Action, Action] = BoundContext {}
    context.invokeOwner(Action {})
    _ = context.merge(Action {})
    println("same", same(1, 2))
}

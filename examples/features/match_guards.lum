# EXPECT:
# 12
# 10
# 0
# 1
# 1

type MaybeInt =
    class SomeX { value Int }
    | object NoneX {}

fn describe(value MaybeInt) Int =
    match value {
        case SomeX { value as x } if x > 10 => x
        case SomeX { value: _ } => 10
        case MaybeInt.NoneX => 0
    }

fn whenReady(value MaybeInt, ready Bool) Int =
    match value {
        case _ if ready => 1
        case _ => 0
    }

fn whenInt(value Any) Int =
    match value {
        case _ if value is Int => 1
        case _ => 0
    }

fn main() Unit {
    large MaybeInt = MaybeInt.SomeX(12)
    small MaybeInt = MaybeInt.SomeX(3)
    empty MaybeInt = MaybeInt.NoneX

    println(describe(large))
    println(describe(small))
    println(describe(empty))
    println(whenReady(empty, true))
    println(whenInt(42))
}

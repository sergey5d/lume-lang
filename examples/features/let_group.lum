# EXPECT:
# grouped guard 8
# grouped guard fail 9
# grouped if 15
# chained if let 8

def groupedGuard(value Option[Int]) Int {
    guard {
        Some(a) = value
        Some(b) = Some(a + 4)
    } else {
        return 9
    }
    return a + b
}

def groupedIf(value Option[Int]) Int {
    if let {
        Some(a) = value
        Some(b) = Some(a + 7)
    } {
        return a + b
    }
    return 0
}

def main() Unit {
    println("grouped guard ${groupedGuard(Some(2))}")
    println("grouped guard fail ${groupedGuard(None)}")
    println("grouped if ${groupedIf(Some(4))}")
    if let Some(a) = Some(3) && let Ok(b) = Ok(5) && b == 5 {
        println("chained if let ${a + b}")
    }
}

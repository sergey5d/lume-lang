# EXPECT:
# partial value 5
# partial missing true
# partial statement 4

type MaybeInt =
    class SomeX { value Int }
    | object NoneX {}

def partialValue(value MaybeInt) Int? =
    partial match value {
        case SomeX { value as item } => item
    }

def main() Unit {
    value = partialValue(MaybeInt.SomeX(5))
    missing = partialValue(MaybeInt.NoneX)

    let item <- value else panic("expected partial value")
    println("partial value", item)
    println("partial missing", missing.isEmpty())

    var partialStmt = 0
    partial match MaybeInt.SomeX(4) {
        case SomeX { value as next } => partialStmt += next
    }
    partial match MaybeInt.NoneX {
        case SomeX { value as next } => partialStmt += next
    }
    println("partial statement", partialStmt)
}

# EXPECT:
# let else option 6
# let else option missing
# let else group 9
# let else group missing

plusOne(value Option[Int]) Result[Int, Str] {
    let Some(item) = value else return Err("missing")
    Ok(item + 1)
}

sumBoth(left Option[Int], right Option[Int]) Result[Int, Str] {
    let {
        Some(a) = left
        Some(b) = right
    } else return Err("missing")
    Ok(a + b)
}

printResult(label Str, value Result[Int, Str]) Unit {
    match value {
        case Ok(item) => println(label + " " + item)
        case Err(error) => println(label + " " + error)
    }
}

main() Unit {
    printResult("let else option", plusOne(Some(5)))
    printResult("let else option", plusOne(None))
    printResult("let else group", sumBoth(Some(4), Some(5)))
    printResult("let else group", sumBoth(Some(4), None))
}

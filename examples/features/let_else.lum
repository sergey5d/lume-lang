# EXPECT:
# let else option 6
# let else option missing
# let else group 9
# let else group missing

fn plusOne(value Int?) Result[Int, Str] {
    let Some { value as item } = value else return Err("missing")
    Ok(item + 1)
}

fn sumBoth(left Int?, right Int?) Result[Int, Str] {
    let {
        Some { value as a } = left
        Some { value as b } = right
    } else return Err("missing")
    Ok(a + b)
}

fn printResult(label Str, value Result[Int, Str]) Unit {
    match value {
        case Ok { value as item } => println(label + " " + item)
        case Err { error } => println(label + " " + error)
    }
}

fn main() Unit {
    printResult("let else option", plusOne(Some(5)))
    printResult("let else option", plusOne(None))
    printResult("let else group", sumBoth(Some(4), Some(5)))
    printResult("let else group", sumBoth(Some(4), None))
}

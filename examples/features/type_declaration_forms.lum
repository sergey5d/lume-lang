# EXPECT:
# class Ada
# shape 8
# object settings
# annotation ok

interface C {
    def label() Str
}

class A with C {
    value Str

    def label() Str = this.value
}

shape B {
    value Int

    def doubled() Int = this.value * 2
}

annotation D {
    value Str
}

object E with C {
    value Str = "settings"

    def label() Str = this.value
}

@D { value: "example" }
class Marked {
}

def main() Unit {
    a A = A { value: "Ada" }
    b B = B { value: 4 }
    marked Marked = Marked {}

    println("class", a.label())
    println("shape", b.doubled())
    println("object", E.label())
    println("annotation ok")
}

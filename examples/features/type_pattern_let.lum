# EXPECT:
# if-let binding true
# if-let wildcard true
# guard binding true
# guard wildcard true
# 0

interface CounterPrecursor {
}

class Counter with CounterPrecursor {
}

def run(value CounterPrecursor) Int {
    if let counter Counter = value {
        println("if-let binding " + (counter is Counter))
    }

    if let _ Counter = value {
        println("if-let wildcard true")
    }

    guard counter Counter = value else {
        return 1
    }
    println("guard binding " + (counter is Counter))

    guard _ Counter = value else {
        return 2
    }
    println("guard wildcard true")

    0
}

def main() Int = run(Counter {})

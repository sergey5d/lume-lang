# EXPECT:
# if-let binding true
# if-let wildcard true
# let-else binding true
# let-else wildcard true
# 0

interface CounterPrecursor {
}

class Counter with CounterPrecursor {
}

run(value CounterPrecursor) Int {
    if let counter Counter = value {
        println("if-let binding " + (counter is Counter))
    }

    if let _ Counter = value {
        println("if-let wildcard true")
    }

    let counter Counter = value else {
        return 1
    }
    println("let-else binding " + (counter is Counter))

    let _ Counter = value else {
        return 2
    }
    println("let-else wildcard true")

    0
}

main() Int = run(Counter {})

# EXPECT:
# worker 7
# other 3
# slacker -1
# 0

interface WorkerLike {
    def doWork() Int
}

class Worker with WorkerLike {

    def doWork() Int = 7
}


class Other with WorkerLike {

    def doWork() Int = 3
}


class Slacker with WorkerLike {

    def doWork() Int = -1
}


def describe(value WorkerLike) {
    match value {
        case worker Worker => {
            println("worker " + worker.doWork())
        }
        case other Other => {
            println("other " + other.doWork())
        }
        case _ Slacker =>
            println("slacker " + value.doWork())
        case _ => {
            println("unknown")
        }
    }
}

def main() Int {
    describe(Worker {})
    describe(Other {})
    describe(Slacker {})
    0
}

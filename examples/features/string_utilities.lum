# EXPECT:
# string utilities ok

module examples/string_utilities

fn main() {
    blank Bool = " \t\r\n".isBlank
    assert(blank)
    assert("".isBlank)
    assert(!" a ".isBlank)
    assert(" ".isBlank) # U+00A0, non-breaking space
    assert("　".isBlank) # U+3000, ideographic space
    assert(!"​".isBlank) # U+200B, zero-width space is not whitespace

    lines [Str] = "first\r\n\r\nthird\rfourth\n".lines()
    assert(lines.size == 4)
    assert(lines[0] == "first")
    assert(lines[1] == "")
    assert(lines[2] == "third")
    assert(lines[3] == "fourth")
    assert("".lines().isEmpty)
    single = "single".lines()
    assert(single.size == 1 && single[0] == "single")
    emptyLine = "\n".lines()
    assert(emptyLine.size == 1 && emptyLine[0] == "")
    trailingEmpty = "a\n\n".lines()
    assert(trailingEmpty.size == 2 && trailingEmpty[0] == "a" && trailingEmpty[1] == "")
    unicode = "😀\r\nb".lines()
    assert(unicode.size == 2 && unicode[0] == "😀" && unicode[1] == "b")
    first = "a\nb".lines()
    second = "a\nb".lines()
    first.add("c")
    assert(second.size == 2)
    lengths [Int] = "a\nb".lines().map(line => line.size)
    assert(lengths.size == 2 && lengths[0] == 1 && lengths[1] == 1)

    repeated Str = "ab".repeat(count = 3)
    assert(repeated == "ababab")
    assert("abc".repeat(0) == "")
    assert("abc".repeat(1) == "abc")
    assert("".repeat(Int.MAX) == "")
    assert("😀a".repeat(2) == "😀a😀a")
    rune Rune = "😀".runeAt(0)!
    repeatedRune Str = rune.repeat(3)
    assert(repeatedRune == "😀😀😀")
    assert(rune.repeat(0) == "")
    assert(rune.repeat(1) == "😀")

    last Int? = "ababa".lastIndexOf("aba")
    assert(last == ^2)
    assert("ababa".lastIndexOf("missing").isEmpty)
    assert("😀a😀a".lastIndexOf("a") == ^3)
    assert("😀a😀a".lastIndexOf("😀") == ^2)
    assert("😀a😀a".lastIndexOf("") == ^4)
    assert("".lastIndexOf("") == ^0)
    assert("".lastIndexOf("a").isEmpty)
    assert("ab".repeat(2).lastIndexOf("b") == ^3)
    println("string utilities ok")
}

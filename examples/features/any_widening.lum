# EXPECT:
# true
# true
# true
# hello
# implicit widening also works

shape Point {
    x Int
    y Int
}

fn printAnything(value Any) Unit = println(value.toStr())

fn main() Unit {
    number = Any(42)
    text = Any("hello")
    point = Point(1, 2)
    widenedPoint = Any(point)
    widenedAgain = Any(widenedPoint)

    if let recovered Int = number {
        println(recovered == 42)
    }
    if let recovered Point = widenedPoint {
        println(recovered == point)
    }
    if let recovered Point = widenedAgain {
        println(recovered == point)
    }

    printAnything(text)
    printAnything("implicit widening also works")
}

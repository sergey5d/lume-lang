# EXPECT:
# 30
# Ada 42
# 7
# x=10
# hello
# 9
# 1 2 4 3

shape Point {
    x Int
    y Int
}

type Position = Point

class Worker {
    name Str
    age Int
}

interface Printable {
    def print() Str
}

interface Reader {
    def read() Str
}

def main() Unit {
    point Point = {
        x: 10
        y: 20
    }
    x = 4
    y = 5
    punned Point = new { x, y }
    worker Worker = { name: "Ada", age: 42 }
    position Position = new(3, 4)
    printable Printable = object with Printable {
        x Int = 10

        def print() Str = "x=${this.x}"
    }
    reader Reader = object with Reader {
        def read() Str = "hello"
    }
    anonymous = new { x, y }
    empty {} = new {}
    positional { x Int, y Int } = new(1, 2)
    reversed { y Int, x Int } = new(3, 4)
    widened Any = new { x, y }

    println(point.x + point.y)
    println(worker.name, worker.age)
    println(position.x + position.y)
    println(printable.print())
    println(reader.read())
    println(anonymous.x + anonymous.y)
    println(positional.x, positional.y, reversed.x, reversed.y)
}

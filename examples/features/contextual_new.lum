# EXPECT:
# 30
# Ada 42
# 7
# x=10
# hello

shape Point {
    x Int
    y Int
}

type Position = Point

class Worker {
    name Str
    age Int
}

interface Printable {
    def print() Str
}

interface Reader {
    def read() Str
}

def main() Unit {
    point Point = new {
        x: 10
        y: 20
    }
    worker Worker = new("Ada", 42)
    position Position = new(3, 4)
    printable Printable = shape with Printable {
        x: 10

        def print() Str = "x=${x}"
    }
    reader Reader = object with Reader {
        def read() Str = "hello"
    }

    println(point.x + point.y)
    println(worker.name, worker.age)
    println(position.x + position.y)
    println(printable.print())
    println(reader.read())
}

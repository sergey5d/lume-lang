# EXPECT:
# shape arguments ok

module examples/shapearguments

shape Answer {
    value Str
    error Int
    whoAteMyCookie Decimal
}

shape Options[T] {
    error T
    whoAteMyCookie Decimal
}

shape Point {
    x Int
    y Int
}

def methodA(value Str, error Int, whoAteMyCookie Decimal) Answer =
    Answer(value, error, whoAteMyCookie)

def defaulted(value Str, error Int = 3, whoAteMyCookie Decimal = 2d) Answer =
    Answer(value, error, whoAteMyCookie)

def verify(answer Answer, error Int, amount Decimal) {
    assert(answer.value == "heh")
    assert(answer.error == error)
    assert(answer.whoAteMyCookie == amount)
}

def last[T](first T, second T) T = second
def keep[T](value T) T = value
def itemCount(items [Int]) Int = items.size
def pointSum(point Point) Int = point.x + point.y
def useLazy(first => Int, second Int) Int = second
def readTwice(first Int, second => Int) Int = first + second + second
def sum(values [Int] vararg) Int = values.fold(0, (acc, value) => acc + value)

object StaticService {
    def sum(first Int, second Int) Int = first + second
}

class Trace {
    var text Str = ""

    def mark(label Str, value Int) Int {
        text := text + label
        value
    }

    def options() { first Int, second Int } {
        text := text + "S"
        { second: mark("B", 2), first: mark("X", 99) }
    }

    def empty() {} {
        text := text + "E"
        new {}
    }
}

class Service {
    def sum(first Int, second Int) Int = first + second
    def second[T](first T, second T) T = second
}

def service(trace Trace) Service {
    trace.mark("R", 0)
    Service()
}

def main() {
    verify(methodA(... { value: "heh", error: 5, whoAteMyCookie: 10d }), 5, 10d)
    options = { error: 6, whoAteMyCookie: 11d }
    error = 6
    whoAteMyCookie = 11d
    verify(methodA("heh", ...new { error, whoAteMyCookie }), 6, 11d)
    verify(methodA("heh", ...options), 6, 11d)
    verify(methodA("heh", 5, ...options), 5, 11d)
    verify(methodA("heh", error = 4, ...options), 4, 11d)
    verify(methodA("heh", 5, 10d, ...options), 5, 10d)
    verify(methodA("heh", error = 9, ...options, ... { error: 8 }), 9, 11d)
    verify(methodA("heh", error = 9, ... { error: "ignored", whoAteMyCookie: 11d }), 9, 11d)
    named = Options(8, 12d)
    verify(methodA("heh", ...named), 8, 12d)
    verify(defaulted(... { value: "heh" }), 3, 2d)
    assert(last("first", ... { second: "second" }) == "second")
    assert(itemCount(... { items: [] }) == 0)
    assert(pointSum(... { point: new(2, 3) }) == 5)
    assert(StaticService.sum(... { second: 2, first: 1 }) == 3)
    assert(sum(... { values: [1, 2] }) == 3)
    assert(sum(1, ...[2, 3]) == 6)
    assert(Int.parse(... { value: "32" }) == Some(32))
    numbers = [1, 2, 3]
    assert(numbers.contains(... { value: 2 }))
    assert(numbers.take(... { count: 2 }).size == 2)
    assert(numbers.fold(... { f: (acc Int, value Int) => acc + value, initial: 0 }) == 6)

    ordered = Trace()
    assert(last(... { second: ordered.mark("B", 2) }, ... { first: ordered.mark("A", 1) }) == 2)
    assert(ordered.text == "BA")
    assert(last[Int](... { first: 1, second: 2 }) == 2)
    assert(keep[Point](... { value: new(2, 3) }).x == 2)

    overridden = Trace()
    assert(service(overridden).sum(1, 2, ...overridden.options()) == 3)
    assert(overridden.text == "RSBX")

    generic = Trace()
    assert(service(generic).second[Int](generic.mark("A", 1), ...generic.options()) == 2)
    assert(generic.text == "RASBX")

    trace = Trace()
    assert(service(trace).sum(trace.mark("A", 1), ...trace.options()) == 3)
    assert(trace.text == "RASBX")
    assert(useLazy(trace.mark("N", 99), ... { second: 2 }) == 2)
    assert(trace.text == "RASBX")
    assert(readTwice(1, ... { second: trace.mark("L", 2) }) == 5)
    assert(trace.text == "RASBXL")
    verify(defaulted("heh", ...trace.empty()), 3, 2d)
    assert(trace.text == "RASBXLE")

    var supplied = { error: 1, whoAteMyCookie: 4d }
    verify(methodA("heh", ...supplied), 1, 4d)
    supplied := { error: 2, whoAteMyCookie: 5d }
    verify(methodA("heh", ...supplied), 2, 5d)
    println("shape arguments ok")
}

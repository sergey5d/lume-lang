# EXPECT:
# block 0
# block 1
# block 2
# short 0
# short 1
# short 2
# loop 0
# loop 1
# loop 2
# after loop
# 0

next(label Str, value Int) Int {
    println(label + " " + value)
    value + 1
}

main() Int {
    var count Int = 0
    while count < 3 {
        println("block " + count)
        count += 1
    }

    var shortCount Int = 0
    while shortCount < 3 {
        shortCount := next("short", shortCount)
    }

    var loopCount Int = 0
    while true {
        println("loop " + loopCount)
        loopCount += 1
        if loopCount == 3 {
            break
        }
    }

    while true {
        break
    }
    println("after loop")

    0
}

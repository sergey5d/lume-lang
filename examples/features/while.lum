# EXPECT:
# block 0
# block 1
# block 2
# short 0
# short 1
# short 2
# loop 0
# loop 1
# loop 2
# after loop
# let 3
# let 2
# let 1
# case 4
# 0

def next(label Str, value Int) Int {
    println(label + " " + value)
    value + 1
}

def main() Int {
    var count Int = 0
    while count < 3 {
        println("block " + count)
        count += 1
    }

    var shortCount Int = 0
    while shortCount < 3 {
        shortCount := next("short", shortCount)
    }

    var loopCount Int = 0
    while true {
        println("loop " + loopCount)
        loopCount += 1
        if loopCount == 3 {
            break
        }
    }

    while true {
        break
    }
    println("after loop")

    var nextValue Option[Int] = Some(3)
    while let value <- nextValue && value > 0 {
        println("let " + value)
        nextValue := if value > 1 { Some(value - 1) } else { None }
    }

    nextValue := Some(4)
    while let Some(value) = nextValue {
        println("case " + value)
        nextValue := None
    }

    0
}

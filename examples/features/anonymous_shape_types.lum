# EXPECT:
# aliases hello hello
# named 10

shape Result {
    x Str
}

fn result() { x Str } =
    { x: "hello" }

fn toResult(value { x Str }) Result = value

fn toAnonymous(value Result) { x Str } = value

shape NamedResult {
    x Int

    fn doubled() Int = this.x * 2
}

fn main() Unit {
    value Result = toResult(result())
    copy { x Str } = toAnonymous(value)
    println("aliases", value.x, copy.x)

    named NamedResult = NamedResult { x: 5 }
    println("named", named.doubled())
}

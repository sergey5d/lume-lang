# EXPECT:
# aliases hello hello
# named 10

shape Result {
    x Str
}

def result() { x Str } =
    { x: "hello" }

def toResult(value { x Str }) Result = value

def toAnonymous(value Result) { x Str } = value

shape NamedResult {
    x Int

    def doubled() Int = this.x * 2
}

def main() Unit {
    value Result = toResult(result())
    copy { x Str } = toAnonymous(value)
    println("aliases", value.x, copy.x)

    named NamedResult = NamedResult { x: 5 }
    println("named", named.doubled())
}

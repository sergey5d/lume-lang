# EXPECT:
# is worker
# Ada

class Worker {
    name Str

    fn label() Str = this.name
}

fn workerLabel(value Any) Str {
    if value is not Worker {
        return "not a worker"
    }

    # The early exit preserves the successful Worker narrowing here.
    value.label()
}

fn main() Unit {
    value Any = Worker("Ada")

    if value is not Worker {
        println("is other")
    } else {
        label = value.label()
        println("is worker")
    }

    println(workerLabel(value))
}

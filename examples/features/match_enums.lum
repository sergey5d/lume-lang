# EXPECT:
# some 5
# none
# 5
# 100
# left-right
# 0

type MaybeInt =
    class SomeX { value Int }
    | object NoneX {}

type PairText =
    class PairX {
        left Str
        right Str
    }
    | object EmptyText {}

def printOption(value MaybeInt) {
    match value {
        case SomeX { value as x } => {
            println("some " + x)
        }
        case MaybeInt.NoneX => {
            println("none")
        }
    }
}

def matchSingleLine(value MaybeInt) Int = match value {
    case SomeX { value as x } => x
    case MaybeInt.NoneX => 100
}

def main() Int {
    some MaybeInt = MaybeInt.SomeX(5)
    none MaybeInt = MaybeInt.NoneX
    printOption(some)
    printOption(none)
    println(matchSingleLine(some))
    println(matchSingleLine(none))

    pairText PairText = PairText.PairX("left", "right")
    println(match pairText {
        case PairX { left, right } => left + "-" + right
        case EmptyText => "empty"
    })

    0
}

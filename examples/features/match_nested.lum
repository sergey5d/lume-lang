# EXPECT:
# 1
# 2
# 9

type BoolBox =
    class Wrap { value Bool }
    | object Empty {}

type PairBox =
    class Full { value (Int, Int) }
    | object NoneX {}

def describeFlag(value BoolBox) Int =
    match value {
        case Wrap { value: true } => 1
        case Wrap { value: false } => 2
        case BoolBox.Empty => 0
    }

def describePair(value PairBox) Int =
    match value {
        case Full { value: (left, right) } => left + right
        case PairBox.NoneX => 0
    }

def main() Unit {
    println(describeFlag(BoolBox.Wrap(true)))
    println(describeFlag(BoolBox.Wrap(false)))
    println(describePair(PairBox.Full((4, 5))))
}

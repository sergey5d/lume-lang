# EXPECT:
# shape 3
# class 7
# anonymous 11

shape Point {
    x Int
    y Int
}

class ClassPoint {
    x Int
    y Int
}

def makeClassPoint(x Int, y Int) ClassPoint =
    ClassPoint { x, y }

def makeAnonymousPoint(x Int, y Int) { x Int, y Int } =
    shape { x, y }

def main() Unit {
    x = 1
    y = 2
    point Point = Point { x, y }
    println("shape", point.x + point.y)

    classPoint = makeClassPoint(3, 4)
    println("class", classPoint.x + classPoint.y)

    anonymous = makeAnonymousPoint(5, 6)
    println("anonymous", anonymous.x + anonymous.y)
}

# EXPECT:
# some 6
# none missing
# optSome 8
# optNone true
# pair 5-no-right
# sum 9
# sumFail sum-missing
# prefix 6

def plusOne(value Int?) Result[Int, Str] {
    let Some { value as item } = value else {
        return Err("missing")
    }
    Ok(item + 1)
}

def plusThree(value Int?) Int? {
    item = try value
    Some(item + 3)
}

def pairwise(left Int?, right Str?) { count Int, label Str } {
    let Some { value as count } = left else {
        return { count: 0, label: "no-left" }
    }
    let Some { value as label } = right else {
        return shape(count, "no-right")
    }

    let {
        Some { value as groupedCount } = left
        Some { value as groupedLabel } = right
    } else {
        return shape(count, label)
    }

    shape(groupedCount, groupedLabel)
}

def sumBoth(left Int?, right Int?) Result[Int, Str] {
    let Some { value as a } = left else return Err("sum-missing")
    let Some { value as b } = right else return Err("sum-missing")
    Ok(a + b)
}

def sumPrefix(values [Int?]) Int {
    var total Int = 0
    for value <- values {
        let Some { value as item } = value else break
        total := total + item
    }
    total
}

def main() Unit {
    some = plusOne(Some(5))
    none = plusOne(None)
    optSome = plusThree(Some(5))
    optNone = plusThree(None)
    pair = pairwise(Some(5), None)
    sum = sumBoth(Some(4), Some(5))
    sumFail = sumBoth(Some(4), None)
    prefix = sumPrefix([Some(1), Some(2), Some(3), None, Some(100)])

    println("some ${some.getOr(0)}")
    println("none ${none.getError()}")
    println("optSome ${optSome.getOr(0)}")
    println("optNone ${optNone.isEmpty()}")
    println("pair ${pair.count}-${pair.label}")
    println("sum ${sum.getOr(0)}")
    println("sumFail ${sumFail.getError()}")
    println("prefix ${prefix}")
}

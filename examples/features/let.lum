# EXPECT:
# some 6
# none missing
# optSome 8
# optNone true
# pair 5-no-right
# sum 9
# sumFail sum-missing
# prefix 6

def plusOne(value Option[Int]) Result[Int, Str] {
    guard Some(item) = value else {
        return Err("missing")
    }
    Ok(item + 1)
}

def plusThree(value Option[Int]) Option[Int] {
    item = try value
    Some(item + 3)
}

def pairwise(left Option[Int], right Option[Str]) { count Int, label Str } {
    guard Some(count) = left else {
        return { count: 0, label: "no-left" }
    }
    guard Some(label) = right else {
        return (count, "no-right")
    }

    guard {
        Some(groupedCount) = left
        Some(groupedLabel) = right
    } else {
        return (count, label)
    }

    (groupedCount, groupedLabel)
}

def sumBoth(left Option[Int], right Option[Int]) Result[Int, Str] {
    guard Some(a) = left else return Err("sum-missing")
    guard Some(b) = right else return Err("sum-missing")
    Ok(a + b)
}

def sumPrefix(values List[Option[Int]]) Int {
    var total Int = 0
    for value <- values {
        guard Some(item) = value else break
        total := total + item
    }
    total
}

def main() Unit {
    some = plusOne(Some(5))
    none = plusOne(None)
    optSome = plusThree(Some(5))
    optNone = plusThree(None)
    pair = pairwise(Some(5), None)
    sum = sumBoth(Some(4), Some(5))
    sumFail = sumBoth(Some(4), None)
    prefix = sumPrefix([Some(1), Some(2), Some(3), None, Some(100)])

    println("some ${some.getOr(0)}")
    println("none ${none.getError()}")
    println("optSome ${optSome.getOr(0)}")
    println("optNone ${optNone.isEmpty()}")
    println("pair ${pair.count}-${pair.label}")
    println("sum ${sum.getOr(0)}")
    println("sumFail ${sumFail.getError()}")
    println("prefix ${prefix}")
}

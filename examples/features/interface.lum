# EXPECT:
# interface Ada

interface Named {
    fn name() Str
}

class Person with Named {
    storedName Str

    fn name() Str =
        this.storedName
}


fn describe(value Named) Str =
    value.name()

fn main() Unit {
    person Person = Person { storedName: "Ada" }
    println("interface", describe(person))
}

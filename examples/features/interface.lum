# EXPECT:
# interface Ada

interface Named {
    def name() Str
}

class Person with Named {
    storedName Str

    def name() Str =
        this.storedName
}


def describe(value Named) Str =
    value.name()

def main() Unit {
    person Person = Person { storedName: "Ada" }
    println("interface", describe(person))
}

# EXPECT:
# 5
# 5
# 0
# 0

type OptionX[T] =
    class SomeX { value T }
    | object NoneX {}

annotation DefaultOption {
    value OptionX[Int]
}

@DefaultOption { value: NoneX }
fn annotatedBare() Unit {}

@DefaultOption { value: OptionX.NoneX }
fn annotatedQualified() Unit {}

fn readBare(value OptionX[Int]) Int = match value {
    case SomeX { value as item } => item
    case NoneX => 0
}

fn readQualified(value OptionX[Int]) Int = match value {
    case OptionX.SomeX { value as item } => item
    case OptionX.NoneX => 0
}

fn main() Unit {
    bare OptionX[Int] = SomeX(5)
    qualified OptionX[Int] = OptionX.SomeX(5)
    empty OptionX[Int] = NoneX
    qualifiedEmpty OptionX[Int] = OptionX.NoneX

    println(readBare(bare))
    println(readQualified(qualified))
    println(readBare(empty))
    println(readQualified(qualifiedEmpty))
}

# EXPECT:
# Ada Ada
# 5
# 2 3
# 42

interface Named {
    get label Str
}

class Item with Named {
    name Str

    get label Str = this.name
    get repeated Str = label + " " + this.label
}

shape Point {
    x Int
    y Int

    get total Int = this.x + this.y
    get coordinates (Int, Int) = (this.x, this.y)
}

class Factory {
    get creator fn() Int = () => 42
}

def main() Unit {
    item Item = Item("Ada")
    point Point = Point(2, 3)
    factory Factory = Factory()
    coordinates = point.coordinates

    println(item.repeated)
    println(point.total)
    println(coordinates[0], coordinates[1])
    println(factory.creator())
}

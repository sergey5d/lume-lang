# EXPECT:
# array
# class
# class
# interface
# named Zoe
# 0

interface Named {
    label() Str
}

class Worker with Named {
    name Str
}

impl Worker {
    label() Str = this.name
}

class Amount {
    count Int
    label Str
}

describeArray(value [Int]) {
    match value {
        case _ Array => println("array")
    }
}

describeClass(value Worker) {
    match value {
        case _ Worker => println("class")
    }
}

describeShape(value Amount) {
    match value {
        case _ Amount => println("class")
    }
}

describeInterface(value Named) {
    match value {
        case _ Named => println("interface")
    }
}

describeNamedWorker(value Named) {
    match value {
        case worker Worker => println("named " + worker.label())
        case _ => println("unknown")
    }
}

main() Int {
    describeArray([1, 2, 3])
    describeClass(Worker("Ada"))
    describeShape(Amount(7, "usd"))
    describeInterface(Worker("Bob"))
    describeNamedWorker(Worker("Zoe"))
    0
}

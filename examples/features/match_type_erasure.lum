# EXPECT:
# vector
# class
# class
# interface
# named Zoe
# 0

interface Named {
    def label() Str
}

class Worker with Named {
    name Str

    def label() Str = this.name
}


class Amount {
    count Int
    label Str
}

def describeVector(value [Int]) {
    match value {
        case _ Vector => println("vector")
    }
}

def describeClass(value Worker) {
    match value {
        case _ Worker => println("class")
    }
}

def describeShape(value Amount) {
    match value {
        case _ Amount => println("class")
    }
}

def describeInterface(value Named) {
    match value {
        case _ Named => println("interface")
    }
}

def describeNamedWorker(value Named) {
    match value {
        case worker Worker => println("named " + worker.label())
        case _ => println("unknown")
    }
}

def main() Int {
    describeVector([1, 2, 3])
    describeClass(Worker("Ada"))
    describeShape(Amount(7, "usd"))
    describeInterface(Worker("Bob"))
    describeNamedWorker(Worker("Zoe"))
    0
}

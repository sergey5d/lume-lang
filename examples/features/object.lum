# EXPECT:
# settings
# hello 4
# 8
# welcome

object Settings {
    name Str = "settings"

    fn label() Str = this.name
}

interface Greeter {
    fn greet() Str
}

interface Described {
    fn name() Str
}

fn main() Unit = {
    println(Settings.label())

    prefix = "hello"
    value = object {
        count Int = 4
        label Str = prefix

        fn describe() Str = this.label + " " + this.count.toStr()
        fn doubled() Int = count * 2
    }
    println(value.describe())
    println(value.doubled())

    greeter Greeter = object with Greeter, Described {
        greeting Str = "welcome"
        description Str = "example"

        fn greet() Str = greeting
        fn name() Str = description
    }
    println(greeter.greet())

}

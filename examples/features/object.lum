# EXPECT:
# settings
# hello 4
# 8
# welcome

object Settings {
    name Str = "settings"

    def label() Str = this.name
}

interface Greeter {
    def greet() Str
}

interface Described {
    def name() Str
}

def main() Unit = {
    println(Settings.label())

    prefix = "hello"
    value = object {
        count Int = 4
        label Str = prefix

        def describe() Str = this.label + " " + this.count.toStr()
        def doubled() Int = count * 2
    }
    println(value.describe())
    println(value.doubled())

    greeter Greeter = object with Greeter, Described {
        def greet() Str = "welcome"
        def name() Str = "example"
    }
    println(greeter.greet())

}

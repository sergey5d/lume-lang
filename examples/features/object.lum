# EXPECT:
# settings
# hello 4
# 8
# welcome

object Settings {
    name Str = "settings"

    label() Str = this.name
}

interface Greeter {
    greet() Str
}

main() Unit = {
    println(Settings.label())

    prefix = "hello"
    value = object {
        count Int = 4
        label Str = prefix

        describe() Str = this.label + " " + this.count.toStr()
        doubled() Int = count * 2
    }
    println(value.describe())
    println(value.doubled())

    greeter Greeter = object with Greeter {
        greet() Str = "welcome"
    }
    println(greeter.greet())
}

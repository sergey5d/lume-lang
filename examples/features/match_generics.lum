# EXPECT:
# 0

type OptionX[T] =
    class SomeX { value T }
    | object NoneX {}

class Box[T] {
    value T
}

def unwrapSome(value OptionX[Int]) Int = match value {
    case SomeX { value as x } => x + 1
    case OptionX.NoneX => 0
}

def unwrapBox(value Box[Int]) Int = match value {
    case Box { value as x } => x + 2
}

def main() Int {
    0
}

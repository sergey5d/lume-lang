# EXPECT:
# 0

type OptionX[T] =
    class SomeX { value T }
    | object NoneX {}

class Box[T] {
    value T
}

fn unwrapSome(value OptionX[Int]) Int = match value {
    case SomeX { value as x } => x + 1
    case OptionX.NoneX => 0
}

fn unwrapBox(value Box[Int]) Int = match value {
    case Box { value as x } => x + 2
}

fn main() Int {
    0
}

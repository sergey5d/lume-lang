# EXPECT:
# yield default 14
# yield return missing
# yield continue 8
# yield break 2

fn sum(values [Int]) Int {
    var total Int = 0
    for value <- values {
        total += value
    }
    total
}

fn defaultValues(values [Int?]) [Int] =
    for maybe <- values yield maybe ?? 10

fn returnOnMissing(values [Int?]) Str {
    doubled = for maybe <- values yield {
        value = maybe ?? return "missing"
        value * 2
    }
    "complete " + doubled.size
}

fn continueOnMissing(values [Int?]) [Int] =
    for maybe <- values yield {
        value = maybe ?? continue
        value * 2
    }

fn breakOnMissing(values [Int?]) [Int] =
    for maybe <- values yield {
        value = maybe ?? break
        value * 2
    }

fn main() Unit {
    values [Int?] = [Some(1), None, Some(3)]

    println("yield default " + sum(defaultValues(values)))
    println("yield return " + returnOnMissing(values))
    println("yield continue " + sum(continueOnMissing(values)))
    println("yield break " + sum(breakOnMissing(values)))
}

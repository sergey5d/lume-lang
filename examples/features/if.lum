# EXPECT:
# then
# else-if
# picked 5
# binding 7
# 0

main() Int {
    if true {
        println("then")
    } else {
        println("else")
    }

    if false {
        println("nope")
    } else if true {
        println("else-if")
    } else {
        println("also nope")
    }

    picked = if false {
        1
    } else {
        5
    }
    println("picked " + picked)

    values = [7]
    if let Some(value) = values.get(0) {
        println("binding " + value)
    } else {
        println("binding none")
    }

    0
}

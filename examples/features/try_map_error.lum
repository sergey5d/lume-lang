# EXPECT:
# option result Ada
# option mapped missing user
# result ok row-1
# result mapped db: down
# either ok 7
# either mapped left: nope

fn findUser(found Bool) Str? =
    if found { Some("Ada") } else { None }

fn queryRow(ok Bool) Result[Str, Str] =
    if ok { Ok("row-1") } else { Err("down") }

fn queryEither(ok Bool) Either[Str, Int] =
    if ok { Right(7) } else { Left("nope") }

fn loadUser(found Bool) Result[Str, Str] {
    user = try findUser(found).toResult { => "missing user" }
    Ok(user)
}

fn loadRow(ok Bool) Result[Str, Str] {
    row = try queryRow(ok).mapError { err => "db: " + err }
    Ok(row)
}

fn loadEither(ok Bool) Either[Str, Int] {
    value = try queryEither(ok).mapLeft { left =>
        "left: " + left
    }
    Right(value)
}

fn main() {
    println("option result " + (loadUser(true) !))
    println("option mapped " + loadUser(false).expectErr())
    println("result ok " + (loadRow(true) !))
    println("result mapped " + loadRow(false).expectErr())
    println("either ok " + loadEither(true).expectRight().toStr())
    println("either mapped " + loadEither(false).expectLeft())
}

# EXPECT:
# Alex  false true 0 0 3
# Jordan Doe true 0

class RetrySettings {
    attempts Int = 3
}

shape Person {
    name Str = "Alex"
    family Str = ""
    active Bool = false
    nickname Str?
    tags [Str] = []
    scores [Str: Int]
    retries RetrySettings
}

fn main() {
    person Person = { nickname: None, scores: [], retries: RetrySettings() }
    changed Person = {
        name: "Jordan"
        family: "Doe"
        active: true
        nickname: None
        scores: []
        retries: RetrySettings()
    }
    flags { active Bool, tags [Str] } = { active: false, tags: [] }
    empty {} = {}

    println(
        person.name,
        person.family,
        person.active,
        person.nickname is None,
        person.tags.size,
        person.scores.size,
        person.retries.attempts
    )
    println(changed.name, changed.family, changed.active, flags.tags.size)
}

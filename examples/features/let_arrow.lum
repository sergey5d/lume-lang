# EXPECT:
# guardOptionSome 15
# guardOptionNone 0
# guardResultOk 21
# guardResultErr -2
# guardEitherRight 32
# guardEitherLeft -3
# guardGroup 15
# guardGroupFail -1
# expectOption 8
# expectResult 34
# expectEither 55
# expectGroup 18
# ifLet 89
# plainKnownExtract 124

def guardOption(value Option[Int]) Int {
    guard item <- value else return 0
    item + 10
}

def guardResult(value Result[Int, Str]) Int {
    guard item <- value else return -2
    item + 20
}

def guardEither(value Either[Str, Int]) Int {
    guard item <- value else return -3
    item + 30
}

def guardGroup(left Option[Int], middle Result[Int, Str], right Either[Str, Int]) Int {
    guard {
        a <- left
        b <- middle
        c <- right
    } else return -1
    a + b + c
}

def expectOption(value Option[Int]) Int {
    expect item <- value
    item
}

def expectResult(value Result[Int, Str]) Int {
    expect item <- value
    item
}

def expectEither(value Either[Str, Int]) Int {
    expect item <- value
    item
}

def expectGroup(left Option[Int], middle Result[Int, Str], right Either[Str, Int]) Int {
    expect {
        a <- left
        b <- middle
        c <- right
    }
    a + b + c
}

def ifLetValue(value Option[Int]) Int {
    if let item <- value {
        return item
    }
    return -1
}

def plainKnownExtract(value Int) Int {
    let item <- Some(value)
    item + 1
}

def main() Unit {
    println("guardOptionSome " + guardOption(Some(5)))
    println("guardOptionNone " + guardOption(None))
    println("guardResultOk " + guardResult(Ok(1)))
    println("guardResultErr " + guardResult(Err("bad")))
    println("guardEitherRight " + guardEither(Right(2)))
    println("guardEitherLeft " + guardEither(Left("bad")))
    println("guardGroup " + guardGroup(Some(4), Ok(5), Right(6)))
    println("guardGroupFail " + guardGroup(Some(4), Err("bad"), Right(6)))
    println("expectOption " + expectOption(Some(8)))
    println("expectResult " + expectResult(Ok(34)))
    println("expectEither " + expectEither(Right(55)))
    println("expectGroup " + expectGroup(Some(5), Ok(6), Right(7)))
    println("ifLet " + ifLetValue(Some(89)))
    println("plainKnownExtract " + plainKnownExtract(123))
}

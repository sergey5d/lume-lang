# EXPECT:
# letElseOptionSome 15
# letElseOptionNone 0
# letElseResultOk 21
# letElseResultErr -2
# letElseEitherRight 32
# letElseEitherLeft -3
# letElseGroup 15
# letElseGroupFail -1
# panicOption 8
# panicResult 34
# panicEither 55
# panicGroup 18
# ifLet 89
# visibleExtractWithFallback 124

def letElseOption(value Option[Int]) Int {
    let item <- value else return 0
    item + 10
}

def letElseResult(value Result[Int, Str]) Int {
    let item <- value else return -2
    item + 20
}

def letElseEither(value Either[Str, Int]) Int {
    let item <- value else return -3
    item + 30
}

def letElseGroup(left Option[Int], middle Result[Int, Str], right Either[Str, Int]) Int {
    let {
        a <- left
        b <- middle
        c <- right
    } else return -1
    a + b + c
}

def panicOption(value Option[Int]) Int {
    let item <- value else panic("expected option")
    item
}

def panicResult(value Result[Int, Str]) Int {
    let item <- value else panic("expected result")
    item
}

def panicEither(value Either[Str, Int]) Int {
    let item <- value else panic("expected either")
    item
}

def panicGroup(left Option[Int], middle Result[Int, Str], right Either[Str, Int]) Int {
    let {
        a <- left
        b <- middle
        c <- right
    } else panic("expected group")
    a + b + c
}

def ifLetValue(value Option[Int]) Int {
    if let item <- value {
        return item
    }
    return -1
}

def visibleExtractWithFallback(value Int) Int {
    let item <- Some(value) else panic("expected visible value")
    item + 1
}

def main() Unit {
    println("letElseOptionSome " + letElseOption(Some(5)))
    println("letElseOptionNone " + letElseOption(None))
    println("letElseResultOk " + letElseResult(Ok(1)))
    println("letElseResultErr " + letElseResult(Err("bad")))
    println("letElseEitherRight " + letElseEither(Right(2)))
    println("letElseEitherLeft " + letElseEither(Left("bad")))
    println("letElseGroup " + letElseGroup(Some(4), Ok(5), Right(6)))
    println("letElseGroupFail " + letElseGroup(Some(4), Err("bad"), Right(6)))
    println("panicOption " + panicOption(Some(8)))
    println("panicResult " + panicResult(Ok(34)))
    println("panicEither " + panicEither(Right(55)))
    println("panicGroup " + panicGroup(Some(5), Ok(6), Right(7)))
    println("ifLet " + ifLetValue(Some(89)))
    println("visibleExtractWithFallback " + visibleExtractWithFallback(123))
}

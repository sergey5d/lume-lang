module internal_visibility

# Internal declarations and members are shared by files in this module, but
# they are not visible to other modules.
internal fn moduleGreeting() Str = "hello"

class Counter {
    internal var value Int = 0

    internal fn increment() Unit = this.value += 1

    fn current() Int = this.value
}

fn main() Unit {
    counter = Counter {}
    counter.increment()
    println(moduleGreeting(), counter.current())
}

# EXPECT:
# first
# second

private fn addLine(lines [Str], value Str?) {
    if let text <- value {
        lines.add(text)
    }
}

private fn printLines(lines [Str]) = {
    lines.forEach(line => println(line))
}

fn main() Unit {
    lines [Str] = []
    addLine(lines, ^"first")
    addLine(lines, None)
    addLine(lines, ^"second")
    printLines(lines)
}

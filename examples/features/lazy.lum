# EXPECT:
# lazy yes
# lazy evaluated
# lazy fallback

def choose(usePrimary Bool, fallback => Str) Str =
    if usePrimary {
        "yes"
    } else {
        fallback
    }

def expensiveFallback() Str {
    println("lazy evaluated")
    "fallback"
}

def main() Unit {
    println("lazy", choose(1 == 1, expensiveFallback()))
    println("lazy", choose(1 == 2, expensiveFallback()))
}

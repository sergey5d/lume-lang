# EXPECT:
# then
# else-if
# picked 5
# picked2 7
# picked3 9
# pickedMultiline 5
# binding 7
# 0

pickMultiline(flag Bool) Int =
    if flag { 5 } else { 6 }

main() Int {
    if true {
        println("then")
    } else {
        println("else")
    }
    if false {
        println("nope")
    } else if true {
        println("else-if")
    } else {
        println("also nope")
    }

    picked = if false { 1 } else { 5 }
    println("picked " + picked)
    picked2 = if true {
        7
    } else {
        8
    }
    println("picked2 " + picked2)
    picked3 = if false {
        1
    } else if false {
        2
    } else {
        9
    }
    println("picked3 " + picked3)
    println("pickedMultiline " + pickMultiline(true))

    values = [7]
    if let Some(value) = values.get(0) {
        println("binding " + value)
    } else {
        println("binding none")
    }

    0
}

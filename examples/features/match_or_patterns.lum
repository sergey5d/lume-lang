# EXPECT:
# token edge
# number 42

type Token =
    object Start {}
    | object Stop {}
    | class Word { value Str }
    | class Number { value Str }

fn describe(token Token) Str = {
    match token {
        case Token.Start | Token.Stop => "edge"
        case Word { value } | Number { value } => "number " + value
    }
}

fn main() Unit = {
    println("token", describe(Token.Start))
    println(describe(Token.Number("42")))
}

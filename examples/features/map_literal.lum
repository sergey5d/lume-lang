# EXPECT:
# built-in two 2
# built-in dynamic 3
# built-in made 4
# tuple key 99
# empty 0
# empty value 5
# vector spread 6
# map spread shared 20
# map spread size 4
# map entries 4
# 0

def makeKey() Str = "made"

def main() Int {
    dynamicKey = "dynamic"

    builtIn [Str : Int] = [
        "one": 1,
        "two": 2,
        dynamicKey: 3,
        makeKey(): 4,
    ]

    let Some(two) = builtIn["two"] else return 1
    println("built-in two", two)
    let Some(dynamic) = builtIn[dynamicKey] else return 1
    println("built-in dynamic", dynamic)
    let Some(made) = builtIn["made"] else return 1
    println("built-in made", made)

    tupleKey = ("Ada", 1)
    tupleMap [(Str, Int) : Int] = [tupleKey: 99]

    let Some(tupleValue) = tupleMap[("Ada", 1)] else return 1
    println("tuple key", tupleValue)

    empty [Str : Int] = []
    println("empty", empty.size())
    empty["ready"] := 5
    let Some(emptyValue) = empty["ready"] else return 1
    println("empty value", emptyValue)

    first = [1, 2]
    second = [3, 4]
    spreadVector = [0, ...first, ...second, 5]
    println("vector spread", spreadVector.size())

    defaults [Str : Int] = ["one": 1, "shared": 2]
    overrides [Str : Int] = ["shared": 20, "three": 3]
    copied [Str : Int] = [...defaults]
    merged [Str : Int] = [...copied, "two": 2, ...overrides]
    let Some(shared) = merged["shared"] else return 1
    println("map spread shared", shared)
    println("map spread size", merged.size())

    entryList [(Str, Int)] = [...merged.entries()]
    println("map entries", entryList.size())

    0
}

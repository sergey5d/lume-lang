# EXPECT:
# lazy yes
# lazy evaluated
# lazy fallback

fn choose(usePrimary Bool, fallback fn() Str) Str =
    if usePrimary {
        "yes"
    } else {
    fallback()
}

fn expensiveFallback() Str {
    println("lazy evaluated")
    "fallback"
}

fn main() {
    println("lazy", choose(1 == 1, { => expensiveFallback() }))
    println("lazy", choose(1 == 2, expensiveFallback))
}

# EXPECT:
# true true true true
# ascending 1 2 3
# descending 3 2 1
# boundary -1 1

class Score with Comparable[Score] {
    value Int

    def compareTo(other Score) Int = value.compareTo(other.value)
}

def main() Unit {
    low = Score(1)
    high = Score(2)
    println(low < high, low <= high, high > low, high >= low)

    scores = [Score(3), low, high]
    scores.sort()
    println("ascending", scores[0].value, scores[1].value, scores[2].value)

    scores.sort((left, right) => right.compareTo(left))
    println("descending", scores[0].value, scores[1].value, scores[2].value)

    minimum Int = -9223372036854775808
    maximum Int = 9223372036854775807
    println("boundary", minimum.compareTo(maximum), maximum.compareTo(minimum))
}

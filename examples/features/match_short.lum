# EXPECT:
# pair 5-9
# 14
# worker 7
# after unit
# after empty block
# block body
# after block
# expression body 3
# after expression
# 0

class PairBox {
    left Int
    right Int
}

interface WorkerLike {
    doWork() Int
}

class Worker with WorkerLike {
}

impl Worker {
    doWork() Int = 7
}

printBodyShape(value Int) {
    match value {
        case 0 => ()
        case 1 => {}
        case 2 => {
            println("block body")
        }
        case _ => println("expression body " + value)
    }

    match value {
        case 0 => println("after unit")
        case 1 => println("after empty block")
        case 2 => println("after block")
        case _ => println("after expression")
    }
}

main() Int {
    pair PairBox = PairBox(5, 9)

    match pair {
        case PairBox(left, right) => println("pair " + left + "-" + right)
    }

    picked = match pair {
        case PairBox(left, right) => left + right
    }
    println(picked)

    workerLike WorkerLike = Worker {}
    match workerLike {
        case worker Worker => println("worker " + worker.doWork())
    }

    printBodyShape(0)
    printBodyShape(1)
    printBodyShape(2)
    printBodyShape(3)

    0
}

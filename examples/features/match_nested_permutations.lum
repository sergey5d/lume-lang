# EXPECT:
# class in class 11
# shape in class 3 usd
# class in shape 7
# tuple in tuple 1 2 3
# tuple tuple tuple 20 21 22 23
# tuple in class 4 5
# class in tuple 6 9
# shape in tuple 8 eur
# tuple in shape 10 11
# union in union on
# class in union 12
# shape in union 13 cad
# tuple in union 14 15
# union in class off
# union in shape on
# union in tuple off 16

class Apple {
    size Int
}

class AppleBox {
    apple Apple
}

class Amount {
    count Int
    label Str
}

class AmountBox {
    amount Amount
}

class AppleShape {
    apple Apple
}

class PairHolder {
    pair (Int, Int)
}

class PairShape {
    pair (Int, Int)
}

type InnerFlag =
    object Off {}
    | object On {}

type OuterFlag =
    class Wrap { value InnerFlag }
    | object Empty {}

type MaybeApple =
    class SomeX { value Apple }
    | object NoneX {}

type MaybeAmount =
    class SomeX { value Amount }
    | object NoneX {}

type MaybePair =
    class SomeX { value (Int, Int) }
    | object NoneX {}

class FlagBox {
    value InnerFlag
}

class FlagShape {
    value InnerFlag
}

def main() Unit {
    apple11 = Apple(11)
    appleBox = AppleBox { apple: apple11 }
    classInClass = match appleBox {
        case AppleBox { apple: Apple { size } } => "class in class " + size
    }
    println(classInClass)

    amount3 = Amount(3, "usd")
    amountBox = AmountBox { amount: amount3 }
    shapeInClass = match amountBox {
        case AmountBox { amount: Amount { count, label } } => "shape in class " + count + " " + label
    }
    println(shapeInClass)

    apple7 = Apple(7)
    appleShape = AppleShape { apple: apple7 }
    classInShape = match appleShape {
        case AppleShape { apple: Apple { size } } => "class in shape " + size
    }
    println(classInShape)

    tupleInTuple = match ((1, 2), 3) {
        case ((left, right), tail) => "tuple in tuple " + left + " " + right + " " + tail
    }
    println(tupleInTuple)

    tupleTupleTuple = match ((20, 21), (22, 23)) {
        case ((left1, right1), (left2, right2)) => "tuple tuple tuple " + left1 + " " + right1 + " " + left2 + " " + right2
    }
    println(tupleTupleTuple)

    pairHolder = PairHolder { pair: (4, 5) }
    tupleInClass = match pairHolder {
        case PairHolder { pair: (left, right) } => "tuple in class " + left + " " + right
    }
    println(tupleInClass)

    apple6 = Apple(6)
    classInTuple = match (apple6, 9) {
        case (Apple { size }, tail) => "class in tuple " + size + " " + tail
    }
    println(classInTuple)

    amount8 = Amount(8, "eur")
    shapeInTuple = match (amount8, 0) {
        case (Amount { count, label }, _) => "shape in tuple " + count + " " + label
    }
    println(shapeInTuple)

    pairShape = PairShape { pair: (10, 11) }
    tupleInShape = match pairShape {
        case PairShape { pair: (left, right) } => "tuple in shape " + left + " " + right
    }
    println(tupleInShape)

    unionInUnion = match OuterFlag.Wrap(InnerFlag.On) {
        case Wrap { value: InnerFlag.On } => "union in union on"
        case Wrap { value: InnerFlag.Off } => "union in union off"
        case OuterFlag.Empty => "union in union empty"
    }
    println(unionInUnion)

    apple12 = Apple(12)
    classInUnion = match MaybeApple.SomeX(apple12) {
        case SomeX { value: Apple { size } } => "class in union " + size
        case MaybeApple.NoneX => "class in union none"
    }
    println(classInUnion)

    amount13 = Amount(13, "cad")
    shapeInUnion = match MaybeAmount.SomeX(amount13) {
        case SomeX { value: Amount { count, label } } => "shape in union " + count + " " + label
        case MaybeAmount.NoneX => "shape in union none"
    }
    println(shapeInUnion)

    tupleInUnion = match MaybePair.SomeX((14, 15)) {
        case SomeX { value: (left, right) } => "tuple in union " + left + " " + right
        case MaybePair.NoneX => "tuple in union none"
    }
    println(tupleInUnion)

    flagBox = FlagBox { value: InnerFlag.Off }
    unionInClass = match flagBox {
        case FlagBox { value: InnerFlag.On } => "union in class on"
        case FlagBox { value: InnerFlag.Off } => "union in class off"
    }
    println(unionInClass)

    flagShape = FlagShape { value: InnerFlag.On }
    unionInShape = match flagShape {
        case FlagShape { value: InnerFlag.On } => "union in shape on"
        case FlagShape { value: InnerFlag.Off } => "union in shape off"
    }
    println(unionInShape)

    unionInTuple = match (InnerFlag.Off, 16) {
        case (InnerFlag.On, value) => "union in tuple on " + value
        case (InnerFlag.Off, value) => "union in tuple off " + value
    }
    println(unionInTuple)
}

# EXPECT:
# class in class 11
# shape in class 3 usd
# class in shape 7
# tuple in tuple 1 2 3
# tuple tuple tuple 20 21 22 23
# tuple in class 4 5
# class in tuple 6 9
# shape in tuple 8 eur
# tuple in shape 10 11
# enum in enum on
# class in enum 12
# shape in enum 13 cad
# tuple in enum 14 15
# enum in class off
# enum in shape on
# enum in tuple off 16

class Apple {
    size Int
}

class AppleBox {
    apple Apple
}

class Amount {
    count Int
    label Str
}

class AmountBox {
    amount Amount
}

class AppleShape {
    apple Apple
}

class PairHolder {
    pair (Int, Int)
}

class PairShape {
    pair (Int, Int)
}

enum InnerFlag {
    case Off
    case On
}

enum OuterFlag {
    case Empty
    case Wrap {
        value InnerFlag
    }
}

enum MaybeApple {
    case NoneX
    case SomeX {
        value Apple
    }
}

enum MaybeAmount {
    case NoneX
    case SomeX {
        value Amount
    }
}

enum MaybePair {
    case NoneX
    case SomeX {
        value (Int, Int)
    }
}

class FlagBox {
    value InnerFlag
}

class FlagShape {
    value InnerFlag
}

def main() Unit {
    apple11 = Apple(11)
    appleBox = AppleBox { apple: apple11 }
    classInClass = match appleBox {
        case AppleBox { apple: Apple { size } } => "class in class " + size
    }
    println(classInClass)

    amount3 = Amount(3, "usd")
    amountBox = AmountBox { amount: amount3 }
    shapeInClass = match amountBox {
        case AmountBox { amount: Amount { count, label } } => "shape in class " + count + " " + label
    }
    println(shapeInClass)

    apple7 = Apple(7)
    appleShape = AppleShape { apple: apple7 }
    classInShape = match appleShape {
        case AppleShape { apple: Apple { size } } => "class in shape " + size
    }
    println(classInShape)

    tupleInTuple = match ((1, 2), 3) {
        case ((left, right), tail) => "tuple in tuple " + left + " " + right + " " + tail
    }
    println(tupleInTuple)

    tupleTupleTuple = match ((20, 21), (22, 23)) {
        case ((left1, right1), (left2, right2)) => "tuple tuple tuple " + left1 + " " + right1 + " " + left2 + " " + right2
    }
    println(tupleTupleTuple)

    pairHolder = PairHolder { pair: (4, 5) }
    tupleInClass = match pairHolder {
        case PairHolder { pair: (left, right) } => "tuple in class " + left + " " + right
    }
    println(tupleInClass)

    apple6 = Apple(6)
    classInTuple = match (apple6, 9) {
        case (Apple { size }, tail) => "class in tuple " + size + " " + tail
    }
    println(classInTuple)

    amount8 = Amount(8, "eur")
    shapeInTuple = match (amount8, 0) {
        case (Amount { count, label }, _) => "shape in tuple " + count + " " + label
    }
    println(shapeInTuple)

    pairShape = PairShape { pair: (10, 11) }
    tupleInShape = match pairShape {
        case PairShape { pair: (left, right) } => "tuple in shape " + left + " " + right
    }
    println(tupleInShape)

    enumInEnum = match OuterFlag.Wrap(InnerFlag.On) {
        case Wrap { value: InnerFlag.On } => "enum in enum on"
        case Wrap { value: InnerFlag.Off } => "enum in enum off"
        case OuterFlag.Empty => "enum in enum empty"
    }
    println(enumInEnum)

    apple12 = Apple(12)
    classInEnum = match MaybeApple.SomeX(apple12) {
        case SomeX { value: Apple { size } } => "class in enum " + size
        case MaybeApple.NoneX => "class in enum none"
    }
    println(classInEnum)

    amount13 = Amount(13, "cad")
    shapeInEnum = match MaybeAmount.SomeX(amount13) {
        case SomeX { value: Amount { count, label } } => "shape in enum " + count + " " + label
        case MaybeAmount.NoneX => "shape in enum none"
    }
    println(shapeInEnum)

    tupleInEnum = match MaybePair.SomeX((14, 15)) {
        case SomeX { value: (left, right) } => "tuple in enum " + left + " " + right
        case MaybePair.NoneX => "tuple in enum none"
    }
    println(tupleInEnum)

    flagBox = FlagBox { value: InnerFlag.Off }
    enumInClass = match flagBox {
        case FlagBox { value: InnerFlag.On } => "enum in class on"
        case FlagBox { value: InnerFlag.Off } => "enum in class off"
    }
    println(enumInClass)

    flagShape = FlagShape { value: InnerFlag.On }
    enumInShape = match flagShape {
        case FlagShape { value: InnerFlag.On } => "enum in shape on"
        case FlagShape { value: InnerFlag.Off } => "enum in shape off"
    }
    println(enumInShape)

    enumInTuple = match (InnerFlag.Off, 16) {
        case (InnerFlag.On, value) => "enum in tuple on " + value
        case (InnerFlag.Off, value) => "enum in tuple off " + value
    }
    println(enumInTuple)
}

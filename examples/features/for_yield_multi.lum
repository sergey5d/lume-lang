# EXPECT:
# combo 11
# combo 21
# combo 12
# combo 22
# size 4
# 0

def main() Int {
	items = for {
		left <- [1, 2]
		right <- [10, 20]
		let (base, extra) = (left, right)
		total = base + extra
	} yield {
		total
	}

	for item <- items {
		println("combo " + item)
	}

	println("size " + items.size())
	0
}

# EXPECT:
# item 1
# item 2
# item 3
# item 4
# item 5
# total 15
# yielded 2
# yielded 3
# yielded 4
# combo 11
# combo 21
# combo 12
# combo 22
# combo size 4
# pair 3
# pair 7
# user Ada 36
# user Bob 42
# ignored 2
# products 2
# products 12
# 0

class User {
    name Str
    age Int
}

def main() Int {
    var total Int = 0

    for item <- [1, 2, 3] {
        println("item " + item)
        total += item
    }

    for item <- Range(4, 6) {
        println("item " + item)
        total += item
    }

    println("total " + total)

    yielded = for item <- [1, 2, 3] yield item + 1

    for item <- yielded {
        println("yielded " + item)
    }

    combos = for {
        left <- [1, 2]
        right <- [10, 20]
        let (base, extra) = (left, right)
        combo = base + extra
    } yield {
        combo
    }

    for combo <- combos {
        println("combo " + combo)
    }

    println("combo size " + combos.size())

    pairs List[(Int, Int)] = [(1, 2), (3, 4)]
    for let (left, right) <- pairs {
        println("pair " + (left + right))
    }

    users List[User] = [User("Ada", 36), User("Bob", 42)]
    for let { name, age } <- users {
        println("user " + name + " " + age)
    }

    var ignored Int = 0
    for _ <- users {
        ignored += 1
    }
    println("ignored " + ignored)

    products = for {
        let (left, right) <- pairs
    } yield left * right

    for product <- products {
        println("products " + product)
    }

    0
}

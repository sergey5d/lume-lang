# EXPECT:
# hop
# jump 3
# true
# true

interface Hopper {
    fn hop() Str
}

interface Jumper {
    fn jump(steps Int) Str
}

class Rabbit with Hopper, Jumper {

    fn hop() Str = "hop"

    fn jump(steps Int) Str = "jump " + steps
}

fn main() Unit {
    rabbit = Rabbit {}
    println(rabbit.hop())
    println(rabbit.jump(3))
    println(rabbit is Hopper)
    println(rabbit is Jumper)
}

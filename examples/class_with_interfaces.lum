# EXPECT:
# hop
# jump 3
# true
# true

interface Hopper {
    hop() Str
}

interface Jumper {
    jump(steps Int) Str
}

class Rabbit with Hopper, Jumper {

    hop() Str = "hop"

    jump(steps Int) Str = "jump " + steps
}

main() Unit {
    rabbit = Rabbit {}
    println(rabbit.hop())
    println(rabbit.jump(3))
    println(rabbit is Hopper)
    println(rabbit is Jumper)
}

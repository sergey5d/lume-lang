# EXPECT:
# apple -> egg -> goat -> tiger -> rat

# "First" means first successful path in `allWords` order.

def firstLetter(word Str) Rune = word.runeAt(0)!

def lastLetter(word Str) Rune = word.runeAt(word.size - 1)!

def matches(firstChar Rune, endWord Str, allWords [Str], pickedWords Set[Str], path [Str]) [Str]? {
    for word <- allWords {
        if pickedWords.contains(word) {
            continue
        }

        if firstLetter(word) != firstChar {
            continue
        }

        nextPath = Vector.from(path)
        nextPath.add(word)

        if word == endWord {
            return Some(nextPath)
        }

        nextPicked = Set.from(pickedWords)
        nextPicked.add(word)

        if let Some(foundPath) = matches(lastLetter(word), endWord, allWords, nextPicked, nextPath) {
            return Some(foundPath)
        }
    }

    None
}

def firstPath(startWord Str, endWord Str, allWords [Str]) [Str]? {
    if startWord == endWord {
        return Some([startWord])
    }

    matches(lastLetter(startWord), endWord, allWords, Set(startWord), [startWord])
}

def renderPath(path [Str]) Str {
    if path.isEmpty {
        return ""
    }

    first = path.head ?? ""
    rest = path.tail()
    rest.fold(first, (acc, word) => acc + " -> " + word)
}

def main() Unit {
    words [Str] = [
        "apple",
        "egg",
        "goat",
        "grape",
        "elephant",
        "tiger",
        "rat"
    ]

    path = firstPath("apple", "rat", words)
    pathText = path.map(found => renderPath(found)) ?? "no match"
    println(pathText)
}

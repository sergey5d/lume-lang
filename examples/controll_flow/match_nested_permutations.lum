# EXPECT:
# class in class 11
# record in class 3 usd
# class in record 7
# tuple in tuple 1 2 3
# tuple tuple tuple 20 21 22 23
# tuple in class 4 5
# class in tuple 6 9
# record in tuple 8 eur
# tuple in record 10 11
# enum in enum on
# class in enum 12
# record in enum 13 cad
# tuple in enum 14 15
# enum in class off
# enum in record on
# enum in tuple off 16

class Apple {
    size Int
}

class AppleBox {
    apple Apple
}

class Amount {
    count Int
    label Str
}

class AmountBox {
    amount Amount
}

class AppleRecord {
    apple Apple
}

class PairHolder {
    pair (Int, Int)
}

class PairRecord {
    pair (Int, Int)
}

enum InnerFlag {
    case Off
    case On
}

enum OuterFlag {
    case Empty
    case Wrap {
        value InnerFlag
    }
}

enum MaybeApple {
    case NoneX
    case SomeX {
        value Apple
    }
}

enum MaybeAmount {
    case NoneX
    case SomeX {
        value Amount
    }
}

enum MaybePair {
    case NoneX
    case SomeX {
        value (Int, Int)
    }
}

class FlagBox {
    value InnerFlag
}

class FlagRecord {
    value InnerFlag
}

def main() Unit {
    apple11 = Apple { 11 }
    appleBox = AppleBox { apple: apple11 }
    classInClass = match appleBox {
        case AppleBox(Apple(size)) => "class in class " + size
    }
    println(classInClass)

    amount3 = Amount { 3, "usd" }
    amountBox = AmountBox { amount: amount3 }
    recordInClass = match amountBox {
        case AmountBox(Amount(count, label)) => "record in class " + count + " " + label
    }
    println(recordInClass)

    apple7 = Apple { 7 }
    appleRecord = AppleRecord { apple: apple7 }
    classInRecord = match appleRecord {
        case AppleRecord(Apple(size)) => "class in record " + size
    }
    println(classInRecord)

    tupleInTuple = match ((1, 2), 3) {
        case ((left, right), tail) => "tuple in tuple " + left + " " + right + " " + tail
    }
    println(tupleInTuple)

    tupleTupleTuple = match ((20, 21), (22, 23)) {
        case ((left1, right1), (left2, right2)) => "tuple tuple tuple " + left1 + " " + right1 + " " + left2 + " " + right2
    }
    println(tupleTupleTuple)

    pairHolder = PairHolder { pair: (4, 5) }
    tupleInClass = match pairHolder {
        case PairHolder((left, right)) => "tuple in class " + left + " " + right
    }
    println(tupleInClass)

    apple6 = Apple { 6 }
    classInTuple = match (apple6, 9) {
        case (Apple(size), tail) => "class in tuple " + size + " " + tail
    }
    println(classInTuple)

    amount8 = Amount { 8, "eur" }
    recordInTuple = match (amount8, 0) {
        case (Amount(count, label), _) => "record in tuple " + count + " " + label
    }
    println(recordInTuple)

    pairRecord = PairRecord { pair: (10, 11) }
    tupleInRecord = match pairRecord {
        case PairRecord((left, right)) => "tuple in record " + left + " " + right
    }
    println(tupleInRecord)

    enumInEnum = match OuterFlag.Wrap(InnerFlag.On) {
        case Wrap(InnerFlag.On) => "enum in enum on"
        case Wrap(InnerFlag.Off) => "enum in enum off"
        case OuterFlag.Empty => "enum in enum empty"
    }
    println(enumInEnum)

    apple12 = Apple { 12 }
    classInEnum = match MaybeApple.SomeX(apple12) {
        case SomeX(Apple(size)) => "class in enum " + size
        case MaybeApple.NoneX => "class in enum none"
    }
    println(classInEnum)

    amount13 = Amount { 13, "cad" }
    recordInEnum = match MaybeAmount.SomeX(amount13) {
        case SomeX(Amount(count, label)) => "record in enum " + count + " " + label
        case MaybeAmount.NoneX => "record in enum none"
    }
    println(recordInEnum)

    tupleInEnum = match MaybePair.SomeX((14, 15)) {
        case SomeX((left, right)) => "tuple in enum " + left + " " + right
        case MaybePair.NoneX => "tuple in enum none"
    }
    println(tupleInEnum)

    flagBox = FlagBox { value: InnerFlag.Off }
    enumInClass = match flagBox {
        case FlagBox(InnerFlag.On) => "enum in class on"
        case FlagBox(InnerFlag.Off) => "enum in class off"
    }
    println(enumInClass)

    flagRecord = FlagRecord { value: InnerFlag.On }
    enumInRecord = match flagRecord {
        case FlagRecord(InnerFlag.On) => "enum in record on"
        case FlagRecord(InnerFlag.Off) => "enum in record off"
    }
    println(enumInRecord)

    enumInTuple = match (InnerFlag.Off, 16) {
        case (InnerFlag.On, value) => "enum in tuple on " + value
        case (InnerFlag.Off, value) => "enum in tuple off " + value
    }
    println(enumInTuple)
}

# EXPECT:
# array zip 1 a
# array zip 2 b
# array zipWithIndex 3 2
# fixed array zip 5 y
# fixed array zipWithIndex 6 2
# range zip 11 q
# range zipWithIndex 8 1
# pair sum 3
# indexed sum 4
# fixed array pair sum 5
# range pair sum 21
# range index sum 16

def main() Unit {
    items = [1, 2, 3]
    arrayPairs = items.zip(["a", "b"])
    arrayIndexed = items.zipWithIndex()

    let Some(firstPair) = arrayPairs.get(0) else {
        return ()
    }
    let Some(secondPair) = arrayPairs.get(1) else return ()

    let Some(indexedPair) = arrayIndexed.get(2) else return ()

    let (firstLeft, firstRight) = firstPair
    let (secondLeft, secondRight) = secondPair
    let (indexedValue, indexedPos) = indexedPair

    println("array zip", firstLeft, firstRight)
    println("array zip", secondLeft, secondRight)
    println("array zipWithIndex", indexedValue, indexedPos)

    values = FixedArray(4, 5, 6)
    other = FixedArray("x", "y")
    fixedArrayPairs = values.zip(other)
    fixedArrayIndexed = values.zipWithIndex()

    let (arrayLeft, arrayRight) = fixedArrayPairs[1]
    let (arrayIndexedValue, arrayIndexedPos) = fixedArrayIndexed[2]

    println("fixed array zip", arrayLeft, arrayRight)
    println("fixed array zipWithIndex", arrayIndexedValue, arrayIndexedPos)

    rangePairs = Range(10, 13).zip(["p", "q"])
    rangeIndexed = Range(7, 9).zipWithIndex()

    let Some(rangePair) = rangePairs.get(1) else {
        return ()
    }
    let Some(rangeIndexedPair) = rangeIndexed.get(1) else {
        return ()
    }
    let (rangeLeft, rangeRight) = rangePair
    let (rangeIndexedValue, rangeIndexedPos) = rangeIndexedPair

    println("range zip", rangeLeft, rangeRight)
    println("range zipWithIndex", rangeIndexedValue, rangeIndexedPos)

    var pairSum = 0
    for pair <- arrayPairs {
        let (left, right) = pair
        if right == "a" || right == "b" {
            pairSum += left
        }
    }
    println("pair sum", pairSum)

    var indexedSum = 0
    for indexed <- arrayIndexed {
        let (value, index) = indexed
        if index < 2 {
            indexedSum += value + index
        }
    }
    println("indexed sum", indexedSum)

    var arrayPairSum = 0
    for pair <- fixedArrayPairs {
        let (left, right) = pair
        if right == "y" {
            arrayPairSum += left
        }
    }
    println("fixed array pair sum", arrayPairSum)

    var rangePairSum = 0
    for pair <- rangePairs {
        let (left, right) = pair
        if right == "p" || right == "q" {
            rangePairSum += left
        }
    }
    println("range pair sum", rangePairSum)

    var rangeIndexSum = 0
    for indexed <- rangeIndexed {
        let (value, index) = indexed
        rangeIndexSum += value + index
    }
    println("range index sum", rangeIndexSum)
}

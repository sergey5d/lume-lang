# EXPECT:
# vector zip 1 a
# vector zip 2 b
# vector zipWithIndex 3 2
# array zip 5 y
# array zipWithIndex 6 2
# range zip 11 q
# range zipWithIndex 8 1
# pair sum 3
# indexed sum 4
# array pair sum 5
# range pair sum 21
# range index sum 16

def main() Unit {
    items = [1, 2, 3]
    vectorPairs = items.zip(["a", "b"])
    vectorIndexed = items.zipWithIndex()

    let Some { value as firstPair } = vectorPairs.at(0) else {
        return ()
    }
    let Some { value as secondPair } = vectorPairs.at(1) else return ()

    let Some { value as indexedPair } = vectorIndexed.at(2) else return ()

    let (firstLeft, firstRight) = firstPair
    let (secondLeft, secondRight) = secondPair
    let (indexedValue, indexedPos) = indexedPair

    println("vector zip", firstLeft, firstRight)
    println("vector zip", secondLeft, secondRight)
    println("vector zipWithIndex", indexedValue, indexedPos)

    values = Array(4, 5, 6)
    other = Array("x", "y")
    arrayPairs = values.zip(other)
    arrayIndexed = values.zipWithIndex()

    let (arrayLeft, arrayRight) = arrayPairs[1]
    let (arrayIndexedValue, arrayIndexedPos) = arrayIndexed[2]

    println("array zip", arrayLeft, arrayRight)
    println("array zipWithIndex", arrayIndexedValue, arrayIndexedPos)

    rangePairs = Range(10, 13).zip(["p", "q"])
    rangeIndexed = Range(7, 9).zipWithIndex()

    let Some { value as rangePair } = rangePairs.at(1) else {
        return ()
    }
    let Some { value as rangeIndexedPair } = rangeIndexed.at(1) else {
        return ()
    }
    let (rangeLeft, rangeRight) = rangePair
    let (rangeIndexedValue, rangeIndexedPos) = rangeIndexedPair

    println("range zip", rangeLeft, rangeRight)
    println("range zipWithIndex", rangeIndexedValue, rangeIndexedPos)

    var pairSum = 0
    for pair <- vectorPairs {
        let (left, right) = pair
        if right == "a" || right == "b" {
            pairSum += left
        }
    }
    println("pair sum", pairSum)

    var indexedSum = 0
    for indexed <- vectorIndexed {
        let (value, index) = indexed
        if index < 2 {
            indexedSum += value + index
        }
    }
    println("indexed sum", indexedSum)

    var arrayPairSum = 0
    for pair <- arrayPairs {
        let (left, right) = pair
        if right == "y" {
            arrayPairSum += left
        }
    }
    println("array pair sum", arrayPairSum)

    var rangePairSum = 0
    for pair <- rangePairs {
        let (left, right) = pair
        if right == "p" || right == "q" {
            rangePairSum += left
        }
    }
    println("range pair sum", rangePairSum)

    var rangeIndexSum = 0
    for indexed <- rangeIndexed {
        let (value, index) = indexed
        rangeIndexSum += value + index
    }
    println("range index sum", rangeIndexSum)
}

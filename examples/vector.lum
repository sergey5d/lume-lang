# EXPECT:
# each 1
# each 2
# each 3
# each 4
# index 1 4
# mapped 2 8
# expanded 1 14
# filtered 3 4
# fold 10
# reduce 10
# exists true
# forAll true
# sort mutates 4 4 1
# zip 2 b
# zipIndex 4 3
# at 3
# first 1
# last 4
# tail 2 4
# remove 2 3
# size 3
# spread 0 4 7 7
# fill 7 7 9
# generate 0 2 4

def main() Unit {
    items = [1, 2, 3]
    items.add(4)

    mapped = items.map(item => item * 2)
    expanded = items.flatMap(item => [item, item + 10])
    filtered = items.filter(item => item > 2)
    total = items.fold(0, (acc, item) => acc + item)
    reduced = items.reduce((left, right) => left + right)
    hasBig = items.exists(item => item > 3)
    allPositive = items.forAll(item => item > 0)

    items.forEach(item => println("each " + item))
    println("index " + items[0] + " " + items[3])

    sortable = [3, 1, 4, 2]
    sortResult = sortable.sort((left, right) => right.compareTo(left))

    zipped = items.zip(["a", "b"])
    indexed = items.zipWithIndex()
    tailItems = items.tail()

    let Some(zippedPair) = zipped.at(1) else return ()
    let Some(indexedPair) = indexed.at(3) else return ()
    let Some(first) = items.first else return ()
    let Some(last) = items.last else return ()
    let Ok { value as removed } = items.removeAt(1) else return ()

    let (zipValue, zipLabel) = zippedPair
    let (indexedValue, indexedPos) = indexedPair

    println("mapped " + (mapped.at(0) ?? 0) + " " + (mapped.at(3) ?? 0))
    println("expanded " + (expanded.at(0) ?? 0) + " " + (expanded.at(7) ?? 0))
    println("filtered " + (filtered.at(0) ?? 0) + " " + (filtered.at(1) ?? 0))
    println("fold " + total)
    println("reduce " + (reduced ?? 0))
    println("exists " + hasBig)
    println("forAll " + allPositive)
    println("sort mutates " + (sortable.at(0) ?? 0) + " " + (sortResult.at(0) ?? 0) + " " + (sortResult.at(3) ?? 0))
    println("zip " + zipValue + " " + zipLabel)
    println("zipIndex " + indexedValue + " " + indexedPos)
    println("at " + (items.at(1) ?? 0))
    println("first " + first)
    println("last " + last)
    println("tail " + (tailItems.at(0) ?? 0) + " " + (tailItems.at(2) ?? 0))
    println("remove " + removed + " " + items.size)
    println("size " + items.size)

    spreaded = [0, ...items, 5, ...[6, 7]]
    println("spread " + (spreaded.at(0) ?? 0) + " " + (spreaded.at(3) ?? 0) + " " + (spreaded.at(6) ?? 0) + " " + spreaded.size)

    filled = Vector.fill(2, 7)
    filled.add(9)
    println("fill " + filled[0] + " " + filled[1] + " " + filled[2])

    generated = Vector.generate(3, index => index * 2)
    println("generate " + generated[0] + " " + generated[1] + " " + generated[2])
}

# EXPECT:
# count 3
# item 10
# item 30
# item 50

enum MaybeInt {
    case NoneX
    case SomeX {
        value Int
    }
}

def expandPage(page [MaybeInt]) [Int] {
    extracted [Int] = []

    page.forEach { maybeValue =>
        parsed Int? = partial match maybeValue {
           case SomeX { value as x } if x > 0 => {
                x * 10
            }
        }

        if parsed.isSet() {
            extracted.append(parsed !!)
        }
    }

    extracted
}

def main() Unit {
    pages [[MaybeInt]] = [
        [ MaybeInt.SomeX(1), MaybeInt.NoneX, MaybeInt.SomeX(3) ],
        [ MaybeInt.NoneX, MaybeInt.SomeX(5) ]
    ]

    extracted [Int] = pages.flatMap(page => expandPage(page))

    println("count " + extracted.size())
    extracted.forEach(item => println("item " + item))
}

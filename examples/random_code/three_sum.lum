# EXPECT:
# case [-1,0,1,2,-1,-4]
# output [[-1,0,1],[-1,-1,2]]
# hash sample1 size 2
# hash sample1 -1 0 1
# hash sample1 -1 -1 2
# two-pointer sample1 size 2
# two-pointer sample1 -1 -1 2
# two-pointer sample1 -1 0 1
# hash sample2 size 1
# hash sample2 0 0 0
# two-pointer sample2 size 1
# two-pointer sample2 0 0 0
# 0

object Ascending with Ordering[Int] {

    compare(left Int, right Int) Int = left - right
}


object Solution {

    sol2(nums [Int]) [[Int]] {
        nums.sort(Ascending)

        res [[Int]] = []

        for i <- Range(0, nums.size()) {
            if nums[i] > 0 {
                return res
            }
            if i == 0 || nums[i - 1] != nums[i] {
                this.twoSum2(nums, i, res)
            }
        }
        res
    }

    twoSum2(nums [Int], idx Int, res [[Int]]) Unit {
        seen Set[Int] = Set()
        var j Int = idx + 1

        while j < nums.size() {
            complement = -nums[idx] - nums[j]
            if seen.contains(complement) {
                res.append([nums[idx], complement, nums[j]])
                j += 1
                while j < nums.size() && nums[j - 1] == nums[j] {
                    j += 1
                }
            } else {
                seen.add(nums[j])
                j += 1
            }
        }
    }

    twoSum(nums [Int], idx Int, res [[Int]]) Unit {
        var low Int = idx + 1
        var high Int = nums.size() - 1

        while low < high {
            sum = nums[low] + nums[high] + nums[idx]

            if sum == 0 {
                res.append([nums[idx], nums[low], nums[high]])
                low += 1
                high -= 1

                while low < high && nums[low] == nums[low - 1] {
                    low += 1
                }
            } else if sum > 0 {
                high -= 1
            } else {
                low += 1
            }
        }
    }

    threeSum(nums [Int]) [[Int]] {
        nums.sort(Ascending)

        res [[Int]] = []

        for i <- Range(0, nums.size()) {
            if nums[i] > 0 {
                return res
            }
            if i == 0 || nums[i - 1] != nums[i] {
                this.twoSum(nums, i, res)
            }
        }
        res
    }
}


printTriplets(label Str, triplets [[Int]]) Unit {
    println(label + " size " + triplets.size())
    for triplet <- triplets {
        println(label + " " + triplet[0] + " " + triplet[1] + " " + triplet[2])
    }
}

main() Int {

    solver = Solution

    sample1Hash [Int] = [-1, 0, 1, 2, -1, -4]
    sample1TwoPointers [Int] = [-1, 0, 1, 2, -1, -4]
    sample2Hash [Int] = [0, 0, 0, 0]
    sample2TwoPointers [Int] = [0, 0, 0, 0]

    println("case [-1,0,1,2,-1,-4]")
    println("output [[-1,0,1],[-1,-1,2]]")

    printTriplets("hash sample1", solver.sol2(sample1Hash))
    printTriplets("two-pointer sample1", solver.threeSum(sample1TwoPointers))
    printTriplets("hash sample2", solver.sol2(sample2Hash))
    printTriplets("two-pointer sample2", solver.threeSum(sample2TwoPointers))

    0
}

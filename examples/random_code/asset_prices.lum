module asset/price

class AssetPrices {

    assets [Str] = [
        "BTC-USD-5.0",
        "XTZ-BTC-1.2",
        "SOL-EUR-4",
        "XTZ-SOL-8"
    ]
    asset2PriceMap Map[Str, [(Str, Float)]]
}

impl AssetPrices {
    def new() {
        this.asset2PriceMap = this.makePrices()
    }

    def makePrices() Map[Str, [(Str, Float)]] {
        result Map[Str, [(Str, Float)]] = Map()

        for asset <- this.assets {

            split = asset.split("-")

            expect split.size() == 3

            println("split: " + split[0] + "-" + split[1] + "-" + split[2])

            fromAsset = split[0]
            toAsset = split[1]
            price = Float.parse(split[2])

            if !result.contains(fromAsset) {
                result.put(fromAsset, [])
            }
            expect Some(fromPrices) = result.get(fromAsset)
            fromPrices.add((split[1], price))
            
            if !result.contains(toAsset) {
                result.put(toAsset, [])
            }

            expect Some(toPrices) = result.get(toAsset)
            toPrices.add((fromAsset, price))
        }

        result
    }

    def makeResult(prices [((Str, Str), Float)]) Str {

        strings [Str] = prices.map(match {
            case ((from, to), price) => from + "->" + to + ":" + price
        })

        strings.makeStr(",")
    }

    def findPrice(currAsset Str, endAsset Str, visited Set[Str], prices [((Str, Str), Float)]) Option[[Str]] {

        permutations = try this.asset2PriceMap.get(currAsset)

        results [Str] = []

        for (toAsset, price) <- permutations {

            if visited.contains(toAsset) {
                continue
            }

            newPrices = List.from(prices)
            newPrices.add(((currAsset, toAsset), price))

            if toAsset == endAsset {
                results.add(this.makeResult(newPrices))
                continue
            }

            newVisited = Set.from(visited)
            newVisited.add(toAsset)

            priceResult = this.findPrice(toAsset, endAsset, newVisited, newPrices)

            if let Some(foundPrices) = priceResult {
                results.addAll(foundPrices)
            }
        }

        Option.when(results.nonEmpty(), results)
    }
}

def main() Unit {


    def printResults(results Option[[Str]]) = match results {
        case Some(list) => list.forEach { elem ->
            println("result: " + elem)
        }
        case None => ()
    }

    prices = AssetPrices()

    results = prices.findPrice("XTZ", "USD", Set("XTZ"), [])

    printResults(results)

    println("next: ")

    results2 = prices.findPrice("XTZ", "EUR", Set("XTZ"), [])

    printResults(results2)

}

# EXPECT:
# split: BTC-USD-5.0
# split: XTZ-BTC-1.2
# split: SOL-EUR-4
# split: XTZ-SOL-8
# result: XTZ -> BTC at 1.2,BTC -> USD at 5.0
# next: 
# result: XTZ -> SOL at 8.0,SOL -> EUR at 4.0

module asset/price

class AssetPrices {

    assets [Str] = [
        "BTC-USD-5.0",
        "XTZ-BTC-1.2",
        "SOL-EUR-4",
        "XTZ-SOL-8"
    ]
    asset2PriceMap [Str: [(Str, Float)]]
}

impl AssetPrices {
    new() {
        this.asset2PriceMap = this.makePrices()
    }

    makePrices() [Str: [(Str, Float)]] {
        result [Str: [(Str, Float)]] = []

        for asset <- this.assets {

            split = asset.split("-")

            assert(split.size() == 3)

            println("split: " + split[0] + "-" + split[1] + "-" + split[2])

            fromAsset = split[0]
            toAsset = split[1]
            let Some(price) = Float.parse(split[2]) else panic("expected price")

            if !result.contains(fromAsset) {
                result.put(fromAsset, [])
            }
            fromPrices = result.get(fromAsset) !!
            fromPrices.add((split[1], price))
            
            if !result.contains(toAsset) {
                result.put(toAsset, [])
            }

            let toPrices <- result.get(toAsset) else panic("expected destination price list")
            toPrices.add((fromAsset, price))
        }

        result
    }

    makeResult(prices [((Str, Str), Float)]) Str {
        strings [Str] = prices.map(entry => match entry {
            case ((from, to), price) => from + " -> " + to + " at " + price
        })

        strings.makeStr(",")
    }

    findPrice(currAsset Str, endAsset Str, visited Set[Str], prices [((Str, Str), Float)]) Option[[Str]] {

        permutations = try this.asset2PriceMap.get(currAsset)

        results [Str] = []

        for permutation <- permutations {
            let (toAsset, price) = permutation

            if visited.contains(toAsset) {
                continue
            }

            newPrices = Vector.from(prices)
            newPrices.add(((currAsset, toAsset), price))

            if toAsset == endAsset {
                results.add(this.makeResult(newPrices))
                continue
            }

            newVisited = Set.from(visited)
            newVisited.add(toAsset)

            priceResult = this.findPrice(toAsset, endAsset, newVisited, newPrices)

            if let Some(foundPrices) = priceResult {
                results.addAll(foundPrices)
            }
        }

        Option.when(results.nonEmpty(), results)
    }
}

main() {

    printResults(results Option[[Str]]) = match results {
        case Some(list) => list.forEach { elem =>
            println("result: " + elem)
        }
        case None => ()
    }

    prices = AssetPrices {}

    results = prices.findPrice("XTZ", "USD", Set("XTZ"), [])

    printResults(results)

    println("next:")

    results2 = prices.findPrice("XTZ", "EUR", Set("XTZ"), [])

    printResults(results2)

}

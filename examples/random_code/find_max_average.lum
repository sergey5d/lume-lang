# EXPECT:
# 12.75
# 0

def findMaxAverage(nums Array[Float], k Int) Float {
    if nums.size() < k {
        return -1.
    }

    var total Float = 0.
    var divisor Float = 0.

    for idx <- Range(0, k) {
        total += nums[idx]
        divisor += 1.
    }

    var maxTotal Float = total
    numsLen Int = nums.size()

    for idx <- Range(k, numsLen) {
        total += nums[idx] - nums[idx - k]
        if total > maxTotal {
            maxTotal += total - maxTotal
        }
    }

    return maxTotal / divisor
}

def main() Int {
    nums Array[Float] = Array(1., 12., -5., -6., 50., 3.)

    println(findMaxAverage(nums, 4))
    0
}

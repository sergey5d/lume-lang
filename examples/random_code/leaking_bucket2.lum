
class Bucket {
    capacity Int
    var currentLevel Int = 0
    rate Int = 10
    var time Int = 0
}

impl Bucket {

    def drain(now Int) {

        elapsed = now - this.time

        if (elapsed <= 0) {
            return
        }

        toRemove = elapsed * this.rate

        if this.currentLevel < toRemove {
            this.currentLevel := 0
        } else {
            this.currentLevel -= toRemove
        }
        this.time := now
    }

    def allow(now Int, tokens Int) Bool {

        this.drain(now)

        withTokens = tokens + this.currentLevel

        if withTokens > this.capacity {
            return false
        }

        this.currentLevel += tokens

        return true
    }
}

def main() {

    testData = [0:1, 0:10, 0:5, 1:4, 1:2, 1:10]

    bucket = Bucket { capacity = 10 }

    testData.forEach { tuple ->
        let (x, y) = tuple
        res = bucket.allow(x, y)
        if res {
            printf("allowed for %d-%d\n", x, y)
        } else {
            printf("disallowed for %d-%d\n", x, y)
        }
    }
}

# EXPECT:
# true
# false
# 0

canVisitAllRooms(rooms [[Int]]) Bool {

    let Some(startKeys) = rooms.get(0) else return true

    seen = Set(0)
    keys [Int] = []

    for key <- startKeys {
        keys.append(key)
    }

    while keys.size() != 0 {

        key = keys.remove(0).getOr(-1)

        if !seen.contains(key) {
            let Some(roomKeys) = rooms.get(key) else return false

            for roomKey <- roomKeys {
                keys.append(roomKey)
            }

            seen.add(key)
        }
    }

    return seen.size() == rooms.size()
}

main() Int {
    emptyRoom [Int] = []

    reachable [[Int]] = [
        [1],
        [2],
        [3],
        emptyRoom
    ]

    blocked [[Int]] = [
        [1, 3],
        [3, 0, 1],
        [2],
        [0]
    ]

    println(canVisitAllRooms(reachable))
    println(canVisitAllRooms(blocked))
    0
}

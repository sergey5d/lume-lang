# EXPECT:
# sample1 0
# sample2 1
# sample3 0
# low -1
# high 2
# 0

evalPoints(total Int, lower Int, upper Int) Int {
    if total < lower {
        return -1
    } else if total > upper {
        return 1
    }

    0
}

dietPlanPerformance(calories [Int], k Int, lower Int, upper Int) Int {
    var window Int = 0
    var acc Int = 0

    while window < k {
        acc += calories[window]
        window += 1
    }

    var start Int = 0
    var points Int = evalPoints(acc, lower, upper)

    while window < calories.size() {
        acc += calories[window]
        acc -= calories[start]
        start += 1

        points += evalPoints(acc, lower, upper)
        window += 1
    }

    points
}

main() Int {
    println("sample1", dietPlanPerformance([1, 2, 3, 4, 5], 1, 3, 3))
    println("sample2", dietPlanPerformance([3, 2], 2, 0, 1))
    println("sample3", dietPlanPerformance([6, 5, 0, 0], 2, 1, 5))
    println("low", dietPlanPerformance([1, 1, 1], 3, 5, 10))
    println("high", dietPlanPerformance([10, 10, 1], 2, 5, 9))

    0
}

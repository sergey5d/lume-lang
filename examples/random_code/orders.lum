
class Order {
    id Int
    buySell Str
    asset Str
    var quantity Int
    fills [Int]
    var status Str
    var lastUpdated Int
}

class OrderManager {
    hidden map [Int: Order] = []
    hidden var currentTick Int = 0
    hidden queue [Order] = []

    def parseOrder(str Str) Order? {

        arr = str.split("\s*,\s*")

        assert(arr.size() == 5)

        id = try Int.parse(arr[0])

        buySell = arr[1]
        asset = arr[2]

        let quantity <- Int.parse(arr[3]) else panic("expected quantity")

        status = arr[4]

        Some(
            Order {
                id: id, asset: asset, buySell: buySell, quantity: quantity, fills: [], status: status, lastUpdated: this.currentTick
            }
        )
    }

    def checkQueuedOrders() {
        while !this.queue.isEmpty() {
            first = this.queue[0]
            if first.status == "NEW" {
                if first.lastUpdated - this.currentTick > 5 {
                    first.status := "CANCELLED"
                    this.queue.removeFirst()
                } else {
                    break
                }
            } else {
                this.queue.removeFirst()
            }
        }
    }

    def handleOrder(str Str) {

        this.currentTick += 1

        checkQueuedOrders()

        let Some(parsedOrder) = parseOrder(str) else panic("expected order")

        savedOrder = this.map.get(parsedOrder.id)

        if !savedOrder.isSet() {
            this.map.put(parsedOrder.id, parsedOrder)
        }

        order = savedOrder.getOr(parsedOrder)

        match parsedOrder.status {
            case "NEW" =>
                # the only thing here is to update quantity, the rest will be propagated by other order types
                order.quantity := parsedOrder.quantity
            case "FILL" => {
                order.fills.add(parsedOrder.quantity)
                if order.quantity != 0 {
                    totalFills = order.fills.reduce(0, (f1, f2) => f1 + f2)
                    if (totalFills == order.quantity) {
                        order.status := "FILLED"
                    } else {
                        order.status := "IN_PROGRESS"
                    }
                } else {
                    order.status := "IN_PROGRESS"
                }
            }
            case "CANCEL" => {
                if order.status == "FILLED" || order.status == "IN_PROGRESS" {
                    println("attempt to cancel filled order " + order.id)
                } else {
                    order.status := "NEW"
                    this.queue.add(order)
                }
                order.lastUpdated := this.currentTick
            }
        }
    }

    def testOrders() [Str] {

        orders = [
            "1234, BUY, BTC, 10, NEW",
            "1234, BUY, BTC, 1, FILL",
            "1234, BUY, BTC, 5, FILL",
            "1254, SELL, ETH, 20, NEW",
            "1254, SELL, ETH, 20, FILL",
            "1254, SELL, ETH, 20, CANCEL",
        ]
        orders
    }
}


def main() {

    manager = OrderManager {}

    orders = manager.testOrders()

    for order <- orders {
        manager.handleOrder(order)
    }

    for id <- [1234, 1254] {
        let Some(order) = manager.map.get(id) else panic("expected saved order")
        println("order: " + order)
    }

}

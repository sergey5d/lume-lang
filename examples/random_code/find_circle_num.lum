# EXPECT:
# uf 2
# dfs 2
# same true
# uf2 3
# dfs2 3
# same2 true
# 0

class DisjointSet {
    hidden var arr Array[Int]
}

impl DisjointSet {

    new {
        size Int
    } {
        this.arr = Array.generate(size, i -> i)
    }

    def findParent(v Int) Int {
        var current Int = v
        while this.arr[current] != current {
            current := this.arr[current]
        }
        return current
    }

    def union(v1 Int, v2 Int) {
        v1SelfParent = this.arr[v1] == v1
        v2SelfParent = this.arr[v2] == v2

        if v1SelfParent && v2SelfParent {
            this.arr[v2] := v1
        } else if v1SelfParent {
            this.arr[v1] := this.arr[v2]
        } else if v2SelfParent {
            this.arr[v2] := this.arr[v1]
        } else {
            v1Parent = this.findParent(v1)
            v2Parent = this.findParent(v2)
            if v1Parent != v2Parent {
                this.arr[v1Parent] := v2Parent
            }
        }
    }
}

def findCircleNumUnion(isConnected List[List[Int]]) Int {
    set = DisjointSet { isConnected.size() }

    for i <- Range(0, isConnected.size()) {
        row = isConnected[i]
        for j <- Range(0, row.size()) {
            if i != j && row[j] != 0 {
                set.union(i, j)
            }
        }
    }

    parentSet Set[Int] = Set()

    for i <- Range(0, isConnected.size()) {
        parentSet.add(set.findParent(i))
    }

    return parentSet.size()
}

def findCircleNumTraversal(isConnected List[List[Int]]) Int {
    directConns Array[Set[Int]] = Array.generate(isConnected.size(), idx -> Set())

    for i <- Range(0, isConnected.size()) {
        row = isConnected[i]
        for j <- Range(0, row.size()) {
            if i != j && row[j] != 0 {
                directConns[i].add(j)
                directConns[j].add(i)
            }
        }
    }

    var areaCount Int = 0
    visitedAll Set[Int] = Set()

    for i <- Range(0, isConnected.size()) {
        if !visitedAll.contains(i) {
            areaCount += 1

            stack List[Int] = List(i)

            while stack.size() != 0 {
                idx = stack.remove(stack.size() - 1).getOr(-1)
                if !visitedAll.contains(idx) {
                    visitedAll.add(idx)
                    directConns[idx].forEach(next -> stack.append(next))
                }
            }
        }
    }

    return areaCount
}

def main() Int {
    connected1 List[List[Int]] = List(
        List(1, 1, 0),
        List(1, 1, 0),
        List(0, 0, 1)
    )

    connected2 List[List[Int]] = List(
        List(1, 0, 0),
        List(0, 1, 0),
        List(0, 0, 1)
    )

    uf1 = findCircleNumUnion(connected1)
    dfs1 = findCircleNumTraversal(connected1)
    uf2 = findCircleNumUnion(connected2)
    dfs2 = findCircleNumTraversal(connected2)

    println("uf " + uf1)
    println("dfs " + dfs1)
    println("same " + (uf1 == dfs1))
    println("uf2 " + uf2)
    println("dfs2 " + dfs2)
    println("same2 " + (uf2 == dfs2))
    0
}

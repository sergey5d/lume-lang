# EXPECT:
# valid0 true
# loc0 0:0
# valid1 true
# loc1 0:2
# valid2 true
# loc2 0:2
# valid3 true
# loc3 1:1
# valid4 false
# loc4 -1:-1
# to be or not to be:
# document: 0
# document: 1
# document: 2
# 0

class Location {
    docId Int
    position Int
}

class Cursor {
    hidden term Str
    hidden documents [Str]
    hidden var current Location
    hidden var valid Bool = false

    new(term Str, documents [Str]) {
        this.term = term
        this.documents = documents
        this.current = Location(-1, -1)
        this.valid = false
        this.seek(Location(-1, -1))
    }

    isValid() Bool = this.valid

    get() Location = this.current

    advance() Unit {
        if this.valid {
            this.seek(Location(this.current.docId, this.current.position + 1))
        }
    }

    seek(location Location) Unit {
        var docId Int = 0
        var found Bool = false

        if location.docId >= 0 {
            docId := location.docId
        }

        while docId < this.documents.size() && !found {
            docTerms Array[Str] = this.documents[docId].split(" ")
            var pos Int = 0

            if docId == location.docId && location.position >= 0 {
                pos := location.position
            }

            while pos < docTerms.size() && !found {
                if docTerms[pos] == this.term {
                    this.current := Location(docId, pos)
                    this.valid := true
                    found := true
                }
                if !found {
                    pos += 1
                }
            }

            if !found {
                docId += 1
            }
        }

        if !found {
            this.current := Location(-1, -1)
            this.valid := false
        }
    }
}


toBeOrNotToBe() Unit {

    documents [Str] = [
        "to be",
        "to to be be",
        "to be to be",
        "to to be",
        "be to",
        "to be be to"
    ]

    println("to be or not to be:")

    c1 = Cursor("to", documents)
    c2 = Cursor("be", documents)
    result [Int] = []

    while c1.isValid() && c2.isValid() {
        loc1 = c1.get()
        loc2 = c2.get()

        if loc1.docId > loc2.docId {
            c2.seek(Location(loc1.docId, 0))
        } else if loc1.docId < loc2.docId {
            c1.seek(Location(loc2.docId, 0))
        } else {
            docId = loc1.docId

            var balance Int = 0
            var previousPosition Int = -1
            var valid = true

            while true {

                c1InDocument = c1.isValid() && c1.get().docId == docId
                c2InDocument = c2.isValid() && c2.get().docId == docId

                if !c1InDocument && !c2InDocument {
                    break
                }

                var position Int = -1

                if c1InDocument && (!c2InDocument || c1.get().position < c2.get().position) {
                    position := c1.get().position
                    balance += 1
                    c1.advance()
                } else {
                    position := c2.get().position
                    balance -= 1
                    if balance < 0 {
                        valid := false
                    }
                    c2.advance()
                }

                if previousPosition >= 0 && position != previousPosition + 1 {
                    valid := false
                }
                previousPosition := position

                if !valid {
                    c1.seek(Location(docId + 1, 0))
                    c2.seek(Location(docId + 1, 0))
                    break
                }
            }

            if valid && balance == 0 {
                result.append(docId)
            }
        }
    }

    for res <- result {
        println("document: " + res)
    }
}

main() Int {
    documents [Str] = [
        "cat dog cat",
        "bird cat",
        "dog"
    ]

    cursor = Cursor("cat", documents)

    println("valid0 " + cursor.isValid())
    loc0 = cursor.get()
    println("loc0 " + loc0.docId + ":" + loc0.position)

    cursor.advance()
    println("valid1 " + cursor.isValid())
    loc1 = cursor.get()
    println("loc1 " + loc1.docId + ":" + loc1.position)

    cursor.seek(loc1)
    println("valid2 " + cursor.isValid())
    loc2 = cursor.get()
    println("loc2 " + loc2.docId + ":" + loc2.position)

    cursor.advance()
    println("valid3 " + cursor.isValid())
    loc3 = cursor.get()
    println("loc3 " + loc3.docId + ":" + loc3.position)

    cursor.advance()
    println("valid4 " + cursor.isValid())
    loc4 = cursor.get()
    println("loc4 " + loc4.docId + ":" + loc4.position)

    toBeOrNotToBe()

    0
}

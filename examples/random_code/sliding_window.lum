# EXPECT:
# time 0 cost 3 allowed true usage 3
# time 0 cost 2 allowed true usage 5
# time 0 cost 1 allowed false usage 5
# time 2 cost 2 allowed false usage 5
# time 5 cost 2 allowed true usage 2
# time 6 cost 4 allowed false usage 2
# time 7 cost 3 allowed true usage 5

# A sliding-window limiter remembers accepted requests that still fall inside
# the current time window. Old requests fall out of the window all at once.
shape WindowRequest {
    time Int
    cost Int
}

class SlidingWindowLimiter {
    hidden capacity Int
    hidden windowSize Int
    hidden accepted LinkedList[WindowRequest]

    new(capacity Int, windowSize Int) {
        this.capacity = capacity
        this.windowSize = windowSize
        this.accepted = LinkedList {}
    }

    prune(now Int) Unit {
        # Keep only requests whose timestamp still belongs to the active window.
        windowStart = now - this.windowSize

        while !this.accepted.isEmpty() {
            request = this.accepted.at(0) !!
            if request.time <= windowStart {
                this.accepted.removeFirst()
            } else {
                break
            }
        }
    }

    usedInWindow(now Int) Int {
        this.prune(now)
        total Int = this.accepted.fold(0, (x, y) => x + y.cost)
        total
    }

    allow(now Int, cost Int) Bool {
        # First drop requests that are no longer inside the sliding window.
        this.prune(now)

        used Int = this.usedInWindow(now)

        if this.capacity - cost >= used {
            this.accepted.add(WindowRequest { time: now, cost: cost })
            true
        } else {
            false
        }
    }

    currentUsage(now Int) Int = this.usedInWindow(now)
}


main() Unit {
    # Capacity 5 over a 5-tick sliding window.
    bucket = SlidingWindowLimiter(5, 5)

    # Each request carries construction fields instead of a positional tuple.
    requests [WindowRequest] = [
        WindowRequest { time: 0, cost: 3 },
        WindowRequest { time: 0, cost: 2 },
        WindowRequest { time: 0, cost: 1 },
        WindowRequest { time: 2, cost: 2 },
        WindowRequest { time: 5, cost: 2 },
        WindowRequest { time: 6, cost: 4 },
        WindowRequest { time: 7, cost: 3 },
    ]

    for request <- requests {
        allowed = bucket.allow(request.time, request.cost)
        # Show whether the request passed and how much window usage remains live.
        println("time", request.time, "cost", request.cost, "allowed", allowed, "usage", bucket.currentUsage(request.time))
    }
}

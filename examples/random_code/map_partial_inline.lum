# EXPECT:
# first 20
# second true
# third 60

enum MaybeInt {
    case NoneX
    case SomeX {
        value Int
    }
}

def main() Unit {
    values [MaybeInt] = [
        MaybeInt.SomeX(2),
        MaybeInt.NoneX,
        MaybeInt.SomeX(6)
    ]

    extracted [Int?] = values.map(value => partial match value {
        case SomeX(x) => x * 10
        }
    )

    let Some(first) = extracted.at(0) else return ()
    let Some(second) = extracted.at(1) else return ()
    let Some(third) = extracted.at(2) else return ()

    println("first " + first.getOr(0))
    println("second " + second.isEmpty())
    println("third " + third.getOr(0))
}

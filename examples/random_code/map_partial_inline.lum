# EXPECT:
# first 20
# second true
# third 60

enum MaybeInt {
    case NoneX
    case SomeX {
        value Int
    }
}

def main() Unit {
    values [MaybeInt] = [
        MaybeInt.SomeX(2),
        MaybeInt.NoneX,
        MaybeInt.SomeX(6)
    ]

    extracted [Int?] = values.map(value => partial match value {
        case SomeX(x) => x * 10
    })

    first = extracted.at(0) ?? return ()
    second = extracted.at(1) ?? return ()
    third = extracted.at(2) ?? return ()

    println("first " + first.getOr(0))
    println("second " + second.isEmpty())
    println("third " + third.getOr(0))
}

# EXPECT:
# first 20
# second true
# third 60

enum MaybeInt {
    case NoneX
    case SomeX {
        value Int
    }
}

def main() Unit {
    values List[MaybeInt] = List(
        MaybeInt.SomeX(2),
        MaybeInt.NoneX,
        MaybeInt.SomeX(6)
    )

    extracted List[Option[Int]] = values.map(value => partial match value {
        case SomeX(x) => x * 10
        }
    )

    let Some(first) = extracted.get(0) else return ()
    let Some(second) = extracted.get(1) else return ()
    let Some(third) = extracted.get(2) else return ()

    println("first " + first.getOr(0))
    println("second " + second.isEmpty())
    println("third " + third.getOr(0))
}

# EXPECT:
# we are done

class Window {
    var count Int
    start Int
}

class FixedWindowRateLimiter {

    hidden map [Str: Window] = []
    hidden windowSize Int
    hidden limit Int

    new(windowSize Int, limit Int) = {
        this.windowSize = windowSize
        this.limit = limit
    }

    def allow(now Int, id Str) Bool = {

        windowStart = now / windowSize

        if let window <- map[id] && window.start == windowStart {
            if window.count <= limit {
                window.count += 1
            }                    
            return window.count <= limit
        }
        map[id] := Window { count: 1, start: windowStart }

        true
    }

    def reset() = {
        map.clear()
    }
}

def main() = {

    limiter = FixedWindowRateLimiter { windowSize: 5, limit: 5 }

    for i <- Range(0, 5) {
        if !limiter.allow(1, "4") {
            println("unexpected not allow")
        }
    }

    allowed = limiter.allow(2, "4")

    if allowed {
        println("unexpected allowance")
    }

    println("we are done")
}

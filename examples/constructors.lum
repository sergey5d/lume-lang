# EXPECT:
# profile Ada 2 true
# profile bumped 3
# stock 7
# slots 10 20
# account Ada 10
# account Bob 11
# account Eve 0
# account Nia 0
# account unknown 12
# path 3 usr
# path named 2 etc
# path default 1 default

# Constructor rule summary:
# - direct `this.field = ...` inside `new` means constructor initialization
# - constructor setup may write the same mutable field more than once with `=`
# - later field mutation uses `:=`
# - nested writes through an initialized field still use `:=`
# - constructor parameters and construction fields may be comma separated
# - `new(...)` delegates to another constructor positionally
# - `new { field: value }` delegates to another constructor by construction fields
# - positional construction fills constructor parameters from the beginning in order
# - named construction can omit any constructor parameter that has a default
# - a trailing `vararg items [T]` constructor parameter receives positional varargs as `[T]`
# - construction fields can pass a vararg as a single `[T]` value
# - defaulted varargs are used when the vararg is omitted

class Profile {
    name Str = "unknown"
    hidden var visits Int = 0
    hidden var active Bool = false
}

impl Profile {
    new(name Str, visits Int) {
        this.name = name
        this.visits = 0
        this.visits = visits
        this.active = true
    }

    def bump() Unit {
        this.visits := this.visits + 1
    }

    def visitCount() Int = this.visits

    def isActive() Bool = this.active
}

class Stock {
    hidden count Int = 5
}

impl Stock {
    new(count Int) {
        this.count = count
    }

    def value() Int = this.count
}

class Slots {
    hidden var items Array[Int]
}

impl Slots {
    new(left Int, right Int) {
        this.items = Array(left, right)
    }

    def left() Int = this.items[0]

    def right() Int = this.items[1]
}

class Account {
    name Str
    age Int
}

impl Account {
    new(name Str, age Int = 0) {
        this.name = name
        this.age = age
    }

    new(label Str) = new {
        name: label
        age: 0
    }

    new(years Int) = new("unknown", years)

    def label() Str = this.name + " " + this.age
}

class Path {
    segments [Str]
}

impl Path {
    new(vararg segments [Str] = ["default"]) {
        this.segments = segments
    }

    def size() Int = this.segments.size()

    def firstOr(value Str) Str = this.segments.get(0).getOr(value)
}

def main() Unit {
    profile = Profile("Ada", 2)
    println("profile", profile.name, profile.visitCount(), profile.isActive())

    profile.bump()
    println("profile bumped", profile.visitCount())

    stock = Stock(7)
    println("stock", stock.value())

    slots = Slots(10, 20)
    println("slots", slots.left(), slots.right())

    namedAccount = Account { name: "Ada", age: 10 }
    positionalAccount = Account("Bob", 11)
    defaultAccount = Account { name: "Eve" }
    namedDelegatedAccount = Account { label: "Nia" }
    positionalDelegatedAccount = Account { years: 12 }
    println("account", namedAccount.label())
    println("account", positionalAccount.label())
    println("account", defaultAccount.label())
    println("account", namedDelegatedAccount.label())
    println("account", positionalDelegatedAccount.label())

    path Path = Path("usr", "local", "bin")
    println("path", path.size(), path.firstOr("?"))
    namedPath Path = Path { segments: ["etc", "hosts"] }
    println("path named", namedPath.size(), namedPath.firstOr("?"))
    defaultPath Path = Path()
    println("path default", defaultPath.size(), defaultPath.firstOr("?"))
}

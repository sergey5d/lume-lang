# EXPECT:
# 15
# 16
# 31
# 0

fn main() Int {
    base = 10

    fn add(left Int, right Int) Int {
        left + right + base
    }

    fn double(value Int) Int = value * 2

    println(add(2, 3))
    println(double(8))

    fn combine(value Int) Int {
        fn bump(amount Int) Int = amount + 1
        add(bump(value), double(5))
    }

    println(combine(10))
    0
}

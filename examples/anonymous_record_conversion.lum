# EXPECT:
# class Ada 10
# public Ben 12 NYC
# vars 3 4
# full Nora 20 Paris
# mixed Liam 8 5
# mixed3 Liam 8 5

class User {
    name Str
    age Int
}

class Person {
    name Str
    age Int
    city Str = "NYC"
}

class MutablePoint {
    var x Int
    var y Int
}

class SecretBadge {
    name Str
    hidden code Int
}

impl SecretBadge {
    def new(name Str) {
        this.name = name
        this.code = 99
    }

    def codeValue() Int = this.code
}

class MixedProfile {
    name Str
    age Int
    hidden score Int = 5
}

impl MixedProfile {
    def scoreValue() Int = this.score
}

def main() Unit {
    userRecord = class {
        name = "Ada"
        age = 10
    }
    user User = User {
        name = userRecord.name
        age = userRecord.age
    }

    person Person = Person { "Ben", 12 }

    pointRecord = class {
        x = 3, y = 4
    }
    point MutablePoint = MutablePoint {
        x = pointRecord.x
        y = pointRecord.y
    }

    fullPerson Person = Person {
        name = "Nora"
        age = 20
        city = "Paris"
    }

    profile MixedProfile = MixedProfile {
        name = "Liam"
        age = 8
    }

    profile3 MixedProfile = MixedProfile {
        name = "Liam", age = 8
    }

    OS.println("class", user.name, user.age)
    OS.println("public", person.name, person.age, person.city)
    OS.println("vars", point.x, point.y)
    OS.println("full", fullPerson.name, fullPerson.age, fullPerson.city)
    OS.println("mixed", profile.name, profile.age, profile.scoreValue())
    OS.println("mixed3", profile3.name, profile3.age, profile3.scoreValue())
}

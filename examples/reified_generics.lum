# EXPECT:
# User
# User
# User
# 0

class User {
    name Str
}

typeName[reified A](value A) Str =
    typeOf[A].name() !!

class Inspector {
}

impl Inspector {
    valueTypeName[reified A](value A) Str =
        typeOf[A].name() !!

    namedTypeName[reified A]() Str =
        typeOf[A].name() !!
}

main() Int {
    user User = User { name: "Ada" }
    inspector Inspector = Inspector {}

    println(typeName(user))
    println(inspector.valueTypeName(user))
    println(inspector.namedTypeName[User]())
    0
}

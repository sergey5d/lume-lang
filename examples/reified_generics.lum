# EXPECT:
# User
# User
# User
# 0

class User {
    name Str
}

fn typeName[reified A](value A) Str =
    typeOf[A].name !

class Inspector {

    fn valueTypeName[reified A](value A) Str =
        typeOf[A].name !

    fn namedTypeName[reified A]() Str =
        typeOf[A].name !
}


fn main() Int {
    user User = User { name: "Ada" }
    inspector Inspector = Inspector {}

    println(typeName(user))
    println(inspector.valueTypeName(user))
    println(inspector.namedTypeName[User]())
    0
}

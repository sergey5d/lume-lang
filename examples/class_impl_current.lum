# SKIP
#
# Current inline class-method shape, kept as a comparison artifact against the
# separated `class` + `impl` examples.

class Person with Named, Aged {
    firstName Str
    lastName Str
    age Int
    city Str

    hidden var archived Bool = false
    hidden var internalScore Int = 0

    new {
        fullName Str
        age Int
        city Str
    } {
        parts = fullName.split(" ")
        this.firstName = parts.get(0).getOr("")
        this.lastName = parts.get(1).getOr("")
        this.age = age
        this.city = city
    }

    new {
        firstName Str
        lastName Str
    } {
        this.firstName = firstName
        this.lastName = lastName
        this.age = 18
        this.city = "unknown"
    }

    def fullName() Str = this.firstName + " " + this.lastName

    def isAdult() Bool = this.age >= 18

    def moveTo(newCity Str) Unit {
        this.city := newCity
    }

    def celebrateBirthday() Unit {
        this.age += 1
        this.internalScore += 10
    }

    def archive() Unit {
        this.archived := true
    }

    def debugLabel() Str =
        fullName() + "@" + this.city + ":" + this.age + ":" + this.internalScore + ":" + this.archived
}

# EXPECT:
# brace named Sammy 15 NYC
# brace positional Ben 12 Paris
# brace hidden Liam 8 5
# brace hidden-third Ada 4 7
# ctor alt 6 5
# ctor manual 5 Bobby

# Class construction rules in one place:
# - classes without explicit `new` use brace construction
# - positional braces follow public field order
# - trailing public defaults may be omitted
# - hidden defaulted fields may trail public fields and stay out of the shape
# - explicit `new` uses the same brace call syntax as structural construction
# - explicit `new` can define defaulted trailing parameters

class Profile {
    name Str
    age Int
    city Str = "NYC"
    hidden score Int = 5
}

impl Profile {
    def scoreValue() Int = this.score
}

class HiddenTail {
    name Str
    level Int
    hidden bonus Int = 7
}

impl HiddenTail {
    def bonusValue() Int = this.bonus
}

class A {
    age Int
    name Str

    hidden var malnutritioned Bool = false
}

impl A {
    new {
        age Int
        name Str
    } {
        this.age = age
        this.name = name
    }

    new {
        maturity Int
    } = new { maturity - 15, "5" }

    def trueAge() Int = this.age

    def trueName() Str = this.name
}

class B {
    hidden age Int
    hidden name Str
    hidden var malnutritioned Bool = false
    hidden var unassigned Float
    hidden questionable Int
}

impl B {
    new {
        age Int
        name Str = "Bobby"
    } {
        this.age = age
        this.name = name
        this.unassigned = 1.1
        this.questionable = 1
    }

    def trueAge() Int = this.age

    def trueName() Str = this.name
}

def main() Unit {
    named Profile = Profile {
        name: "Sammy"
        age: 15
    }
    positional Profile = Profile { "Ben", 12, "Paris" }
    hiddenDefault Profile = Profile { "Liam", 8 }
    hiddenThird HiddenTail = HiddenTail { "Ada", 4 }

    aFromAlt A = A { maturity: 21 }
    bManual B = B { 5 }

    println("brace named", named.name, named.age, named.city)
    println("brace positional", positional.name, positional.age, positional.city)
    println(
        "brace hidden",
        hiddenDefault.name,
        hiddenDefault.age,
        hiddenDefault.scoreValue()
    )
    println(
        "brace hidden-third",
        hiddenThird.name,
        hiddenThird.level,
        hiddenThird.bonusValue()
    )
    println("ctor alt", aFromAlt.trueAge(), aFromAlt.trueName())
    println("ctor manual", bManual.trueAge(), bManual.trueName())
}

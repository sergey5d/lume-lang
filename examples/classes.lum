# EXPECT:
# brace fields Sammy 15 NYC
# positional Ben 12 Paris
# positional private Liam 8 5
# positional private-third Ada 4 7
# ctor alt 6 5
# ctor manual 5 Bobby

# Class construction rules in one place:
# - classes without explicit `new` support brace field construction and positional parentheses
# - positional construction follows public field order
# - trailing public defaults may be omitted
# - initialized non-public fields stay out of the constructor regardless of position
# - explicit `new` supports brace field construction and positional parentheses
# - constructor defaults may appear anywhere, but positional calls never skip over them

class Profile {
    name Str
    private score Int = 5
    age Int
    city Str = "NYC"

    def scoreValue() Int = this.score
}


class PrivateTail {
    name Str
    level Int
    private bonus Int = 7

    def bonusValue() Int = this.bonus
}


class A {
    age Int
    name Str

    private var malnutritioned Bool = false

    new(age Int, name Str) {
        this.age = age
        this.name = name
    }

    new(maturity Int) = this(maturity - 15, "5")

    def trueAge() Int = this.age

    def trueName() Str = this.name
}


class B {
    private age Int
    private name Str
    private var malnutritioned Bool = false
    private var unassigned Float
    private questionable Int

    new(age Int, name Str = "Bobby") {
        this.age = age
        this.name = name
        this.unassigned = 1.1
        this.questionable = 1
    }

    def trueAge() Int = this.age

    def trueName() Str = this.name
}


def main() Unit {
    named Profile = Profile {
        name: "Sammy"
        age: 15
    }
    positional Profile = Profile("Ben", 12, "Paris")
    privateDefault Profile = Profile("Liam", 8)
    privateThird PrivateTail = PrivateTail("Ada", 4)

    aFromAlt A = A { maturity: 21 }
    bManual B = B(5)

    println("brace fields", named.name, named.age, named.city)
    println("positional", positional.name, positional.age, positional.city)
    println(
        "positional private",
        privateDefault.name,
        privateDefault.age,
        privateDefault.scoreValue()
    )
    println(
        "positional private-third",
        privateThird.name,
        privateThird.level,
        privateThird.bonusValue()
    )
    println("ctor alt", aFromAlt.trueAge(), aFromAlt.trueName())
    println("ctor manual", bManual.trueAge(), bManual.trueName())
}

# EXPECT:
# brace named Sammy 15 NYC
# brace positional Ben 12 Paris
# brace hidden Liam 8 5
# brace hidden-third Ada 4 7
# ctor alt 6 5
# ctor manual 5 Bobby

# Class construction rules in one place:
# - classes without explicit `new` use brace construction
# - positional braces follow public field order
# - trailing public defaults may be omitted
# - hidden defaulted fields may trail public fields and stay out of the shape
# - any explicit `new` disables brace-based construction for that class

class Profile {
    name Str
    age Int
    city Str = "NYC"
    hidden score Int = 5
}

impl Profile {
    def scoreValue() Int = score
}

class HiddenTail {
    name Str
    level Int
    hidden bonus Int = 7
}

impl HiddenTail {
    def bonusValue() Int = bonus
}

class A {
    age Int
    name Str

    hidden var malnutritioned Bool = false
}

impl A {
    def new(age Int, name Str) {
        this.age = age
        this.name = name
    }

    def new(maturity Int) = new(maturity - 15, "5")

    def trueAge() Int = age

    def trueName() Str = name
}

class B {
    hidden age Int
    hidden name Str
    hidden var malnutritioned Bool = false
    hidden var unassigned Float
    hidden questionable Int = ?
}

impl B {
    def new(age Int, name Str) {
        this.age = age
        this.name = name
        this.unassigned := 1.1
        this.questionable = 1
    }

    def trueAge() Int = age

    def trueName() Str = name
}

def main() Unit {
    named Profile = Profile {
        name = "Sammy"
        age = 15
    }
    positional Profile = Profile { "Ben", 12, "Paris" }
    hiddenDefault Profile = Profile { "Liam", 8 }
    hiddenThird HiddenTail = HiddenTail { "Ada", 4 }

    aFromAlt A = A(maturity = 21)
    bManual B = B(5, "Bobby")

    OS.println("brace named", named.name, named.age, named.city)
    OS.println("brace positional", positional.name, positional.age, positional.city)
    OS.println(
        "brace hidden",
        hiddenDefault.name,
        hiddenDefault.age,
        hiddenDefault.scoreValue()
    )
    OS.println(
        "brace hidden-third",
        hiddenThird.name,
        hiddenThird.level,
        hiddenThird.bonusValue()
    )
    OS.println("ctor alt", aFromAlt.trueAge(), aFromAlt.trueName())
    OS.println("ctor manual", bManual.trueAge(), bManual.trueName())
}

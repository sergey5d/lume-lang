# EXPECT:
# brace named Sammy 15 NYC
# positional Ben 12 Paris
# positional hidden Liam 8 5
# positional hidden-third Ada 4 7
# ctor alt 6 5
# ctor manual 5 Bobby

# Class construction rules in one place:
# - classes without explicit `new` support named braces and positional parentheses
# - positional construction follows public field order
# - trailing public defaults may be omitted
# - hidden defaulted fields may trail public fields and stay out of the shape
# - explicit `new` supports named braces and positional parentheses
# - explicit `new` can define defaulted trailing parameters

class Profile {
    name Str
    age Int
    city Str = "NYC"
    hidden score Int = 5
}

impl Profile {
    def scoreValue() Int = this.score
}

class HiddenTail {
    name Str
    level Int
    hidden bonus Int = 7
}

impl HiddenTail {
    def bonusValue() Int = this.bonus
}

class A {
    age Int
    name Str

    hidden var malnutritioned Bool = false
}

impl A {
    new {
        age Int
        name Str
    } {
        this.age = age
        this.name = name
    }

    new {
        maturity Int
    } = new(maturity - 15, "5")

    def trueAge() Int = this.age

    def trueName() Str = this.name
}

class B {
    hidden age Int
    hidden name Str
    hidden var malnutritioned Bool = false
    hidden var unassigned Float
    hidden questionable Int
}

impl B {
    new {
        age Int
        name Str = "Bobby"
    } {
        this.age = age
        this.name = name
        this.unassigned = 1.1
        this.questionable = 1
    }

    def trueAge() Int = this.age

    def trueName() Str = this.name
}

def main() Unit {
    named Profile = Profile {
        name: "Sammy"
        age: 15
    }
    positional Profile = Profile("Ben", 12, "Paris")
    hiddenDefault Profile = Profile("Liam", 8)
    hiddenThird HiddenTail = HiddenTail("Ada", 4)

    aFromAlt A = A { maturity: 21 }
    bManual B = B(5)

    println("brace named", named.name, named.age, named.city)
    println("positional", positional.name, positional.age, positional.city)
    println(
        "positional hidden",
        hiddenDefault.name,
        hiddenDefault.age,
        hiddenDefault.scoreValue()
    )
    println(
        "positional hidden-third",
        hiddenThird.name,
        hiddenThird.level,
        hiddenThird.bonusValue()
    )
    println("ctor alt", aFromAlt.trueAge(), aFromAlt.trueName())
    println("ctor manual", bManual.trueAge(), bManual.trueName())
}

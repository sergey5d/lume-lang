# EXPECT:
# x
# closed
# solo

interface Reader {
    def read() Str
}

interface Closer {
    def close() Unit
}

def main() Unit {
    handler = object with Reader, Closer {
        source Str = "x"

        def read() Str = source
        def close() Unit = println("closed")
    }

    soloReader Reader = object with Reader {
        source Str = "solo"

        def read() Str = source
    }

    println(handler.read())
    handler.close()
    println(soloReader.read())
}

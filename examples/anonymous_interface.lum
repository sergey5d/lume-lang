# EXPECT:
# x
# closed
# solo

interface Reader {
    fn read() Str
}

interface Closer {
    fn close() Unit
}

fn main() Unit {
    handler = object with Reader, Closer {
        source Str = "x"

        fn read() Str = source
        fn close() Unit = println("closed")
    }

    soloReader Reader = object with Reader {
        source Str = "solo"

        fn read() Str = source
    }

    println(handler.read())
    handler.close()
    println(soloReader.read())
}

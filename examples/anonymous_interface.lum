# EXPECT:
# x
# closed
# solo

interface Reader {
    read() Str
}

interface Closer {
    close() Unit
}

main() Unit {
    handler = Reader with Closer {
        read() Str = "x"
        close() Unit = println("closed")
    }

    soloReader = Reader {
        read() Str = "solo"
    }

    println(handler.read())
    handler.close()
    println(soloReader.read())
}

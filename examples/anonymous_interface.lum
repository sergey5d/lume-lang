# EXPECT:
# x
# closed
# solo

interface Reader {
    def read() Str
}

interface Closer {
    def close() Unit
}

def main() Unit {
    handler = Reader with Closer {
        def read() Str = "x"
        def close() Unit = println("closed")
    }

    soloReader = Reader {
        def read() Str = "solo"
    }

    println(handler.read())
    handler.close()
    println(soloReader.read())
}

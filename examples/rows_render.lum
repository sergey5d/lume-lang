syntax4(rows [(Int, Int, Str)]) Unit {
    var lastX = 0
    if let Some(first) = rows.get(0) {
        let (_, initialY Int, _) = first
        var lastY = initialY
        for row <- rows {
            let (x, y, char Str) = row
            # just as an example
            xImmutable = x
            for lineStep <- Range(y, lastY) {
                println()
            }
            if lastX < xImmutable {
                for spaceStep <- Range(lastX, xImmutable) {
                    OS.print(" ")
                }
            }
            OS.print(char)
            lastX := x + 1
            lastY := y
        }
        println()
    }
}

main() Unit {
    rows [(Int, Int, Str)] = [
        (0, 0, "1"),
        (0, 1, "2"),
        (0, 2, "3"),
        (1, 1, "4"),
        (1, 2, "5"),
        (2, 1, "6"),
        (2, 2, "7"),
        (3, 2, "8")
    ]
    rows.sort(RowOrdering)

    syntax1(rows)
    syntax2(rows)
    syntax3(rows)
    syntax4(rows)
}

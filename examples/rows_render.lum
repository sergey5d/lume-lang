object RowOrdering with Ordering[(Int, Int, Str)] {

    compare(left (Int, Int, Str), right (Int, Int, Str)) Int {
        let (leftX Int, leftY Int, _) = left
        let (rightX Int, rightY Int, _) = right

        if leftY > rightY {
            return -1
        }
        if leftY < rightY {
            return 1
        }
        if leftX < rightX {
            return -1
        }
        if leftX > rightX {
            return 1
        }
        return 0
    }
}


syntax1(rows [(Int, Int, Str)]) Unit {
    var lastX = 0
    if let Some(firstRow) = rows.get(0) {
        let (_, initialY Int, _) = firstRow
        var lastY = initialY
        for row <- rows {
            let (x Int, y Int, char Str) = row
            for lineStep <- Range(y, lastY) {
                println()
            }
            if lastX < x {
                for spaceStep <- Range(lastX, x) {
                    OS.print(" ")
                }
            }
            OS.print(char)
            lastX := x + 1
            lastY := y
        }
        println()
    }
}


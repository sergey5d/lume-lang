# EXPECT:
# 3
# 2
# 3
# 2

class Counter {
    hidden var value Int = 0

    def next() Int {
        this.value := this.value + 1
        this.value
    }

    def reset() Unit =
        this.value := 0

    def current() Int =
        this.value
}


def twice(value => Int) Int =
    value + value

def inner(value => Int) Int =
    value

def outer(value => Int) Int =
    inner(value) + inner(value)

def cachedOnce(value => Int) Int {
    cached Int = value
    cached + cached
}

def main() Unit {
    counter Counter = Counter()

    println(twice(counter.next()))
    println(counter.current())

    counter.reset()
    println(outer(counter.next()))

    counter.reset()
    println(cachedOnce(counter.next()))
}

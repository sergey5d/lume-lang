# EXPECT:
# 3
# 2
# 3
# 2

class Counter {
    hidden var value Int = 0

    next() Int {
        this.value := this.value + 1
        this.value
    }

    reset() Unit =
        this.value := 0

    current() Int =
        this.value
}


twice(value => Int) Int =
    value + value

inner(value => Int) Int =
    value

outer(value => Int) Int =
    inner(value) + inner(value)

cachedOnce(value => Int) Int {
    cached Int = value
    cached + cached
}

main() Unit {
    counter Counter = Counter()

    println(twice(counter.next()))
    println(counter.current())

    counter.reset()
    println(outer(counter.next()))

    counter.reset()
    println(cachedOnce(counter.next()))
}

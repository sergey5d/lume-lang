# EXPECT:
# tuple 5 hehe
# tuple inferred 6 there
# tuple mixed 8 mixed
# tuple mixed2 9 mixed2
# tuple pair 20 pair
# tuple colon 30 colon
# tuple skip only unused
# tuple skip 14 xxx
# tuple if 1 2
# 0

def main() Int {
    let (a Int, b Str) = (5, "hehe")
    println("tuple", a, b)

    let (inferredTupleLeft, inferredTupleRight) = (6, "there")
    println("tuple inferred", inferredTupleLeft, inferredTupleRight)

    let (mixedTupleLeft Int, mixedTupleRight) = (8, "mixed")
    println("tuple mixed", mixedTupleLeft, mixedTupleRight)

    let (mixedTuple2Left Int, mixedTuple2Right Str) = (9, "mixed2")
    println("tuple mixed2", mixedTuple2Left, mixedTuple2Right)

    let (tuplePairLeft, tuplePairRight) = (20, "pair")
    println("tuple pair", tuplePairLeft, tuplePairRight)

    colonPair (Int, Str) = 30: "colon"
    let (colonPairLeft, colonPairRight) = colonPair
    println("tuple colon", colonPairLeft, colonPairRight)

    let (_, skippedOnlyTupleValue) = (21, "unused")
    println("tuple skip only", skippedOnlyTupleValue)

    let (skippedTupleLeft Int, _, skippedTupleRight Str) = (14, "drop", "xxx")
    println("tuple skip", skippedTupleLeft, skippedTupleRight)

    let (ifTupleLeft Int, ifTupleRight Int) = if true {
        (1, 2)
    } else {
        (3, 4)
    }
    println("tuple if", ifTupleLeft, ifTupleRight)

    0
}

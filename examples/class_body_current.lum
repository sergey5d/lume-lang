# SKIP
#
# Current class-body form with fields, constructors, and methods together.

class Person with Named, Aged {
    firstName Str
    lastName Str
    age Int
    city Str

    private var archived Bool = false
    private var internalScore Int = 0

    new(fullName Str, age Int, city Str) {
        parts = fullName.split(" ")
        this.firstName = parts.at(0) ?? ""
        this.lastName = parts.at(1) ?? ""
        this.age = age
        this.city = city
    }

    new(firstName Str, lastName Str) {
        this.firstName = firstName
        this.lastName = lastName
        this.age = 18
        this.city = "unknown"
    }

    def fullName() Str = this.firstName + " " + this.lastName

    def isAdult() Bool = this.age >= 18

    def moveTo(newCity Str) Unit {
        this.city := newCity
    }

    def celebrateBirthday() Unit {
        this.age += 1
        this.internalScore += 10
    }

    def archive() Unit {
        this.archived := true
    }

    def debugLabel() Str =
        fullName() + "@" + this.city + ":" + this.age + ":" + this.internalScore + ":" + this.archived
}

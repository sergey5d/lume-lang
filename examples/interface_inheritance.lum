# EXPECT:
# hop
# jump 3
# true
# true
# true

interface Hopper {
    fn hop() Str
}

interface Jumper {
    fn jump(steps Int) Str
}

interface Acrobat with Hopper, Jumper {
}

class Rabbit with Acrobat {

    fn hop() Str = "hop"

    fn jump(steps Int) Str = "jump " + steps
}


fn main() Unit {
    rabbit = Rabbit {}
    println(rabbit.hop())
    println(rabbit.jump(3))
    println(rabbit is Acrobat)
    println(rabbit is Hopper)
    println(rabbit is Jumper)
}

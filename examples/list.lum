# EXPECT:
# each 1
# each 2
# each 3
# each 4
# index 1 4
# mapped 2 8
# expanded 1 14
# filtered 3 4
# fold 10
# reduce 10
# exists true
# forAll true
# sorted 4 1
# zip 2 b
# zipIndex 4 3
# get 3
# head 1
# tail 2 4
# remove 2 3
# size 3
# spread 0 4 7 7

single Descending with Ordering[Int] {
}

impl single Descending {
    def compare(left Int, right Int) Int = right - left
}

def main() Unit {
    items = [1, 2, 3]
    items.append(4)

    mapped = items.map(item => item * 2)
    expanded = items.flatMap(item => [item, item + 10])
    filtered = items.filter(item => item > 2)
    total = items.fold(0, (acc, item) => acc + item)
    reduced = items.reduce((left, right) => left + right)
    hasBig = items.exists(item => item > 3)
    allPositive = items.forAll(item => item > 0)

    items.forEach(item => println("each " + item))
    println("index " + items[0] + " " + items[3])

    sorted = [3, 1, 4, 2]
    sorted.sort(Descending)

    zipped = items.zip(["a", "b"])
    indexed = items.zipWithIndex()
    tailItems = items.tail()

    let Some(zippedPair) = zipped.get(1) else return ()
    let Some(indexedPair) = indexed.get(3) else return ()
    let Some(head) = items.head() else return ()
    let Some(removed) = items.remove(1) else return ()

    let (zipValue, zipLabel) = zippedPair
    let (indexedValue, indexedPos) = indexedPair

    println("mapped " + mapped.get(0).getOr(0) + " " + mapped.get(3).getOr(0))
    println("expanded " + expanded.get(0).getOr(0) + " " + expanded.get(7).getOr(0))
    println("filtered " + filtered.get(0).getOr(0) + " " + filtered.get(1).getOr(0))
    println("fold " + total)
    println("reduce " + reduced.getOr(0))
    println("exists " + hasBig)
    println("forAll " + allPositive)
    println("sorted " + sorted.get(0).getOr(0) + " " + sorted.get(3).getOr(0))
    println("zip " + zipValue + " " + zipLabel)
    println("zipIndex " + indexedValue + " " + indexedPos)
    println("get " + items.get(1).getOr(0))
    println("head " + head)
    println("tail " + tailItems.get(0).getOr(0) + " " + tailItems.get(2).getOr(0))
    println("remove " + removed + " " + items.size())
    println("size " + items.size())

    spreaded = [0, ...items, 5, ...[6, 7]]
    println("spread " + spreaded.get(0).getOr(0) + " " + spreaded.get(3).getOr(0) + " " + spreaded.get(6).getOr(0) + " " + spreaded.size())
}

# EXPECT:
# 15
# value=7
# 0

fn id[T](value T) T = value

class Mapper {

    fn map[X](value Int, mapper fn(Int) X) X {
        mapper(value)
    }
}


fn main() Int {
    mapper Mapper = Mapper {}
    println(mapper.map(5, (x Int) => x + 10))
    println(id(mapper.map(7, (x Int) => "value=" + x)))
    0
}

# EXPECT:
# 15
# value=7
# 0

id[T](value T) T = value

class Mapper {
}

impl Mapper {
    map[X](value Int, mapper fn(Int) => X) X {
        mapper(value)
    }
}

main() Int {
    mapper Mapper = Mapper {}
    println(mapper.map(5, (x Int) => x + 10))
    println(id(mapper.map(7, (x Int) => "value=" + x)))
    0
}

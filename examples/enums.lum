# EXPECT:
# reddish: false
# some defined: true
# none: true

# Declared unions may mix alternatives with their own data.
type Color =
    class Black {
        color Str = "xxx"
        temperature Int = 1
    }
    | class Red {
        color Str = "xxx2"
        temperature Int = 2
    }

ext Color {
    def isReddish() Bool = match this {
        case Black { temperature } => temperature % 5 == 0
        case Red { temperature } => temperature % 5 == 0
    }
}

# Naive implementation of option type
type OptionX[T] =
    object NoneX {}
    | class SomeX { value T }

ext OptionX[T] {
    def isDefined() Bool = match this {
        case SomeX(_) => true
        case NoneX => false
    }
}

black = Color.Black()
reddish = black.isReddish()

someInt = OptionX.SomeX(5)
noneInt = OptionX.NoneX

someDefined = someInt.isDefined()

def main() Unit {
    println("reddish:", reddish)
    println("some defined:", someDefined)
    println("none:", noneInt == OptionX.NoneX)
}

# EXPECT:
# Ada Lovelace
# true
# person
# Ada Lovelace@London:19:11:false

# Class body with required `fn` method declarations.
# Storage appears first, followed by constructors and then methods.

interface Named {
    fn fullName() Str
}

interface Aged {
    fn isAdult() Bool
}

private class Person with Named, Aged {
    firstName Str
    lastName Str
    var age Int
    var city Str

    private var archived Bool
    var internalScore Int = 1

    new(firstName Str, lastName Str) {
        this.firstName = firstName
        this.lastName = lastName
        this.age = 18
        this.city = "unknown"
        this.archived = false
    }

    fn kind() Str = "person"

    private fn calc() Int {
        this.firstName.size + this.lastName.size
    }

    fn fullName() Str = this.firstName + " " + this.lastName

    fn isAdult() Bool = this.age >= 18

    fn moveTo(newCity Str) Unit {
        this.city := newCity
    }

    fn celebrateBirthday() Unit {
        this.age += 1
        this.internalScore += 10
    }

    fn archive() Unit {
        this.archived := true
    }

    fn debugLabel() Str =
        fullName() + "@" + this.city + ":" + this.age + ":" + this.internalScore + ":" + this.archived
}


fn makePerson(firstName Str, lastName Str) Person =
    Person(firstName, lastName)

fn main() Unit {
    person Person = makePerson("Ada", "Lovelace")
    println(person.fullName())
    println(person.isAdult())
    println(person.kind())
    person.moveTo("London")
    person.celebrateBirthday()
    println(person.debugLabel())
}

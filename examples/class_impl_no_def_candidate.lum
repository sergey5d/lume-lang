# EXPECT:
# Ada Lovelace
# true
# person
# Ada Lovelace@London:19:11:false

# Candidate class + impl shape where ordinary method definitions omit `def`.
# Constructors use dedicated `new(...)`; method-like declarations are visually
# separated from storage by being inside `impl`.

interface Named {
    fullName() Str
}

interface Aged {
    isAdult() Bool
}

hidden class Person with Named, Aged {
    firstName Str
    lastName Str
    var age Int
    var city Str

    hidden var archived Bool
    var internalScore Int = 1

    kind() Str = "person"
}

impl Person {
    new(firstName Str, lastName Str) {
        this.firstName = firstName
        this.lastName = lastName
        this.age = 18
        this.city = "unknown"
        this.archived = false
    }

    hidden calc() Int {
        this.firstName.size() + this.lastName.size()
    }

    fullName() Str = this.firstName + " " + this.lastName

    isAdult() Bool = this.age >= 18

    moveTo(newCity Str) Unit {
        this.city := newCity
    }

    celebrateBirthday() Unit {
        this.age += 1
        this.internalScore += 10
    }

    archive() Unit {
        this.archived := true
    }

    debugLabel() Str =
        fullName() + "@" + this.city + ":" + this.age + ":" + this.internalScore + ":" + this.archived
}

makePerson(firstName Str, lastName Str) Person =
    Person(firstName, lastName)

main() Unit {
    person Person = makePerson("Ada", "Lovelace")
    println(person.fullName())
    println(person.isAdult())
    println(person.kind())
    person.moveTo("London")
    person.celebrateBirthday()
    println(person.debugLabel())
}

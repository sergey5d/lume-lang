# FAIL_REGEX:
# .*try catch handler cannot contain return, break, continue, or another try; produce the mapped failure value instead.*

def fallback() Result[Str, Str] = Err("fallback")

def main() Result[Int, Str] {
    result Result[Int, Str] = Err("bad")
    value = try result catch err => {
        try fallback()
    }
    Ok(value)
}

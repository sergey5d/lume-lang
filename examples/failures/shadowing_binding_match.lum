# FAIL_REGEX:
# .*binding 'value' shadows a local binding; use a different name.*

type MaybeInt =
    class SomeX { value Int }
    | object NoneX {}

def main() Int {
    value = 3
    maybe = MaybeInt.SomeX(1)
    match maybe {
        case SomeX { value } => value
        case NoneX => value
    }
}

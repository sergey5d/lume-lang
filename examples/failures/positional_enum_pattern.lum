# FAIL_REGEX:
# .*unary pattern 'Values\(\.\.\.\)' requires exactly one extractable field and one pattern; 'Values' has 2 extractable fields and the pattern contains 2.*

enum Pair {
    case Values {
        left Int
        right Int
    }
}

def main() Unit {
    pair Pair = Pair.Values(1, 2)
    match pair {
        case Pair.Values(left, right) => println(left, right)
    }
}

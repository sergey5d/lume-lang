# FAIL_REGEX:
# .*named-value unpacking uses braces; 'Pair\.Values\(\.\.\.\)' is not supported.*

type Pair =
    class Values {
        left Int
        right Int
    }
    | object Empty {}

fn main() Unit {
    pair Pair = Pair.Values(1, 2)
    match pair {
        case Pair.Values(left, right) => println(left, right)
    }
}

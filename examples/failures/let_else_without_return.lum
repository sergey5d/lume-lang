# FAIL_REGEX:
# invalid_let_else_fallback at .*: let else fallback for 'item' has type 'Unit' but expects 'Int'

type MaybeInt =
    object NoneX {}
    | class SomeX { value Int }

def main() Unit {
    value MaybeInt = MaybeInt.NoneX
    let SomeX { value as item } = value else ()
    println(item)
}

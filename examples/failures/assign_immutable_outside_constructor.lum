# FAIL_REGEX:
# assign_immutable at .*: cannot reassign read-only field 'count'

class Counter {
    private count Int

    new(count Int) {
        this.count = count
    }

    fn bump() Int {
        this.count := this.count + 1
        this.count
    }
}


fn main() Int {
    counter Counter = Counter(1)
    counter.bump()
}

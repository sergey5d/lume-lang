# FAIL_REGEX:
# assign_immutable at .*: cannot reassign immutable field 'count'

class Counter {
    hidden count Int
}

impl Counter {
    new(count Int) {
        this.count = count
    }

    bump() Int {
        this.count := this.count + 1
        this.count
    }
}

main() Int {
    counter Counter = Counter(1)
    counter.bump()
}

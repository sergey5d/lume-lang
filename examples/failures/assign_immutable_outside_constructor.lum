# FAIL_REGEX:
# assign_immutable at .*: cannot reassign immutable field 'count'

class Counter {
    hidden count Int

    new(count Int) {
        this.count = count
    }

    def bump() Int {
        this.count := this.count + 1
        this.count
    }
}


def main() Int {
    counter Counter = Counter(1)
    counter.bump()
}

# FAIL_REGEX:
# cannot assign value of type 'Pixel'.*type 'Named'

interface Named {
    label() Str
}

shape PointView with Named {
    x Int
    y Int

    label() Str = this.x + "," + this.y
}


class Pixel {
    x Int
    y Int
}

main() Unit {
    pixel Pixel = Pixel(9, 10)
    named Named = pixel
}

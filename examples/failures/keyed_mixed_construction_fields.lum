# FAIL_REGEX:
# .*cannot mix construction fields and keyed entries in the same brace payload.*

class Box {
    name Str
}

single Box {}

impl single Box {
    keyed(entries [(Str, Int)]) Box {
        Box { name: "boxed" }
    }
}

def main() Unit {
    value = Box {
        name: "Ada"
        ["score"]: 10
    }
}

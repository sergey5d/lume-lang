# FAIL_REGEX:
# cannot assign value of type '.*' to binding 'user' of type 'User'

class User {
    name Str
    age Int
}

shape UserData {
    name Str
    age Int
}

def main() Unit {
    data = UserData {
        name: "Ada"
        age: 42
    }
    explicit = User { ...data }
    user User = data
}

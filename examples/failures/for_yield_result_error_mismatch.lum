# FAIL_REGEX:
# .*for-yield Result generator has failure type 'Int', but the comprehension already uses Result failure type 'Str'.*

main() Unit {
    first Result[Int, Str] = Ok(1)
    second Result[Int, Int] = Ok(2)

    value = for {
        x <- first
        y <- second
    } yield x + y

    println(value)
}

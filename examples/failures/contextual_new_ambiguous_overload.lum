# FAIL_REGEX:
# .*contextual construction matches multiple concrete overload targets.*

class User {
    name Str
}

class Admin {
    name Str
}

class Saver {
    fn save(user User) Unit = ()
    fn save(admin Admin) Unit = ()
}

fn main() Unit {
    saver = Saver()
    saver.save(new { name: "Ada" })
}

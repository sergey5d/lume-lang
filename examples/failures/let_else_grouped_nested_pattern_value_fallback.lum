# FAIL_REGEX:
# invalid_let_else_fallback at .*: nested destructuring requires an exiting let else fallback; value fallbacks are allowed only for flat patterns

class User { name Str }

fn main() {
    candidate User? = None
    other Int? = None
    let {
        number <- other
        Some { value: User { name } } = candidate
    } else { number: 0, name: "Unknown" }
    println(number, name)
}

# FAIL_REGEX:
# .*lifted segment returns 'Result\[Profile, ProfileError\]', but the current chain is 'Result\[User, UserError\]'; 'ProfileError' is not assignable to 'UserError'.*

class UserError {
    message Str
}

class ProfileError {
    message Str
}

class Profile {
    name Str
}

class User {
    profile Profile

    def loadProfile() Result[Profile, ProfileError] = Ok(this.profile)
}

def main() Unit {
    user = User {
        profile: Profile { name: "Ada" }
    }
    resultUser Result[User, UserError] = Ok(user)
    profile Result[Profile, UserError] = resultUser.->loadProfile()
}

# FAIL_REGEX:
# .*for yield clauses only support 'name <- iterable', 'let \(x, y\) <- iterable', 'let \{ \.\.\. \} <- iterable', 'name = expr', and 'let pattern = expr'.*

main() Unit {
    var total = 0

    mapped = for {
        item <- [1, 2]
        total := item
    } yield item

    println(mapped.size())
}

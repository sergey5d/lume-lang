# EXPECT_ERROR:
# .*'referenceId' is available only on class, object, or concrete collection values; 'Named' is not reference-bearing.*

interface Named {
    get name Str
}

class User with Named {
    value Str

    get name Str = this.value
}

fn main() Unit {
    value Named = User("Ada")
    id = value.referenceId
}

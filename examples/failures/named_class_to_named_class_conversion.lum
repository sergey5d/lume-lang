# FAIL_REGEX:
# no_matching_overload at .*: class 'Target' does not have an implicit '()' constructor; use 'Target { ... }' or define 'new'

class Source {
    name Str
    age Int
}

class Target {
    name Str
    age Int
}

def main() Unit {
    source Source = Source(class {
        name = "Ada"
        age = 10
    })
    _ Target = Target(source)
}

# FAIL_REGEX:
# .*unary pattern 'User\(\.\.\.\)' requires exactly one extractable field and one pattern; 'User' has 2 extractable fields and the pattern contains 2.*

class User {
    name Str
    location Str
}

def main() Unit {
    user = User { name: "Ada", location: "London" }
    match user {
        case User(name, location) => println(name, location)
    }
}

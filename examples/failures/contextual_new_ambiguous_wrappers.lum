# FAIL_REGEX:
# .*contextual construction matches multiple concrete overload targets.*

class User {
    name Str
}

class Admin {
    name Str
}

class Saver {
    def save(user User) Unit = ()
    def save(admin Admin) Unit = ()
}

def check(ready Bool) Unit {
    saver = Saver()

    saver.save(if ready {
        new { name: "Ada" }
    } else {
        new { name: "Lin" }
    })

    saver.save({
        new { name: "Grace" }
    })
}

def main() Unit = check(true)

# EXPECT:
# Ada Lovelace
# true
# person
# Ada Lovelace@London:19:11:false

# Class body with required `def` method declarations.
# Storage appears first, followed by constructors and then methods.

interface Named {
    def fullName() Str
}

interface Aged {
    def isAdult() Bool
}

hidden class Person with Named, Aged {
    firstName Str
    lastName Str
    var age Int
    var city Str

    hidden var archived Bool
    var internalScore Int = 1

    new(firstName Str, lastName Str) {
        this.firstName = firstName
        this.lastName = lastName
        this.age = 18
        this.city = "unknown"
        this.archived = false
    }

    def kind() Str = "person"

    hidden def calc() Int {
        this.firstName.size() + this.lastName.size()
    }

    def fullName() Str = this.firstName + " " + this.lastName

    def isAdult() Bool = this.age >= 18

    def moveTo(newCity Str) Unit {
        this.city := newCity
    }

    def celebrateBirthday() Unit {
        this.age += 1
        this.internalScore += 10
    }

    def archive() Unit {
        this.archived := true
    }

    def debugLabel() Str =
        fullName() + "@" + this.city + ":" + this.age + ":" + this.internalScore + ":" + this.archived
}


def makePerson(firstName Str, lastName Str) Person =
    Person(firstName, lastName)

def main() Unit {
    person Person = makePerson("Ada", "Lovelace")
    println(person.fullName())
    println(person.isAdult())
    println(person.kind())
    person.moveTo("London")
    person.celebrateBirthday()
    println(person.debugLabel())
}

# EXPECT:
# zero 10
# bare 11
# paren 12
# pair 13
# typed 14
# typedPair 15
# block 16
# trailing 4
# inlineZero 20
# inlineBare 21
# inlineParen 22
# inlinePair 23
# inlineTyped 24
# inlineTypedPair 25
# inlineMapBare 11
# inlineMapParen 22
# inlineMapTyped 33
# tupleMap 5
# userMap Ada is 37
# tupleMethod 7
# userMethod Bob is 40
# withIndex 3: 15
# combine item: 9
# twoDestructured 10

class LambdaRunner {
}

impl LambdaRunner {
    def zero(f () -> Int) Int = f()

    def one(f (Int) -> Int, value Int) Int = f(value)

    def two(f (Int, Int) -> Int, left Int, right Int) Int = f(left, right)

    def tupleOne(f ((Int, Int)) -> Int, pair (Int, Int)) Int = f(pair)

    def userOne(f (User) -> Str, user User) Str = f(user)

    def withIndex(f ((Int, Int), Int) -> Str, pair (Int, Int), index Int) Str = f(pair, index)

    def combine(f (Str, (Int, Int)) -> Str, name Str, pair (Int, Int)) Str = f(name, pair)

    def twoTuples(f ((Int, Int), (Int, Int)) -> Int, left (Int, Int), right (Int, Int)) Int = f(left, right)
}

class User {
    name Str
    age Int
}

def main() Unit {
    zero = () -> 10
    bare = x -> x + 1
    paren = (x) -> x + 2
    pair = (x, y) -> x + y
    typed = (x Int) -> x + 4
    typedPair = (x Int, y Int) -> x + y + 5
    block = (x Int) -> {
        next = x + 6
        next
    }

    OS.println("zero " + zero())
    OS.println("bare " + bare(10))
    OS.println("paren " + paren(10))
    OS.println("pair " + pair(6, 7))
    OS.println("typed " + typed(10))
    OS.println("typedPair " + typedPair(4, 6))
    OS.println("block " + block(10))

    values = List(1, 2, 3)
    doubled = values.map {
        item -> item * 2
    }
    OS.println("trailing " + doubled.get(1).getOr(0))

    runner = LambdaRunner {}
    OS.println("inlineZero " + runner.zero(() -> 20))
    OS.println("inlineBare " + runner.one(x -> x + 1, 20))
    OS.println("inlineParen " + runner.one((x) -> x + 2, 20))
    OS.println("inlinePair " + runner.two((x, y) -> x + y, 11, 12))
    OS.println("inlineTyped " + runner.one((x Int) -> x + 4, 20))
    OS.println("inlineTypedPair " + runner.two((x Int, y Int) -> x + y, 12, 13))

    inlineMapBare = values.map(x -> x + 10)
    inlineMapParen = values.map((x) -> x + 20)
    inlineMapTyped = values.map((x Int) -> x + 30)
    OS.println("inlineMapBare " + inlineMapBare.get(0).getOr(0))
    OS.println("inlineMapParen " + inlineMapParen.get(1).getOr(0))
    OS.println("inlineMapTyped " + inlineMapTyped.get(2).getOr(0))

    pairs = List((2, 3), (4, 5))
    tupleSums = pairs.map {
        let (x Int, y Int) -> x + y
    }
    OS.println("tupleMap " + tupleSums.get(0).getOr(0))

    users = List(User { name: "Ada", age: 37 })
    userLabels = users.map {
        let { name, age } -> "$name is $age"
    }
    OS.println("userMap " + userLabels.get(0).getOr(""))

    bob User = User { name: "Bob", age: 40 }
    OS.println("tupleMethod " + runner.tupleOne(let (x, y) -> x + y, (3, 4)))
    OS.println("userMethod " + runner.userOne(let { name, age } -> "$name is $age", bob))
    OS.println("withIndex " + runner.withIndex((let (x, y), index) -> "$index: ${x + y}", (7, 8), 3))
    OS.println("combine " + runner.combine((name, let (x, y)) -> "$name: ${x + y}", "item", (4, 5)))
    OS.println("twoDestructured " + runner.twoTuples((let (a, b), let (x, y)) -> a + b + x + y, (1, 2), (3, 4)))
}

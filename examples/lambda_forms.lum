# EXPECT:
# zero 10
# bare 11
# paren 12
# pair 13
# typed 14
# typedPair 15
# block 16
# trailing 4
# inlineZero 20
# trailingZero 26
# inlineBare 21
# inlineParen 22
# inlinePair 23
# inlineTyped 24
# inlineTypedPair 25
# ignoredOne 1
# ignoredBare 1
# ignoredLeft 20
# ignoredRight 4
# ignoredTyped 5
# ignoredBoth 1
# inlineMapBare 11
# inlineMapParen 22
# inlineMapTyped 33
# tupleMap 5
# userMap Ada is 37
# tupleMethod 7
# userMethod Bob is 40
# withIndex 3: 15
# combine item: 9
# twoDestructured 10

class LambdaRunner {

    zero(f fn() => Int) Int = f()

    one(f fn(Int) => Int, value Int) Int = f(value)

    two(f fn(Int, Int) => Int, left Int, right Int) Int = f(left, right)

    tupleOne(f fn((Int, Int)) => Int, pair (Int, Int)) Int = f(pair)

    userOne(f fn(User) => Str, user User) Str = f(user)

    withIndex(f fn((Int, Int), Int) => Str, pair (Int, Int), index Int) Str = f(pair, index)

    combine(f fn(Str, (Int, Int)) => Str, name Str, pair (Int, Int)) Str = f(name, pair)

    twoTuples(f fn((Int, Int), (Int, Int)) => Int, left (Int, Int), right (Int, Int)) Int = f(left, right)
}


class User {
    name Str
    age Int
}

main() Unit {
    zero = () => 10
    bare = x => x + 1
    paren = (x) => x + 2
    pair = (x, y) => x + y
    typed = (x Int) => x + 4
    typedPair = (x Int, y Int) => x + y + 5
    block = (x Int) => {
        next = x + 6
        next
    }

    println("zero " + zero())
    println("bare " + bare(10))
    println("paren " + paren(10))
    println("pair " + pair(6, 7))
    println("typed " + typed(10))
    println("typedPair " + typedPair(4, 6))
    println("block " + block(10))

    values = [1, 2, 3]
    doubled = values.map { item => item * 2 }
    println("trailing " + doubled.get(1).getOr(0))

    runner = LambdaRunner {}
    println("inlineZero " + runner.zero(() => 20))
    println("trailingZero " + runner.zero { () => 26 })
    println("inlineBare " + runner.one(x => x + 1, 20))
    println("inlineParen " + runner.one((x) => x + 2, 20))
    println("inlinePair " + runner.two((x, y) => x + y, 11, 12))
    println("inlineTyped " + runner.one((x Int) => x + 4, 20))
    println("inlineTypedPair " + runner.two((x Int, y Int) => x + y, 12, 13))
    println("ignoredOne " + runner.one((_) => 1, 20))
    println("ignoredBare " + runner.one(_ => 1, 20))
    println("ignoredLeft " + runner.two((x, _) => x, 20, 30))
    println("ignoredRight " + runner.two((_, value) => value + 1, 20, 3))
    println("ignoredTyped " + runner.two((_ Int, value Int) => value + 2, 20, 3))
    println("ignoredBoth " + runner.two((_, _) => 1, 20, 3))

    inlineMapBare = values.map(x => x + 10)
    inlineMapParen = values.map((x) => x + 20)
    inlineMapTyped = values.map((x Int) => x + 30)
    println("inlineMapBare " + inlineMapBare.get(0).getOr(0))
    println("inlineMapParen " + inlineMapParen.get(1).getOr(0))
    println("inlineMapTyped " + inlineMapTyped.get(2).getOr(0))

    pairs = [(2, 3), (4, 5)]
    tupleSums = pairs.map { pairValue =>
        let (x Int, y Int) = pairValue
        x + y
    }
    println("tupleMap " + tupleSums.get(0).getOr(0))

    users = [User { name: "Ada", age: 37 }]
    userLabels = users.map { userValue =>
        let { name, age } = userValue
        "$name is $age"
    }
    println("userMap " + userLabels.get(0).getOr(""))

    bob User = User { name: "Bob", age: 40 }
    println("tupleMethod " + runner.tupleOne(pairValue => {
        let (x, y) = pairValue
        x + y
    }, (3, 4)))
    println("userMethod " + runner.userOne(userValue => {
        let { name, age } = userValue
        "$name is $age"
    }, bob))
    println("withIndex " + runner.withIndex((tupleValue, index) => {
        let (x, y) = tupleValue
        "$index: ${x + y}"
    }, (7, 8), 3))
    println("combine " + runner.combine((name, tupleInput) => {
        let (x, y) = tupleInput
        "$name: ${x + y}"
    }, "item", (4, 5)))
    println("twoDestructured " + runner.twoTuples((left, right) => {
        let (a, b) = left
        let (x, y) = right
        a + b + x + y
    }, (1, 2), (3, 4)))
}

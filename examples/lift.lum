# EXPECT:
# Ada 7
# true
# Ada 7
# missing-name
# Ada 7
# left-name
# Ada 7
# Grace 7

def maybeId() Option[Int] = Some(7)

def maybeName() Option[Str] = Some("Ada")

def missingName() Option[Str] = None

def okId() Result[Int, Str] = Ok(7)

def okName() Result[Str, Str] = Ok("Ada")

def badName() Result[Str, Str] = Err("missing-name")

def rightId() Either[Str, Int] = Right(7)

def rightName() Either[Str, Str] = Right("Ada")

def leftName() Either[Str, Str] = Left("left-name")

def main() Unit {
    optionProfile Option[{ id Int, name Str }] = lift {
        id Int: maybeId()
        name Str: maybeName()
    }
    let Some(profile) = optionProfile else panic("expected lifted option profile")
    println("${profile.name} ${profile.id}")

    missing Option[{ id Int, name Str }] = lift {
        id: maybeId()
        name: missingName()
    }
    println(missing.isEmpty())

    resultPair Result[(Int, Str), Str] = lift (okId(), okName())
    let Ok(pair) = resultPair else panic("expected lifted result pair")
    let (id, name) = pair
    println("${name} ${id}")

    failedResult Result[{ id Int, name Str }, Str] = lift {
        id: okId()
        name: badName()
    }
    let Err(message) = failedResult else panic("expected failed result")
    println(message)

    eitherProfile Either[Str, { id Int, name Str }] = lift {
        id: rightId()
        name: rightName()
    }
    let Right(eitherShape) = eitherProfile else panic("expected lifted either profile")
    println("${eitherShape.name} ${eitherShape.id}")

    failedEither Either[Str, { id Int, name Str }] = lift {
        id: rightId()
        name: leftName()
    }
    let Left(leftMessage) = failedEither else panic("expected failed either")
    println(leftMessage)

    optionParts = {
        id: maybeId()
        name: maybeName()
    }
    spreadProfile Option[{ id Int, name Str }] = lift {
        ...optionParts
    }
    let Some(spreadShape) = spreadProfile else panic("expected spread profile")
    println("${spreadShape.name} ${spreadShape.id}")

    overwrittenParts = optionParts :< {
        name: Some("Grace")
    }
    overwritten Option[{ id Int, name Str }] = lift {
        ...overwrittenParts
    }
    let Some(overwrittenShape) = overwritten else panic("expected overwritten profile")
    println("${overwrittenShape.name} ${overwrittenShape.id}")
}

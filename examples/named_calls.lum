# EXPECT:
# plain function regular-7
# mixed function named-9
# regular method method-11
# mixed method method-13
# named function named-15
# named method method-17
# 0

class Formatter {

	format(prefix Str, value Int) Str {
		return prefix + value
	}
}


format(prefix Str, value Int) Str {
	return prefix + value
}

main() Int {
	formatter = Formatter {}

	println("plain function", format("regular-", 7))
	println("mixed function", format("named-", value = 9))
	println("regular method", formatter.format("method-", 11))
	println("mixed method", formatter.format("method-", value = 13))
	println("named function", format(value = 15, prefix = "named-"))
	println("named method", formatter.format(value = 17, prefix = "method-"))

	0
}

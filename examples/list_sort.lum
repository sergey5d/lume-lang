# EXPECT:
# asc 1 2 3 4
# desc 4 3 2 1
# 0

single Ascending with Ordering[Int] {
}

impl single Ascending {
    def compare(left Int, right Int) Int = left - right
}

single Descending with Ordering[Int] {
}

impl single Descending {
    def compare(left Int, right Int) Int = right - left
}

def main() Int {
    asc List[Int] = List(3, 1, 4, 2)
    asc.sort(Ascending)
    println("asc " + asc.get(0).getOr(0) + " " + asc.get(1).getOr(0) + " " + asc.get(2).getOr(0) + " " + asc.get(3).getOr(0))

    desc List[Int] = List(3, 1, 4, 2)
    desc.sort(Descending)
    println("desc " + desc.get(0).getOr(0) + " " + desc.get(1).getOr(0) + " " + desc.get(2).getOr(0) + " " + desc.get(3).getOr(0))

    0
}

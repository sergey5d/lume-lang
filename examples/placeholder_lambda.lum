# EXPECT:
# 2
# 3
# 4
# 4
# 4
# 2
# 4
# 5
# 4
# 10

applyTwice(f fn(Int) => Int, value Int) Int = f(f(value))

main() Unit {
    inc fn(Int) => Int = value => value + 1
    items = [1, 2, 3]
    mapped = items.map(item => item + 1)
    str Str = "haha"
    words = [str]
    sizes = words.map(word => word.size())
    pairs = [("a", 1), ("bb", 2)]
    pairMapped = pairs.map(pair => {
        let (key, value) = pair
        key.size() + value
    })
    pairIgnored = pairs.map(pair => {
        let (_, value) = pair
        value * 2
    })
    entries = ["a": 1, "bbb": 2]
    mapMapped = entries.map((key, value) => key.size() + value)
    tuple4s = [(1, 2, 3, 4), (4, 5, 6, 7)]
    tuple4Mapped = tuple4s.map(tuple => {
        let (first, _, third, _) = tuple
        first + third
    })

    println(mapped.at(0).getOr(0))
    println(mapped.at(1).getOr(0))
    println(mapped.at(2).getOr(0))
    println(applyTwice(inc, 2))
    println(sizes.at(0).getOr(0))
    println(pairMapped.at(0).getOr(0))
    println(pairMapped.at(1).getOr(0))
    println(mapMapped.at(1).getOr(0))
    println(pairIgnored.at(1).getOr(0))
    println(tuple4Mapped.at(1).getOr(0))
}

# EXPECT:
# rejected 1

module or_pattern_guard_evaluated_once

class Guard {
    var calls Int = 0

    def allowed() Bool {
        this.calls += 1
        false
    }
}

def main() Unit {
    tracker = Guard {}
    result = match (0, 0) {
        case (0, _) | (_, 0) if tracker.allowed() => "accepted"
        case _ => "rejected"
    }

    println(result, tracker.calls)
}

# EXPECT:
# generic constructor callbacks ok

module examples/issues/generic_constructor_callbacks

class Box[T] {
    callback fn(T) T

    new(callback fn(T) T) {
        this.callback = callback
    }
}

class CallbackField[T] {
    callback fn(T) T
}

class Transform[A, B] {
    callback fn(A) B

    new(handler fn(A) B) {
        this.callback = handler
    }
}

fn wrap[T](initial T) Box[T] = Box[T](v => initial)

fn main() {
    positional Box[Int] = Box[Int](v => v + 1)
    inferred = Box[Int](v => v + 2)
    braces Box[Int] = { callback: v => v + 3 }
    contextual Box[Int] = new(v => v + 4)
    implicit CallbackField[Int] = CallbackField[Int](v => v + 5)
    implicitBraces CallbackField[Int] = { callback: v => v + 6 }
    namedBraces = Box[Int] { callback: v => v + 7 }
    inferredType = Box((v Int) => v + 8)
    nested = CallbackField[[Int]](v => v)
    transform Transform[Int, Str] = { handler: v => "value:" + v.toStr() }

    assert(positional.callback(4) == 5)
    assert(inferred.callback(4) == 6)
    assert(braces.callback(4) == 7)
    assert(contextual.callback(4) == 8)
    assert(implicit.callback(4) == 9)
    assert(implicitBraces.callback(4) == 10)
    assert(namedBraces.callback(4) == 11)
    assert(inferredType.callback(4) == 12)
    assert(nested.callback([4]).size == 1)
    assert(transform.callback(4) == "value:4")
    assert(wrap("kept").callback("ignored") == "kept")
    println("generic constructor callbacks ok")
}

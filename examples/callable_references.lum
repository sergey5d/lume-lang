# EXPECT:
# top-level Ada
# instance Grace
# this Ada
# object Grace
# assigned Katherine
# assigned instance Alan
# indexed 26
# 0

class UserEntity {
    id Int
    name Str
}

class UserDto {
    id Int
    name Str
}

mapUser(user UserEntity) UserDto =
    UserDto { id: user.id, name: user.name }

class UserMapper {
}

impl UserMapper {
    mapUser(user UserEntity) UserDto =
        UserDto { id: user.id, name: user.name }
}

object User {
    toDto(user UserEntity) UserDto =
        UserDto { id: user.id, name: user.name }
}

class UserService {
}

impl UserService {
    toDto(user UserEntity) UserDto =
        UserDto { id: user.id, name: user.name }

    fromThis(users [UserEntity]) [UserDto] =
        users.map(this.toDto)
}

printAt(label Str, dtos [UserDto], index Int) Unit {
    let dto <- dtos.get(index) else panic("expected dto")
    println(label, dto.name)
}

main() Int {
    users = [
        UserEntity { id: 1, name: "Ada" },
        UserEntity { id: 2, name: "Grace" }
    ]
    mapper UserMapper = UserMapper {}
    service UserService = UserService {}

    printAt("top-level", users.map(mapUser), 0)
    printAt("instance", users.map(mapper.mapUser), 1)
    printAt("this", service.fromThis(users), 0)
    printAt("object", users.map(User.toDto), 1)

    topLevelFn fn(UserEntity) => UserDto = mapUser
    instanceFn fn(UserEntity) => UserDto = mapper.mapUser
    handlers [fn() => Int] = [() => 26]

    println("assigned", topLevelFn(UserEntity { id: 3, name: "Katherine" }).name)
    println("assigned instance", instanceFn(UserEntity { id: 4, name: "Alan" }).name)
    println("indexed", (handlers[0])())
    0
}

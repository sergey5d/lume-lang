# EXPECT:
# top-level Ada
# instance Grace
# this Ada
# object Grace
# assigned Katherine
# assigned instance Alan
# overloaded text text
# overloaded number 42
# indexed 26
# 0

class UserEntity {
    id Int
    name Str
}

class UserDto {
    id Int
    name Str
}

def mapUser(user UserEntity) UserDto =
    UserDto { id: user.id, name: user.name }

class UserMapper {

    def mapUser(user UserEntity) UserDto =
        UserDto { id: user.id, name: user.name }
}

class Formatter {
    def render(value Int) Str = value.toStr()
    def render(value Str) Str = value
}


object User {
    def toDto(user UserEntity) UserDto =
        UserDto { id: user.id, name: user.name }
}

class UserService {

    def toDto(user UserEntity) UserDto =
        UserDto { id: user.id, name: user.name }

    def fromThis(users [UserEntity]) [UserDto] =
        users.map(this.toDto)
}


def printAt(label Str, dtos [UserDto], index Int) Unit {
    let dto <- dtos.at(index) else panic("expected dto")
    println(label, dto.name)
}

def main() Int {
    users = [
        UserEntity { id: 1, name: "Ada" },
        UserEntity { id: 2, name: "Grace" }
    ]
    mapper UserMapper = UserMapper {}
    service UserService = UserService {}
    formatter Formatter = Formatter {}

    printAt("top-level", users.map(mapUser), 0)
    printAt("instance", users.map(mapper.mapUser), 1)
    printAt("this", service.fromThis(users), 0)
    printAt("object", users.map(User.toDto), 1)

    topLevelFn fn(UserEntity) UserDto = mapUser
    instanceFn fn(UserEntity) UserDto = mapper.mapUser
    renderText fn(Str) Str = formatter.render
    renderNumber fn(Int) Str = formatter.render
    handlers [fn() Int] = [() => 26]

    println("assigned", topLevelFn(UserEntity { id: 3, name: "Katherine" }).name)
    println("assigned instance", instanceFn(UserEntity { id: 4, name: "Alan" }).name)
    println("overloaded text", renderText("text"))
    println("overloaded number", renderNumber(42))
    println("indexed", handlers[0]())
    0
}

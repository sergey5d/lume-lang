# EXPECT:
# Ada
# Ada
# Ada
# Ada
# Ada
# Ada
# Ada
# 1
# Ada
# Ada
# Ada
# Ada
# Ada

class UserBox {
    userValue User

    user() User = this.userValue
}

class User {
    profileValue Profile

    profile() Profile = this.profileValue

    profileOpt() Option[Profile] = Some(this.profileValue)

    profileResult() Result[Profile, Int] = Ok(this.profileValue)

    profileEither() Either[Str, Profile] = Right(this.profileValue)

    name() Name = this.profileValue.primaryName()
}

class Profile {
    nameValue Name
    users [User] = []

    primaryName() Name = this.nameValue

    name() Name = this.nameValue

    nameOpt() Option[Name] = Some(this.nameValue)

    nameResult() Result[Name, Int] = Ok(this.nameValue)

    nameEither() Either[Str, Name] = Right(this.nameValue)
}

class Name {
    first Str

    display() Str = this.first

    parseFirstResult() Result[Int, ParseError] = Ok(1)
}

class ParseError {
    message Str
}

main() Unit {
    friendProfile = Profile {
        nameValue: Name { first: "Ada" }
    }
    friend = User { profileValue: friendProfile }
    user = User {
        profileValue: Profile {
            nameValue: Name { first: "Ada" }
            users: [friend]
        }
    }

    optionSource Option[User] = Some(user)
    optionName Option[Str] = optionSource
        .->profileOpt()
        .->nameOpt()
        .->first
    println(optionName !!)

    resultSource Result[User, Int] = Ok(user)
    resultName Result[Str, Int] = resultSource
        .->profileResult()
        .->nameResult()
        .->first
    println(resultName !!)

    eitherSource Either[Str, User] = Right(user)
    eitherName Either[Str, Str] = eitherSource
        .->profileEither()
        .->nameEither()
        .->first
    println(eitherName.expectRight())

    # Each .-> hop crosses exactly one lifted boundary.
    displayName Option[Str] = optionSource.->profile().->primaryName().->display()
    println(displayName !!)

    containerGetOr Str = optionSource.->profile().->primaryName().->display().getOr("unknown")
    println(containerGetOr)

    mixedFirstName Option[Str] = optionSource
        .->profileOpt()
        .->users
        .->head()
        .->name()
        .->first
    println(mixedFirstName !!)

    parenthesizedContainerMethod Str = ((optionSource.->profile().->primaryName()) !!).first
    println(parenthesizedContainerMethod)

    differentFamilyMaps Option[Result[Int, ParseError]] = optionSource
        .->profile()
        .->primaryName()
        .->parseFirstResult()
    println((differentFamilyMaps !!) !!)

    lineLeadingDisplayName Option[Str] = optionSource
        .->profile()
        .->primaryName()
        .->display()
    println(lineLeadingDisplayName !!)

    lineLeadingFirstName Option[Str] = optionSource
        .->profileOpt()
        .->name()
        .->first
    println(lineLeadingFirstName !!)

    # This crosses each plain or lifted member one hop at a time.
    userBoxOpt Option[UserBox] = Some(UserBox { userValue: user })
    firstName Option[Str] = userBoxOpt.->user().->profile().->nameOpt().->first
    println(firstName !!)

    profileSource Option[Profile] = Some(user.profile())
    let Some(boundName) = profileSource.->nameOpt().->first else return ()
    println(boundName)

    let extractedName Str <- profileSource.->nameOpt().->first else return ()
    println(extractedName)
}

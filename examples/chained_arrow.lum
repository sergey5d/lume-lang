# EXPECT:
# Ada
# Ada
# Ada
# Ada
# Ada
# Ada
# Ada
# 1
# Ada
# Ada
# Ada
# Ada
# Ada

class UserBox {
    userValue User

    def user() User = this.userValue
}

class User {
    profileValue Profile

    def profile() Profile = this.profileValue

    def profileOpt() Option[Profile] = Some(this.profileValue)

    def profileResult() Result[Profile, Int] = Ok(this.profileValue)

    def profileEither() Either[Str, Profile] = Right(this.profileValue)

    def name() Name = this.profileValue.primaryName()
}

class Profile {
    nameValue Name
    users [User] = []

    def primaryName() Name = this.nameValue

    def name() Name = this.nameValue

    def nameOpt() Option[Name] = Some(this.nameValue)

    def nameResult() Result[Name, Int] = Ok(this.nameValue)

    def nameEither() Either[Str, Name] = Right(this.nameValue)
}

class Name {
    first Str

    def display() Str = this.first

    def parseFirstResult() Result[Int, ParseError] = Ok(1)
}

class ParseError {
    message Str
}

def main() Unit {
    friendProfile = Profile {
        nameValue: Name { first: "Ada" }
    }
    friend = User { profileValue: friendProfile }
    user = User {
        profileValue: Profile {
            nameValue: Name { first: "Ada" }
            users: [friend]
        }
    }

    optionSource Option[User] = Some(user)
    optionName Option[Str] = optionSource
        .->profileOpt()
        .->nameOpt()
        .->first
    println(optionName.orPanic())

    resultSource Result[User, Int] = Ok(user)
    resultName Result[Str, Int] = resultSource
        .->profileResult()
        .->nameResult()
        .->first
    println(resultName.orPanic())

    eitherSource Either[Str, User] = Right(user)
    eitherName Either[Str, Str] = eitherSource
        .->profileEither()
        .->nameEither()
        .->first
    println(eitherName.expectRight())

    # Each .-> hop crosses exactly one lifted boundary.
    displayName Option[Str] = optionSource.->profile().->primaryName().->display()
    println(displayName.orPanic())

    containerGetOr Str = optionSource.->profile().->primaryName().->display().getOr("unknown")
    println(containerGetOr)

    mixedFirstName Option[Str] = optionSource
        .->profileOpt()
        .->users
        .->head()
        .->name()
        .->first
    println(mixedFirstName.orPanic())

    parenthesizedContainerMethod Str = (optionSource.->profile().->primaryName()).orPanic().first
    println(parenthesizedContainerMethod)

    differentFamilyMaps Option[Result[Int, ParseError]] = optionSource
        .->profile()
        .->primaryName()
        .->parseFirstResult()
    println(differentFamilyMaps.orPanic().orPanic())

    lineLeadingDisplayName Option[Str] = optionSource
        .->profile()
        .->primaryName()
        .->display()
    println(lineLeadingDisplayName.orPanic())

    lineLeadingFirstName Option[Str] = optionSource
        .->profileOpt()
        .->name()
        .->first
    println(lineLeadingFirstName.orPanic())

    # This crosses each plain or lifted member one hop at a time.
    userBoxOpt Option[UserBox] = Some(UserBox { userValue: user })
    firstName Option[Str] = userBoxOpt.->user().->profile().->nameOpt().->first
    println(firstName.orPanic())

    profileSource Option[Profile] = Some(user.profile())
    guard Some(boundName) = profileSource.->nameOpt().->first else return ()
    println(boundName)

    guard extractedName Str <- profileSource.->nameOpt().->first else return ()
    println(extractedName)
}

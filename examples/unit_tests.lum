# TEST_EXPECT:
# PrimitiveSpec
# AnotherSpec

use spec/*

class PrimitiveSpec with Spec {}

impl PrimitiveSpec {
    it() Unit {
        5.shouldBe(5)
        true.shouldBe(true)
        "lume".shouldBe("lume")
        1.5.shouldBe(1.5)

        first Rune = "rune".expectRuneAt(0)
        first.shouldBe(first)
    }
}

class AnotherSpec with Spec {}

impl AnotherSpec {
    it() Unit {
        (2 + 3).shouldBe(5)
    }
}

# EXPECT:
# User
# User
# true

module qualified_types

use model/models

fn display(user models.User) Str = user.label()

fn displayAlias(user models.ModelUser) Str = user.label()

fn first(users Vector[models.User]) models.User = users[0]

fn main() Unit {
    user models.User = models.User {}
    users Vector[models.User] = [user]
    choice models.User | models.Guest = first(users)

    println(display(first(users)))
    println(displayAlias(user))
    println(choice is models.User)
}

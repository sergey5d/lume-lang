interface Hopper {
    hop() Str = "hop"
}

interface Jumper {
    jump(steps Int) Str
}

class Rabbit with Hopper, Jumper {

    jump(steps Int) Str = "jump " + steps
}


main() Int {
    rabbit Hopper = Rabbit {}
    jumper Jumper = Rabbit {}
    println(rabbit.hop())
    println(jumper.jump(2))

# EXPECT:
# hop
# jump 2
# 0

interface Hopper {
    fn hop() Str
}

mixin Hopping with Hopper {
    fn hop() Str = "hop"
}

interface Jumper {
    fn jump(steps Int) Str
}

class Rabbit with Hopper, Jumper {
    use Hopping

    fn jump(steps Int) Str = "jump " + steps
}


fn main() Int {
    rabbit Hopper = Rabbit {}
    jumper Jumper = Rabbit {}
    println(rabbit.hop())
    println(jumper.jump(2))
    0
}

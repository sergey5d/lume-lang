# EXPECT:
# 10
# description
# 5
# 100 description description
# 0
# 101 description description updated
# 0
# 102 description description updated
# 7
# Hop-hop
# Jump 3 steps

# plain data classes still work well with field-wise updates and destructuring

interface Hopper {
    hop() Str
}

interface Jumper {
    jump(steps Int) Str
}

class Amount with Hopper, Jumper {
    amount Int
    description Str
    count Int
}

impl Amount {
    multiple(other Amount) Amount = Amount {
        amount: this.amount * other.amount
        description: this.description + " " + other.description
        count: 0
    }

    reportAmount() {
        println("amount:", this.amount)
    }

    hop() Str = "Hop-hop"

    jump(steps Int) Str = "Jump " + steps + " steps"
}

a1 = Amount(10, "description", 5)

a2 = a1.multiple(a1)

amountAmount = a1.amount
amountDescr = a1.description

a3 = a2 :< { amount: 101, description: a2.description + " updated" }

a4 = a3 :< { amount: 102 } :< { count: 7 }

main() Unit {
    println(amountAmount)
    println(amountDescr)
    println(a1.count)
    println(a2.amount, a2.description)
    println(a2.count)
    println(a3.amount, a3.description)
    println(a3.count)
    println(a4.amount, a4.description)
    println(a4.count)
    println(a1.hop())
    println(a1.jump(3))
}

# EXPECT:
# value is Counter? true
# counter is CounterPrecursor? true
# string is Str? true
# value is Str? false
# counter is Breaker? false
# 0

interface CounterPrecursor {
}

class Counter with CounterPrecursor {
}

interface Breaker {
}

main() Int {
	counter = Counter {}
	println("value is Counter? " + (counter is Counter))
	println("counter is CounterPrecursor? " + (counter is CounterPrecursor))
	println("string is Str? " + ("hello" is Str))
	println("value is Str? " + (counter is Str))
	println("counter is Breaker? " + (counter is Breaker))
	0
}

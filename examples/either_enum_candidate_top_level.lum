# Candidate union-based Either design with behavior defined in an extension.

type Either[L, R] =
    class Left { value L }
    | class Right { value R }

ext Either[L, R] {
    def isLeft() Bool = match this {
        case Left { value: _ } => true
        case Right { value: _ } => false
    }

    def map[T](f fn(R) T) Either[L, T] = match this {
        case Left { value } => Left(value)
        case Right { value } => Right(f(value))
    }
}

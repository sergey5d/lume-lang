module examples/java_gradle_rest

use lume/http/javalin/{HttpServer, Controller, Get, Post}

@Controller { path: "/api" }
class GreetingController {
    @Get { path: "/health" }
    health() Str = "ok"

    @Get { path: "/hello" }
    hello() Str = "{ \"message\": \"hello from Lume via Gradle\" }"

    @Post { path: "/echo" }
    echo(body Str) Str = """{ "echo": "$body" }"""
}

main() Unit {
    server HttpServer = HttpServer(7070).virtualThreads()
    server.addController(GreetingController())
    server.run()
}

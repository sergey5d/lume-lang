module examples/java_gradle_rest

use lume/core/http/{HttpServer, Controller, GET, POST}

@Controller { path: "/api" }
class GreetingController {
    @GET { path: "/health" }
    def health() Str = "ok"

    @GET { path: "/hello" }
    def hello() Str = "{ \"message\": \"hello from Lume via Gradle\" }"

    @POST { path: "/echo" }
    def echo(body Str) Str = """{ "echo": "$body" }"""
}

def main() Unit {
    server HttpServer = HttpServer(7070)
    server.addController(GreetingController())
    server.run()
}

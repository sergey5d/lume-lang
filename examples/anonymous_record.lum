# EXPECT:
# Ana is 10
# Ben is 12
# 1
# 20
# Ada-10
# Cara is 14
# 11
# Ben 12
# Cara 14
# Ana 10
# 6
# typed Ada 42

def describe(user { name Str, age Int }) Str =
    user.name + " is " + user.age

def makeCounter(base Int) { count Int, next Int } {
    return shape(base, base + 1)
}

def main() Unit {
    full = {
        name: "Ana"
        age: 10
        city: "NYC"
    }
    smaller = {
        name: "Ben"
        age: 12
    }
    a = 1
    inferred = {
        count: a
    }
    mixed = { a: 5, c: 7,
        b: 8
    }
    mixedShape = { name: "Ada",
        age: 10
    }
    narrow { name Str, age Int } = full
    positional { name Str, age Int } = shape("Ben", 12)
    name = "Cara"
    age = 14
    contextual { name Str, age Int } = shape(name, age)

    println(describe(full))
    println(describe(smaller))
    println(inferred.count)
    println(mixed.a + mixed.b + mixed.c)
    println(mixedShape.name + "-" + mixedShape.age)
    println(describe(shape("Cara", 14)))
    counter = makeCounter(5)
    println(counter.count + counter.next)
    println(positional.name + " " + positional.age)
    println(contextual.name + " " + contextual.age)
    println(narrow.name + " " + narrow.age)
    typedCounter { count Int, next Int } = makeCounter(5)
    println(typedCounter.next)
    typedAnon = {
        name Str: "Ada"
        age Int: 42
    }
    println("typed", typedAnon.name, typedAnon.age)
}

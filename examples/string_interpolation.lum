# EXPECT:
# regular:
# hello world
# next 3
# money $5
# mix world-4
# multiline:
# hello world
# count 3
#
# escaped
#
# raw-single:$name\n
# raw-multi:
# hello $name
# \nraw
# done

def main() Unit {
    name Str = "world"
    count Int = 2

    println("regular:")
    println("hello $name")
    println("next ${count + 1}")
    println("money \$${count + 3}")
    println("mix $name-${count + 2}")

    text Str = """hello $name
count ${count + 1}
\nescaped
"""
    rawSingle Str = raw"$name\n"
    rawMulti Str = raw"""hello $name
\nraw"""

    println("multiline:")
    println(text)
    println("raw-single:" + rawSingle)
    println("raw-multi:")
    println(rawMulti)
    println("done")
}

# SKIP
#
# Generic class construction is not supported at call sites yet.
#
# Intended future example for a generic list-backed list once calls like
# ArrayList[Int](5) and ArrayListIterator[T] { ... } are supported.

class ArrayListIterator[T] with Iterator[T] {
    hidden var items [T]
    hidden var limit Int
    hidden var index Int = 0

    new(items [T], limit Int) {
        this.items = items
        this.limit = limit
    }

    hasNext() Bool = this.index < this.limit

    next() T {
        value T = this.items[this.index]
        this.index := this.index + 1
        value
    }
}


class ArrayList[T] with Iterable[T] {
    hidden var items [T]
    hidden var count Int = 0

    new(capacity Int) {
        this.items = []
    }

    append(value T) Unit {
        this.items.add(value)
        this.count := this.count + 1
    }

    get(index Int) Option[T] =
        if index < 0 || index >= this.count {
            None
        } else {
            Some(this.items[index])
        }

    size() Int = this.count

    iterator() Iterator[T] = ArrayListIterator[T] { items: this.items, limit: this.count }
}


main() Int {
    values ArrayList[Int] = ArrayList[Int](5)
    values.append(10)
    values.append(20)
    values.append(30)

    var sum = 0
    for item <- values {
        sum := sum + item
    }

    println("size " + values.size())
    println("sum " + sum)
    0
}

module lume/json

use lume/json/ { JsonRuntime }

public annotation JsonName {
    value Str
}

public annotation JsonIgnore {}

public shape JsonField {
    name Str
    value JsonValue
}

public type JsonValue =
    object JsonNull {}
    | class JsonBool { value Bool }
    | class JsonNumber { value Str }
    | class JsonString { value Str }
    | class JsonArray { values [JsonValue] }
    | class JsonObject { fields [JsonField] }

ext JsonValue {
    fn stringify() Str = JsonRuntime.stringify(this)

    # Extracts provider-style rich text from strings, nested arrays, and
    # objects containing value, text, or content fields.
    fn textContent() Str = JsonRuntime.textContent(this)
}

public object Json {

    fn str(value Str) JsonValue = JsonRuntime.str(value)

    fn int(value Int) JsonValue = JsonRuntime.int(value)

    fn float(value Float) JsonValue = JsonRuntime.float(value)

    fn bool(value Bool) JsonValue = JsonRuntime.bool(value)

    fn nil() JsonValue = JsonRuntime.nil()

    fn field(name Str, value JsonValue) JsonField = JsonRuntime.field(name, value)

    fn array(values [JsonValue] vararg) JsonValue = JsonRuntime.array(values)

    fn obj(fields [JsonField] vararg) JsonValue = JsonRuntime.obj(fields)

    fn obj(value Any) JsonValue = JsonRuntime.encode(value)

    fn encode(value Any) JsonValue = JsonRuntime.encode(value)

    fn stringify(value Any) Str = JsonRuntime.stringify(value)

    fn decode[reified T](text Str) Result[T, Str] = JsonRuntime.decode(text, typeOf[T])
}

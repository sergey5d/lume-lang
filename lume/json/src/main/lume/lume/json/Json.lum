module lume/json

use lume/json/{JsonRuntime}

annotation JsonName {
    value Str
}

annotation JsonIgnore {}

shape JsonField {
    name Str
    value JsonValue
}

enum JsonValue {
    case JsonNull

    case JsonBool {
        value Bool
    }

    case JsonNumber {
        value Str
    }

    case JsonString {
        value Str
    }

    case JsonArray {
        values [JsonValue]
    }

    case JsonObject {
        fields [JsonField]
    }
}

single Json {}

impl JsonValue {
    def stringify() Str = JsonRuntime.stringify(this)
}

impl single Json {
    def str(value Str) JsonValue = JsonRuntime.str(value)

    def int(value Int) JsonValue = JsonRuntime.int(value)

    def float(value Float) JsonValue = JsonRuntime.float(value)

    def bool(value Bool) JsonValue = JsonRuntime.bool(value)

    def nil() JsonValue = JsonRuntime.nil()

    def field(name Str, value JsonValue) JsonField = JsonRuntime.field(name, value)

    def array(vararg values [JsonValue]) JsonValue = JsonRuntime.array(values)

    def obj(vararg fields [JsonField]) JsonValue = JsonRuntime.obj(fields)

    def obj(value Any) JsonValue = JsonRuntime.encode(value)

    def encode(value Any) JsonValue = JsonRuntime.encode(value)

    def stringify(value Any) Str = JsonRuntime.stringify(value)
}

module lume/db

use lume/db/{DbError, JdbcDatabase, JdbcRow, JdbcRunner, JdbcTransaction}

class Row {
    hidden backend JdbcRow
}

impl Row {
    new {
        backend JdbcRow
    } {
        this.backend = backend
    }

    def columns() [Str] = this.backend.columns()

    def has(column Str) Bool = this.backend.has(column)

    def value(column Str) Result[Any, DbError] = this.backend.value(column)

    def nullableValue(column Str) Result[Option[Any], DbError] = this.backend.nullableValue(column)

    def str(column Str) Result[Str, DbError] = this.backend.str(column)

    def strOpt(column Str) Result[Option[Str], DbError] = this.backend.strOpt(column)

    def int(column Str) Result[Int, DbError] = this.backend.intValue(column)

    def int64(column Str) Result[Int, DbError] = this.backend.int64(column)

    def int32(column Str) Result[Int32, DbError] = this.backend.int32(column)

    def intOpt(column Str) Result[Option[Int], DbError] = this.backend.intOpt(column)

    def float(column Str) Result[Float, DbError] = this.backend.floatValue(column)

    def float64(column Str) Result[Float, DbError] = this.backend.float64(column)

    def float32(column Str) Result[Float32, DbError] = this.backend.float32(column)

    def floatOpt(column Str) Result[Option[Float], DbError] = this.backend.floatOpt(column)

    def bool(column Str) Result[Bool, DbError] = this.backend.bool(column)

    def boolOpt(column Str) Result[Option[Bool], DbError] = this.backend.boolOpt(column)
}

class Query {
    hidden runner JdbcRunner
    hidden sql Str
    hidden values [Any]
}

impl Query {
    new {
        runner JdbcRunner
        sql Str
        values [Any] = []
    } {
        this.runner = runner
        this.sql = sql
        this.values = values
    }

    def bind(values [Any] vararg) Query = Query(this.runner, this.sql, values)

    def rows() Result[[Row], DbError] {
        jdbcRows [JdbcRow] = try this.runner.query(this.sql, this.values)
        var out [Row] = []

        for jdbcRow <- jdbcRows {
            out := out.add(Row(jdbcRow))
        }

        Ok(out)
    }

    def all() Result[[Row], DbError] = this.rows()

    def map[T](mapper (Row) -> Result[T, DbError]) Result[[T], DbError] {
        rows [Row] = try this.rows()
        var out [T] = []

        for row <- rows {
            mapped Result[T, DbError] = mapper(row)
            match mapped {
                case Ok(value) => {
                    out := out.add(value)
                }
                case Err(error) => {
                    return Err(error)
                }
            }
        }

        Ok(out)
    }

    def mapValue[T](mapper (Row) -> T) Result[[T], DbError] {
        rows [Row] = try this.rows()
        var out [T] = []

        for row <- rows {
            out := out.add(mapper(row))
        }

        Ok(out)
    }
}

class RowQuery {
    hidden query Query
}

impl RowQuery {
    new {
        query Query
    } {
        this.query = query
    }

    def bind(values [Any] vararg) RowQuery = RowQuery(this.query.bind(values))

    def row() Result[Option[Row], DbError] {
        rows [Row] = try this.query.rows()
        count Int = rows.size()

        if count == 0 {
            Ok(None)
        } else if count > 1 {
            Err(DbError("queryRow expected at most one row, got " + count))
        } else {
            Ok(rows.get(0))
        }
    }

    def map[T](mapper (Row) -> Result[T, DbError]) Result[Option[T], DbError] {
        maybeRow Option[Row] = try this.row()

        match maybeRow {
            case Some(row) => {
                mapped Result[T, DbError] = mapper(row)
                match mapped {
                    case Ok(value) => Ok(Some(value))
                    case Err(error) => Err(error)
                }
            }
            case None => Ok(None)
        }
    }

    def mapValue[T](mapper (Row) -> T) Result[Option[T], DbError] {
        maybeRow Option[Row] = try this.row()

        match maybeRow {
            case Some(row) => Ok(Some(mapper(row)))
            case None => Ok(None)
        }
    }
}

class Exec {
    hidden runner JdbcRunner
    hidden sql Str
}

impl Exec {
    new {
        runner JdbcRunner
        sql Str
    } {
        this.runner = runner
        this.sql = sql
    }

    def bind(values [Any] vararg) BoundExec = BoundExec(this.runner, this.sql, values)

    def run() Result[Int, DbError] = this.runner.exec(this.sql)
}

class BoundExec {
    hidden runner JdbcRunner
    hidden sql Str
    hidden values [Any]
}

impl BoundExec {
    new {
        runner JdbcRunner
        sql Str
        values [Any] = []
    } {
        this.runner = runner
        this.sql = sql
        this.values = values
    }

    def run() Result[Int, DbError] = this.runner.exec(this.sql, this.values)
}

class Transaction {
    hidden backend JdbcTransaction
}

impl Transaction {
    new {
        backend JdbcTransaction
    } {
        this.backend = backend
    }

    def query(sql Str, values [Any] vararg) Query = Query(this.backend, sql, values)

    def queryRow(sql Str, values [Any] vararg) RowQuery = RowQuery(this.query(sql, values))

    def exec(sql Str) Exec = Exec(this.backend, sql)

    def exec(sql Str, values [Any] vararg) Result[Int, DbError] = this.backend.exec(sql, values)

    def commit() Result[Unit, DbError] = this.backend.commit()

    def rollback() Result[Unit, DbError] = this.backend.rollback()

    def close() Result[Unit, DbError] = this.backend.close()
}

class Database {
    hidden backend JdbcDatabase
}

impl Database {
    new {
        backend JdbcDatabase
    } {
        this.backend = backend
    }

    def query(sql Str, values [Any] vararg) Query = Query(this.backend, sql, values)

    def queryRow(sql Str, values [Any] vararg) RowQuery = RowQuery(this.query(sql, values))

    def exec(sql Str) Exec = Exec(this.backend, sql)

    def exec(sql Str, values [Any] vararg) Result[Int, DbError] = this.backend.exec(sql, values)

    def beginTransaction() Result[Transaction, DbError] {
        backendTx JdbcTransaction = try this.backend.beginTransaction()
        Ok(Transaction(backendTx))
    }

    def begin() Result[Transaction, DbError] = this.beginTransaction()

    def transactionally(work (Transaction) -> Result[Unit, DbError]) Result[Unit, DbError] {
        tx Transaction = try this.beginTransaction()

        worked Result[Unit, DbError] = work(tx)
        match worked {
            case Ok(value) => {
                committed Result[Unit, DbError] = tx.commit()
                match committed {
                    case Ok(_) => Ok(value)
                    case Err(error) => {
                        try tx.rollback()
                        Err(error)
                    }
                }
            }
            case Err(error) => {
                try tx.rollback()
                Err(error)
            }
        }
    }

    def close() Result[Unit, DbError] = this.backend.close()
}

module lume/http

use io/javalin/Javalin
use io/javalin/http/{Context, Handler}
use io/javalin/router/JavalinDefaultRoutingApi

annotation Controller {
    path Str = ""
}

annotation GET {
    path Str
}

annotation POST {
    path Str
}

hidden class JavalinBackend {
    app Javalin
    port Int32
}

impl JavalinBackend {
    new {
        port Int32
    } {
        this.app = Javalin.create()
        this.port = port
    }

    def get(path Str, controller Any, method Method) JavalinBackend {
        this.app.get(path, Handler {
            def handle(ctx Context) Unit {
                ctx.result(method.invoke(controller).toStr())
            }
        })

        this
    }

    def post(path Str, controller Any, method Method) JavalinBackend {
        this.app.post(path, Handler {
            def handle(ctx Context) Unit {
                ctx.result(method.invoke(controller, ctx.body()).toStr())
            }
        })

        this
    }

    def run() JavalinBackend {
        this.app.start(this.port)
        this
    }
}

class HttpServer {
    backend JavalinBackend
}

impl HttpServer {
    new {
        port Int32
    } {
        this.backend = JavalinBackend(port)
    }

    def addController(controller Any) HttpServer {
        controllerType Type = controller.runtimeType
        classType ClassType = controllerType.asClass().orPanic()
        var prefix Str = ""

        if controllerType.hasAnnotation("Controller") {
            controllerAnnotation AnnotationValue = controllerType.annotation("Controller").orPanic()
            prefix := controllerAnnotation.str("path").orPanic()
        }

        methods [Method] = classType.methods()
        for methodValue <- methods {
            method Method = methodValue

            if method.hasAnnotation("GET") {
                route AnnotationValue = method.annotation("GET").orPanic()
                path Str = prefix + route.str("path").orPanic()
                this.backend.get(path, controller, method)
            }

            if method.hasAnnotation("POST") {
                route AnnotationValue = method.annotation("POST").orPanic()
                path Str = prefix + route.str("path").orPanic()
                this.backend.post(path, controller, method)
            }
        }

        this
    }

    def run() HttpServer {
        this.backend.run()
        this
    }
}

module lume/http/javalin

use io/javalin/Javalin
use io/javalin/http/{Context as JavalinRawContext, Handler}
use lume/http/{Context as HttpContext}
use lume/http/javalin/runtime/HttpResponder
use lume/http/javalin/runtime/{JavalinContext as JavalinRuntimeContext}
use lume/http/javalin/runtime/JavalinRuntime

annotation Controller {
    path Str = ""
}

annotation Get {
    path Str
    contentType Str = "text/plain"
}

annotation Post {
    path Str
    contentType Str = "text/plain"
}

annotation Put {
    path Str
    contentType Str = "text/plain"
}

annotation Patch {
    path Str
    contentType Str = "text/plain"
}

annotation Delete {
    path Str
    contentType Str = "text/plain"
}

shape HttpResponse {
    status Int = 200
    body Str
    contentType Str = "application/json"
}

shape HttpError {
    status Int
    body Str
    contentType Str = "application/json"
}

hidden class JavalinBackend {
    app Javalin
    port Int

    new(port Int) {
        this.app = Javalin.create()
        this.port = port
    }

    def virtualThreads() JavalinBackend {
        JavalinRuntime.enableVirtualThreads(this.app)
        this
    }

    def get(path Str, contentType Str, controller Any, method Method) JavalinBackend {
        this.app.get(path, object with Handler {
            def handle(ctx JavalinRawContext) Unit {
                if method.params().size() == 0 {
                    HttpResponder.render(ctx, method.invoke(controller), contentType)
                } else {
                    HttpResponder.render(ctx, method.invoke(controller, JavalinHttpContext(ctx)), contentType)
                }
            }
        })

        this
    }

    def post(path Str, contentType Str, controller Any, method Method) JavalinBackend {
        this.app.post(path, object with Handler {
            def handle(ctx JavalinRawContext) Unit {
                params [Param] = method.params()
                if params.size() == 0 {
                    HttpResponder.render(ctx, method.invoke(controller), contentType)
                } else {
                    if let Some { value as firstValue } = params.at(0) {
                        first Param = firstValue
                        paramType Type[_] = first.paramType()
                        if paramType.name().getOr("") == "Context" {
                            HttpResponder.render(ctx, method.invoke(controller, JavalinHttpContext(ctx)), contentType)
                        } else {
                            HttpResponder.render(ctx, method.invoke(controller, ctx.body()), contentType)
                        }
                    } else {
                        HttpResponder.render(ctx, method.invoke(controller), contentType)
                    }
                }
            }
        })

        this
    }

    def put(path Str, contentType Str, controller Any, method Method) JavalinBackend {
        this.app.put(path, object with Handler {
            def handle(ctx JavalinRawContext) Unit {
                params [Param] = method.params()
                if params.size() == 0 {
                    HttpResponder.render(ctx, method.invoke(controller), contentType)
                } else {
                    if let Some { value as firstValue } = params.at(0) {
                        first Param = firstValue
                        paramType Type[_] = first.paramType()
                        if paramType.name().getOr("") == "Context" {
                            HttpResponder.render(ctx, method.invoke(controller, JavalinHttpContext(ctx)), contentType)
                        } else {
                            HttpResponder.render(ctx, method.invoke(controller, ctx.body()), contentType)
                        }
                    } else {
                        HttpResponder.render(ctx, method.invoke(controller), contentType)
                    }
                }
            }
        })

        this
    }

    def patch(path Str, contentType Str, controller Any, method Method) JavalinBackend {
        this.app.patch(path, object with Handler {
            def handle(ctx JavalinRawContext) Unit {
                params [Param] = method.params()
                if params.size() == 0 {
                    HttpResponder.render(ctx, method.invoke(controller), contentType)
                } else {
                    if let Some { value as firstValue } = params.at(0) {
                        first Param = firstValue
                        paramType Type[_] = first.paramType()
                        if paramType.name().getOr("") == "Context" {
                            HttpResponder.render(ctx, method.invoke(controller, JavalinHttpContext(ctx)), contentType)
                        } else {
                            HttpResponder.render(ctx, method.invoke(controller, ctx.body()), contentType)
                        }
                    } else {
                        HttpResponder.render(ctx, method.invoke(controller), contentType)
                    }
                }
            }
        })

        this
    }

    def delete(path Str, contentType Str, controller Any, method Method) JavalinBackend {
        this.app.delete(path, object with Handler {
            def handle(ctx JavalinRawContext) Unit {
                params [Param] = method.params()
                if params.size() == 0 {
                    HttpResponder.render(ctx, method.invoke(controller), contentType)
                } else {
                    if let Some { value as firstValue } = params.at(0) {
                        first Param = firstValue
                        paramType Type[_] = first.paramType()
                        if paramType.name().getOr("") == "Context" {
                            HttpResponder.render(ctx, method.invoke(controller, JavalinHttpContext(ctx)), contentType)
                        } else {
                            HttpResponder.render(ctx, method.invoke(controller, ctx.body()), contentType)
                        }
                    } else {
                        HttpResponder.render(ctx, method.invoke(controller), contentType)
                    }
                }
            }
        })

        this
    }

    def run() JavalinBackend {
        this.app.start(this.port)
        this
    }
}

hidden class JavalinHttpContext with HttpContext {
    hidden raw JavalinRawContext

    new(raw JavalinRawContext) {
        this.raw = raw
    }

    def queryParam(name Str) Option[Str] =
        JavalinRuntimeContext.queryParam(this.raw, name)

    def pathParam(name Str) Option[Str] =
        JavalinRuntimeContext.pathParam(this.raw, name)

    def header(name Str) Option[Str] =
        JavalinRuntimeContext.header(this.raw, name)

    def body() Str =
        this.raw.body()
}



class HttpServer {
    backend JavalinBackend

    new(port Int) {
        this.backend = JavalinBackend(port)
    }

    def virtualThreads() HttpServer {
        this.backend.virtualThreads()
        this
    }

    def addController(controller Any) HttpServer {
        controllerType Type[_] = controller.runtimeType
        let Some { value as classType } = controllerType.asClass() else return this
        var prefix Str = ""

        if let Some { value as controllerAnnotationValue } = controllerType.annotation[Controller]() {
            controllerAnnotation AnnotationValue = controllerAnnotationValue
            prefix := controllerAnnotation.str("path").getOr("")
        }

        methods [Method] = classType.methods()
        for methodValue <- methods {
            method Method = methodValue

            if method.hasAnnotation[Get]() {
                if let Some { value as routeValue } = method.annotation[Get]() {
                    route AnnotationValue = routeValue
                    path Str = prefix + route.str("path").getOr("")
                    contentType Str = route.str("contentType").getOr("text/plain")
                    this.backend.get(path, contentType, controller, method)
                }
            }

            if method.hasAnnotation[Post]() {
                if let Some { value as routeValue } = method.annotation[Post]() {
                    route AnnotationValue = routeValue
                    path Str = prefix + route.str("path").getOr("")
                    contentType Str = route.str("contentType").getOr("text/plain")
                    this.backend.post(path, contentType, controller, method)
                }
            }

            if method.hasAnnotation[Put]() {
                if let Some { value as routeValue } = method.annotation[Put]() {
                    route AnnotationValue = routeValue
                    path Str = prefix + route.str("path").getOr("")
                    contentType Str = route.str("contentType").getOr("text/plain")
                    this.backend.put(path, contentType, controller, method)
                }
            }

            if method.hasAnnotation[Patch]() {
                if let Some { value as routeValue } = method.annotation[Patch]() {
                    route AnnotationValue = routeValue
                    path Str = prefix + route.str("path").getOr("")
                    contentType Str = route.str("contentType").getOr("text/plain")
                    this.backend.patch(path, contentType, controller, method)
                }
            }

            if method.hasAnnotation[Delete]() {
                if let Some { value as routeValue } = method.annotation[Delete]() {
                    route AnnotationValue = routeValue
                    path Str = prefix + route.str("path").getOr("")
                    contentType Str = route.str("contentType").getOr("text/plain")
                    this.backend.delete(path, contentType, controller, method)
                }
            }
        }

        this
    }

    def run() HttpServer {
        this.backend.run()
        this
    }
}

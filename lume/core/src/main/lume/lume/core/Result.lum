module lume/core

enum Result[T, E] {
    case Ok {
        value T
    }

    case Err {
        error E
    }
}

impl Result[T, E] {
    def isOk() Bool = match this {
        case Ok(_) => true
        case Err(_) => false
    }

    def isSuccess() Bool = match this {
        case Ok(_) => true
        case Err(_) => false
    }

    def isErr() Bool = match this {
        case Ok(_) => false
        case Err(_) => true
    }

    def map[X](f (T) => X) Result[X, E] = match this {
        case Ok(value) => Ok(f(value))
        case Err(error) => Err(error)
    }

    def mapError[X](f (E) => X) Result[T, X] = match this {
        case Ok(value) => Ok(value)
        case Err(error) => Err(f(error))
    }

    def flatMap[X](f (T) => Result[X, E]) Result[X, E] = match this {
        case Ok(value) => f(value)
        case Err(error) => Err(error)
    }

    def getOr(lazy fallback T) T = match this {
        case Ok(value) => value
        case Err(_) => fallback
    }

    def orElse(lazy fallback Result[T, E]) Result[T, E] = match this {
        case Ok(value) => Ok(value)
        case Err(_) => fallback
    }

    def toOption() Option[T] = match this {
        case Ok(value) => Some(value)
        case Err(_) => None
    }

    def toEither() Either[E, T] = match this {
        case Ok(value) => Right(value)
        case Err(error) => Left(error)
    }

    def getError() E = match this {
        case Ok(_) => panic("Result has no error value")
        case Err(error) => error
    }

    def orPanic() T = match this {
        case Ok(value) => value
        case Err(_) => panic("expected Result.Ok")
    }
}

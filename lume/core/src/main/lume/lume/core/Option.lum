module lume/core

enum Option[T] {
    case Some {
        value T
    }

    case None
}

impl Option[T] {
    def isSet() Bool = match this {
        case Some(_) => true
        case None => false
    }

    def isDefined() Bool = match this {
        case Some(_) => true
        case None => false
    }

    def isSuccess() Bool = match this {
        case Some(_) => true
        case None => false
    }

    def isEmpty() Bool = match this {
        case Some(_) => false
        case None => true
    }

    def map[X](f (T) -> X) Option[X] = match this {
        case Some(value) => Some(f(value))
        case None => None
    }

    def flatMap[X](f (T) -> Option[X]) Option[X] = match this {
        case Some(value) => f(value)
        case None => None
    }

    def getOr(fallback T) T = match this {
        case Some(value) => value
        case None => fallback
    }

    def getOrElse(fallback T) T = match this {
        case Some(value) => value
        case None => fallback
    }

    def toResult[E](error () -> E) Result[T, E] = match this {
        case Some(value) => Ok(value)
        case None => Err(error())
    }

    def toResult[E](error E) Result[T, E] = match this {
        case Some(value) => Ok(value)
        case None => Err(error)
    }

    def toEither[L](left () -> L) Either[L, T] = match this {
        case Some(value) => Right(value)
        case None => Left(left())
    }

    def toEither[L](left L) Either[L, T] = match this {
        case Some(value) => Right(value)
        case None => Left(left)
    }

    def iterator() Iterator[T] = match this {
        case Some(value) => [value].iterator()
        case None => [].iterator()
    }

    def orPanic() T = match this {
        case Some(value) => value
        case None => panic("expected Option.Some")
    }
}

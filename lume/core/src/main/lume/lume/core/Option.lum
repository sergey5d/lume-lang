module lume/core

enum Option[T] {
    case Some {
        value T
    }

    case None
}

impl Option[T] {
    def isDefined() Bool = match this {
        case Some(_) => true
        case None => false
    }

    def orPanic() T = match this {
        case Some(value) => value
        case None => panic("expected Option.Some")
    }
}

module lume/core

public type Option[T] with Iterable[T] =
    class Some { value T }
    | object None {}

ext Option[T] {
    get isSet Bool = match this {
        case Some { value: _ } => true
        case None => false
    }

    get isDefined Bool = match this {
        case Some { value: _ } => true
        case None => false
    }

    get isSuccess Bool = match this {
        case Some { value: _ } => true
        case None => false
    }

    get isEmpty Bool = match this {
        case Some { value: _ } => false
        case None => true
    }

    fn map[X](f fn(T) X) Option[X] = match this {
        case Some { value } => Some(f(value))
        case None => None
    }

    fn flatMap[X](f fn(T) Option[X]) Option[X] = match this {
        case Some { value } => f(value)
        case None => None
    }

    fn orElse(fallback fn() Option[T]) Option[T] = match this {
        case Some { value } => Some(value)
        case None => fallback()
    }

    fn toResult[E](error fn() E) Result[T, E] = match this {
        case Some { value } => Ok(value)
        case None => Err(error())
    }

    fn toEither[L](left fn() L) Either[L, T] = match this {
        case Some { value } => Right(value)
        case None => Left(left())
    }

    fn iterator() Iterator[T] = match this {
        case Some { value } => [value].iterator()
        case None => Vector[T]().iterator()
    }
}

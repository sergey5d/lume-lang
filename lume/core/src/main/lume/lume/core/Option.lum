module lume/core

enum Option[T] {
    case Some {
        value T
    }

    case None

    def isSet() Bool = match this {
        case Some(_) => true
        case None => false
    }

    def isDefined() Bool = match this {
        case Some(_) => true
        case None => false
    }

    def isSuccess() Bool = match this {
        case Some(_) => true
        case None => false
    }

    def isEmpty() Bool = match this {
        case Some(_) => false
        case None => true
    }

    def map[X](f fn(T) => X) Option[X] = match this {
        case Some(value) => Some(f(value))
        case None => None
    }

    def flatMap[X](f fn(T) => Option[X]) Option[X] = match this {
        case Some(value) => f(value)
        case None => None
    }

    def getOr(fallback => T) T = match this {
        case Some(value) => value
        case None => fallback
    }

    def orElse(fallback => Option[T]) Option[T] = match this {
        case Some(value) => Some(value)
        case None => fallback
    }

    def toResult[E](error => E) Result[T, E] = match this {
        case Some(value) => Ok(value)
        case None => Err(error)
    }

    def toEither[L](left => L) Either[L, T] = match this {
        case Some(value) => Right(value)
        case None => Left(left)
    }

    def iterator() Iterator[T] = match this {
        case Some(value) => [value].iterator()
        case None => Vector().iterator()
    }
}

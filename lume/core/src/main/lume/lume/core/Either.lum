module lume/core

enum Either[L, R] {
    case Left {
        value L
    }

    case Right {
        value R
    }

    def isLeft() Bool = match this {
        case Left { value: _ } => true
        case Right { value: _ } => false
    }

    def isRight() Bool = match this {
        case Left { value: _ } => false
        case Right { value: _ } => true
    }

    def isSuccess() Bool = match this {
        case Left { value: _ } => false
        case Right { value: _ } => true
    }

    def map[X](f fn(R) X) Either[L, X] = match this {
        case Left { value } => Left(value)
        case Right { value } => Right(f(value))
    }

    def mapLeft[X](f fn(L) X) Either[X, R] = match this {
        case Left { value } => Left(f(value))
        case Right { value } => Right(value)
    }

    def flatMap[X](f fn(R) Either[L, X]) Either[L, X] = match this {
        case Left { value } => Left(value)
        case Right { value } => f(value)
    }

    def merge[when L = R]() L = match this {
        case Left { value } => value
        case Right { value } => value
    }

    def getOr(fallback => R) R = match this {
        case Left { value: _ } => fallback
        case Right { value } => value
    }

    def orElse(fallback => Either[L, R]) Either[L, R] = match this {
        case Left { value: _ } => fallback
        case Right { value } => Right(value)
    }

    def toOption() Option[R] = match this {
        case Left { value: _ } => None
        case Right { value } => Some(value)
    }

    def toResult() Result[R, L] = match this {
        case Left { value } => Err(value)
        case Right { value } => Ok(value)
    }

    def expectLeft() L = match this {
        case Left { value } => value
        case Right { value: _ } => panic("expected Either.Left")
    }

    def expectRight() R = match this {
        case Left { value: _ } => panic("expected Either.Right")
        case Right { value } => value
    }
}

{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(?:(?:hidden\\s+)?(?:def|new|annotation|class|shape|enum|interface|single)|impl|if|for|while|defer|(?:partial\\s+)?match)\\b.*\\{\\s*$",
      "end": "^\\s*}\\s*(else\\b.*)?$"
    }
  }
}

{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(?:(?:(?:public|private|internal)\\s+)?(?:fn|get|new|type|annotation|class|shape|interface|object)|ext|if|for|while|defer|match)\\b.*\\{\\s*$",
      "end": "^\\s*}\\s*(else\\b.*)?$"
    }
  }
}

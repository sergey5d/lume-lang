{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "lume",
  "scopeName": "source.lume",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#enumCases"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#constructors"
    },
    {
      "include": "#types"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.lume",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.raw.multiline.lume",
          "begin": "\\b(raw)(\"\"\")",
          "beginCaptures": {
            "1": {
              "name": "storage.type.string.raw.lume"
            },
            "2": {
              "name": "punctuation.definition.string.begin.lume"
            }
          },
          "end": "\"\"\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.lume"
            }
          }
        },
        {
          "name": "string.quoted.double.raw.lume",
          "begin": "\\b(raw)(\")",
          "beginCaptures": {
            "1": {
              "name": "storage.type.string.raw.lume"
            },
            "2": {
              "name": "punctuation.definition.string.begin.lume"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.lume"
            }
          }
        },
        {
          "name": "string.quoted.double.multiline.lume",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.lume",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.lume",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            },
            {
              "name": "meta.interpolation.simple.lume",
              "match": "\\$([A-Za-z_][A-Za-z0-9_]*)",
              "captures": {
                "1": {
                  "name": "variable.other.interpolation.lume"
                }
              }
            }
          ]
        },
        {
          "name": "string.quoted.double.lume",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.lume",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.lume",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            },
            {
              "name": "meta.interpolation.simple.lume",
              "match": "\\$([A-Za-z_][A-Za-z0-9_]*)",
              "captures": {
                "1": {
                  "name": "variable.other.interpolation.lume"
                }
              }
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.lume",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "meta.match.partial.lume",
          "match": "\\b(partial)(\\s+)(match)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.lume"
            },
            "3": {
              "name": "keyword.control.lume"
            }
          }
        },
        {
          "name": "keyword.control.lume",
          "match": "\\b(?:if|else|for|while|yield|match|return|break|continue|is|try|defer)\\b"
        },
        {
          "name": "keyword.declaration.lume",
          "match": "\\b(?:def|new|annotation|class|shape|enum|interface|single|impl|ext|use|module|with|as|hidden|case|var|vararg|let)\\b"
        },
        {
          "name": "storage.modifier.generic.reified.lume",
          "match": "\\b(?:reified)\\b"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.lume",
          "match": "(@)\\s*([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.annotation.lume"
            },
            "2": {
              "name": "entity.name.type.annotation.lume"
            }
          }
        }
      ]
    },
    "enumCases": {
      "patterns": [
        {
          "name": "meta.enum.case.lume",
          "match": "\\b(case)\\b\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.lume"
            },
            "2": {
              "name": "entity.name.type.variant.lume"
            }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.lume",
          "match": "\\b(?:true|false|this)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.lume",
          "match": "\\b(?:Any|Int|Bool|Rune|Float|Str|Unit|Never|Array|List|Set|Map|Option|Result|Either|Iterator|Iterable|Range|Ordering|Eq|OS|Type|TypeKind|ClassType|ShapeType|EnumType|InterfaceType|SingleType|AnnotationType|Field|Method|Param|EnumCase|AnnotationValue|ReflectionError|Tuple2|Tuple3|Tuple4|Tuple5|Tuple6|Tuple7|Tuple8)\\b"
        },
        {
          "name": "entity.name.type.lume",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "constructors": {
      "patterns": [
        {
          "name": "support.function.constructor.lume",
          "match": "\\b(?:Some|None|Ok|Err|Left|Right)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.lume",
          "match": "\\b(?:print|println|printf|panic|assert)\\s*(?=\\()"
        },
        {
          "name": "support.function.builtin.typeof.lume",
          "match": "\\b(typeOf)\\s*(?=\\[)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.lume",
          "match": "\\b[a-zA-Z_][A-Za-z0-9_]*\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.lume",
          "match": "<-|:=|\\+=|-=|\\*=|/=|%=|="
        },
        {
          "name": "keyword.operator.shape.lume",
          "match": ":<"
        },
        {
          "name": "keyword.operator.lifted-access.lume",
          "match": "\\.->"
        },
        {
          "name": "keyword.operator.extract-or.lume",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.spread.lume",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.comparison.lume",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.lume",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.arrow.lume",
          "match": "=>"
        },
        {
          "name": "punctuation.separator.colon.lume",
          "match": ":"
        },
        {
          "name": "keyword.operator.symbolic.lume",
          "match": "(?<!\\+)\\+(?!\\+)|(?<!-)\\-(?!-)|[*/%!]"
        },
        {
          "name": "punctuation.separator.arguments.lume",
          "match": ","
        },
        {
          "name": "punctuation.accessor.dot.lume",
          "match": "\\."
        }
      ]
    }
  }
}

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "lume",
  "scopeName": "source.lume",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#controlShorthand"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#enumCases"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constructors"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.lume",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.multiline.lume",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.lume",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.lume",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.lume",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.lume",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.lume",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lume",
          "match": "\\b(?:if|then|else|for|while|yield|partial|match|unwrap|return|break|is)\\b"
        },
        {
          "name": "keyword.declaration.lume",
          "match": "\\b(?:def|class|record|enum|interface|object|impl|import|package|with|hidden|public|case|var)\\b"
        }
      ]
    },
    "enumCases": {
      "patterns": [
        {
          "name": "meta.enum.case.lume",
          "match": "\\b(case)\\b\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.lume"
            },
            "2": {
              "name": "entity.name.type.variant.lume"
            }
          }
        }
      ]
    },
    "controlShorthand": {
      "patterns": [
        {
          "name": "meta.control.shorthand.lume",
          "begin": "\\b(if|then|else|for|yield|match|partial|unwrap)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.lume"
            }
          },
          "end": ":",
          "endCaptures": {
            "0": {
              "name": "keyword.operator.lume"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.lume",
          "match": "\\b(?:true|false|this)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.lume",
          "match": "\\b(?:Int|Str|Bool|Float|Unit|Array|List|Set|Map|Option|Result|Either|Iterator|Printer|OS)\\b"
        },
        {
          "name": "entity.name.type.lume",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "constructors": {
      "patterns": [
        {
          "name": "support.function.constructor.lume",
          "match": "\\b(?:Some|None|Ok|Err|Left|Right)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.lume",
          "match": "\\b[a-zA-Z_][A-Za-z0-9_]*\\s*(?=\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.lume",
          "match": "<-|:=|="
        },
        {
          "name": "keyword.operator.comparison.lume",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.lume",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.arrow.lume",
          "match": "=>|->"
        },
        {
          "name": "keyword.operator.symbolic.lume",
          "match": "::|:\\+|\\+\\+|:-|--|<<|>>|[+\\-*/%&|]"
        },
        {
          "name": "punctuation.separator.arguments.lume",
          "match": ","
        },
        {
          "name": "punctuation.accessor.dot.lume",
          "match": "\\."
        }
      ]
    }
  }
}
